@model TestingDemo.Services.DashboardSnapshot
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var peso = CultureInfo.GetCultureInfo("en-PH");
    string Money(decimal value) => value.ToString("C", peso);
    var chartPayload = JsonSerializer.Serialize(new
    {
        days = Model.Last7Days.Select(d => new { d.Label, d.Revenue, d.Arrivals, d.OccupiedRooms }),
        status = Model.StatusMix.Select(s => new { s.Label, s.Count }),
        stayMix = Model.StayMix.Select(s => new { s.Label, s.Count })
    });
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@11.3.0/dist/gridstack.min.css" />
}

<section class="admin-flush-page admin-dash-page admin-dash-page--neumo">
    <section class="admin-flush-hero" aria-labelledby="dashTitle">
        <div class="admin-flush-hero-copy">
            <p class="admin-flush-eyebrow">@Model.RoleName operations</p>
            <h1 id="dashTitle">Business dashboard</h1>
            <p class="admin-flush-lede">
                Occupancy, cash, stay mix, offers, and front-desk load for Mori International Hotel.
                Drag a report frame by its header, or resize from the corner. Your layout is saved to your staff account.
            </p>
        </div>
        <ul class="admin-flush-kpis" aria-label="Snapshot" data-dash-hero-kpis>
            <li>
                <span>Occupancy</span>
                <strong data-dash-field="occupancyPercent">@Model.OccupancyPercent.ToString("0.#")%</strong>
                <em data-dash-field="occupancyRooms">@Model.RoomsOccupied of @Model.RoomsTotal rooms</em>
            </li>
            <li>
                <span>Taken in today</span>
                <strong data-dash-field="revenueToday">@Money(Model.RevenueToday)</strong>
                <em>posted payments</em>
            </li>
            <li>
                <span>As of</span>
                <strong>PH</strong>
                <em data-dash-field="asOfPh">@Model.AsOfPh</em>
            </li>
        </ul>
    </section>

    <div class="admin-dash-toolbar">
        <p>Rearrange frames for the decision you need first. Your layout follows you after sign-out. Reception and admin share the same house numbers; refunds stay on the money frame for managers.</p>
        <div class="admin-dash-toolbar-actions">
            <button type="button" class="btn btn-primary" data-dash-report>Generate report</button>
            <button type="button" class="btn btn-outline-secondary" data-dash-reset>Reset layout</button>
        </div>
    </div>

    <div class="grid-stack" id="dashGrid"
         data-dash-user="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"
         data-dash-role="@Model.RoleName"
         data-layout-url="@Url.Action("SaveLayout")"
         data-dash-snapshot-url="@Url.Content("~/api/admin/dashboard/snapshot")">
        <div class="grid-stack-item" gs-id="occupancy" gs-x="0" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Occupancy</h2>
                    <a href="/Rooms">Rooms</a>
                </header>
                <p class="dash-widget-stat" data-dash-widget="occupancy-stat">@Model.OccupancyPercent.ToString("0.#")%</p>
                <p class="dash-widget-meta" data-dash-widget="occupancy-meta">@Model.RoomsOccupied occupied · @Model.RoomsAvailable open</p>
                <p class="dash-widget-note" data-dash-widget="occupancy-note">@Model.RoomsCleaning maintaining · @Model.RoomsUnavailable unavailable</p>
                <p class="dash-widget-note" data-dash-widget="occupancy-rates">ADR @Money(Model.Adr) · RevPAR @Money(Model.RevPar)</p>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="arrivals" gs-x="3" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Today’s board</h2>
                    <a href="/AdminBookings">Bookings</a>
                </header>
                <dl class="dash-widget-dl" data-dash-widget="arrivals">
                    <div><dt>Arrivals</dt><dd data-dash-arrivals>@Model.ArrivalsToday</dd></div>
                    <div><dt>Departures</dt><dd data-dash-departures>@Model.DeparturesToday</dd></div>
                    <div><dt>In house</dt><dd data-dash-inhouse>@Model.InHouseStays</dd></div>
                    <div><dt>Pending</dt><dd data-dash-pending>@Model.PendingStays</dd></div>
                </dl>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="money" gs-x="6" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Money</h2>
                    <a href="/AdminPayments">Payments</a>
                </header>
                <p class="dash-widget-stat" data-dash-widget="money-stat">@Money(Model.RevenueMonth)</p>
                <p class="dash-widget-meta" data-dash-widget="money-meta">This month posted · today <span data-dash-revenue-today>@Money(Model.RevenueToday)</span></p>
                @if (Model.IsAdminManager)
                {
                    <p class="dash-widget-note" data-dash-widget="money-refunds">Refunded this month @Money(Model.RefundsMonth)</p>
                }
                <p class="dash-widget-note" data-dash-widget="money-pipeline">Open stay value @Money(Model.PipelineValue) · avg @Money(Model.AverageStayValue)</p>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="offers" gs-x="9" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Offers &amp; books</h2>
                    <a href="/AdminSpecialOffers">Offers</a>
                </header>
                <p class="dash-widget-stat" data-dash-widget="offers-stat">@Model.ActiveOffers</p>
                <p class="dash-widget-meta">Active promotions now</p>
                <p class="dash-widget-note" data-dash-widget="offers-note">@Model.ConfirmedStays confirmed · @Model.BookedSharePercent.ToString("0.#")% of open stays confirmed</p>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="revenue-chart" gs-x="0" gs-y="4" gs-w="8" gs-h="4" gs-min-w="4" gs-min-h="3">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2 data-dash-pay-heading>Posted revenue &amp; arrivals · 7 days</h2>
                    <button type="button" class="dash-pay-toggle" data-dash-pay-toggle aria-pressed="false" aria-label="Show recent payments table" title="Recent payments">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M8.5 6h12M8.5 12h12M8.5 18h12"/><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01" stroke-linecap="round" stroke-width="2.8"/></svg>
                    </button>
                </header>
                <div class="dash-flip" data-dash-flip>
                    <div class="dash-flip-inner">
                        <div class="dash-flip-face">
                            <div class="dash-chart-wrap">
                                <canvas id="dashRevenueChart" aria-label="Seven day posted revenue and arrivals"></canvas>
                            </div>
                        </div>
                        <div class="dash-flip-face dash-flip-back" inert>
                            <div class="dash-pay-panel">
                                <label class="dash-pay-search">
                                    <span class="visually-hidden">Search payments</span>
                                    <input type="search" placeholder="Search receipt, booking, guest…" data-dash-pay-search autocomplete="off" />
                                </label>
                                <div class="dash-pay-table-wrap">
                                    <table class="dash-pay-table">
                                        <thead>
                                            <tr>
                                                <th>When (PH)</th>
                                                <th>Receipt</th>
                                                <th>Guest</th>
                                                <th>Event</th>
                                                <th>Method</th>
                                                <th class="num">Amount</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody data-dash-pay-rows>
                                            <tr><td colspan="7" class="dash-pay-empty">Recent payments load here.</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="dash-pay-note">Latest 10 posted payments · <a href="/AdminPayments">All payments</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="status-chart" gs-x="8" gs-y="4" gs-w="4" gs-h="4" gs-min-w="3" gs-min-h="3">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Stay mix</h2>
                </header>
                <div class="dash-chart-wrap dash-chart-wrap--pie">
                    <canvas id="dashStatusChart" aria-label="Booking status mix"></canvas>
                </div>
                @{
                    var stayBookings = Model.StayMix.FirstOrDefault(s => s.Label == "Bookings")?.Count ?? 0;
                    var stayReservations = Model.StayMix.FirstOrDefault(s => s.Label == "Reservations")?.Count ?? 0;
                    var stayTotal = stayBookings + stayReservations;
                    var bookingPct = stayTotal > 0 ? Math.Round(100m * stayBookings / stayTotal, 2) : 0m;
                    var reservationPct = stayTotal > 0 ? 100m - bookingPct : 0m;
                }
                <div class="dash-staymix" data-dash-staymix>
                    <div class="dash-staymix-bar" role="img"
                         aria-label="Open stays: @stayBookings bookings, @stayReservations reservations">
                        <span class="dash-staymix-seg is-booking" data-staymix-booking style="width:@bookingPct.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                        <span class="dash-staymix-seg is-reservation" data-staymix-reservation style="width:@reservationPct.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                    </div>
                    <div class="dash-staymix-legend">
                        <span><i class="dash-staymix-dot is-booking" aria-hidden="true"></i>Bookings <strong data-staymix-booking-n>@stayBookings</strong></span>
                        <span><i class="dash-staymix-dot is-reservation" aria-hidden="true"></i>Reservations <strong data-staymix-reservation-n>@stayReservations</strong></span>
                    </div>
                </div>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="signals" gs-x="0" gs-y="9" gs-w="6" gs-h="3" gs-min-w="3" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Chatbot AI · API</h2>
                </header>
                @if (Model.Signals.Count == 0)
                {
                    <p class="dash-widget-empty">No chatbot API consumption or house signals yet.</p>
                }
                else
                {
                    <ul class="dash-signals" data-dash-widget="signals">
                        @foreach (var signal in Model.Signals)
                        {
                            <li class="dash-signal dash-signal--@signal.Level">
                                <strong>@signal.Title</strong>
                                <span>@signal.Detail</span>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>

        <div class="grid-stack-item" gs-id="channels" gs-x="6" gs-y="9" gs-w="6" gs-h="4" gs-min-w="3" gs-min-h="3">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Special offers</h2>
                    <a href="/AdminSpecialOffers">All offers</a>
                </header>
                <ul class="dash-offers" data-dash-widget="offers"
                    data-dash-can-manage="@(Model.IsAdminManager ? "true" : "false")">
                    <li class="dash-offer-empty">Loading offers…</li>
                </ul>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="attention" gs-x="0" gs-y="14" gs-w="12" gs-h="3" gs-min-w="4" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Front desk attention</h2>
                    <div class="dash-attn-controls">
                        <div class="dash-attn-filter" role="group" aria-label="Filter by booking type">
                            <button type="button" data-dash-attn-kind="Booking" aria-pressed="false">Bookings</button>
                            <button type="button" data-dash-attn-kind="Reservation" aria-pressed="false">Reservations</button>
                        </div>
                        <div class="dash-attn-search">
                            <button type="button" class="dash-attn-search-btn" data-dash-attn-search-toggle aria-expanded="false" aria-label="Search guests" title="Search guests">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
                            </button>
                            <div class="dash-attn-search-pop" data-dash-attn-search-pop hidden>
                                <input type="search" placeholder="Search guest or reference…" data-dash-attn-search aria-label="Search attention list" autocomplete="off" />
                            </div>
                        </div>
                        <a href="/AdminBookings">Open list</a>
                    </div>
                </header>
                @if (Model.Attention.Count == 0)
                {
                    <p class="dash-widget-empty">No pending calls or upcoming stays.</p>
                }
                else
                {
                    <ul class="dash-attention" data-dash-widget="attention">
                        @foreach (var item in Model.Attention)
                        {
                            <li data-attn-kind="@item.Bucket">
                                <a href="@item.Href" data-dash-open-booking="@item.BookingId">
                                    <strong>@item.Title</strong>
                                    <span>@item.Detail</span>
                                </a>
                                @if (item.Action == "review")
                                {
                                    <div class="dash-attention-actions">
                                        <button type="button" data-dash-attention-act="confirm" data-dash-booking-id="@item.BookingId">Confirm</button>
                                        <button type="button" class="is-danger" data-dash-attention-act="reject" data-dash-booking-id="@item.BookingId">Reject</button>
                                    </div>
                                }
                                else if (item.Action == "arrival")
                                {
                                    <div class="dash-attention-actions">
                                        <button type="button" data-dash-attention-act="done" data-dash-booking-id="@item.BookingId">Done</button>
                                    </div>
                                }
                                else if (item.Action == "open" && item.Bucket == "Booking")
                                {
                                    <div class="dash-attention-actions">
                                        <button type="button" data-dash-attention-act="assign" data-dash-booking-id="@item.BookingId">Assign</button>
                                    </div>
                                }
                                else if (item.Action == "open" && item.Bucket == "Reservation")
                                {
                                    <div class="dash-attention-actions">
                                        <button type="button" data-dash-attention-act="payments" data-dash-booking-id="@item.BookingId">Payments</button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
        <div class="grid-stack-item" gs-id="room-types" gs-x="0" gs-y="18" gs-w="6" gs-h="4" gs-min-w="3" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Room availability</h2>
                    <a href="/Rooms?view=types">Open rooms</a>
                </header>
                @if (Model.RoomTypes.Count == 0)
                {
                    <p class="dash-widget-empty">No room types configured yet.</p>
                }
                else
                {
                    <ul class="dash-roomtypes" data-dash-widget="room-types" data-dash-can-manage="@(Model.IsAdminManager ? "true" : "false")">
                        @foreach (var t in Model.RoomTypes)
                        {
                            var typeOpen = t.AvailableCount > 0;
                            <li>
                                <div class="dash-roomtype-head">
                                    <div class="dash-roomtype-info">
                                        <strong>@t.Name</strong>
                                        <span>@t.AvailableCount / @t.RoomCount open@(t.OccupiedCount > 0 ? $" · {t.OccupiedCount} occupied" : "")</span>
                                    </div>
                                    @if (Model.IsAdminManager)
                                    {
                                        var occupiedRooms = t.Rooms
                                            .Where(r => r.Status == "Occupied")
                                            .Select(r => r.RoomNumber)
                                            .ToList();
                                        var closeBlocked = typeOpen && occupiedRooms.Count > 0;
                                        <button type="button"
                                                class="dash-roomtype-switch @(typeOpen ? "is-on" : "")"
                                                role="switch" aria-checked="@(typeOpen ? "true" : "false")"
                                                aria-label="@t.Name — guest booking availability"
                                                @(closeBlocked ? "disabled" : "")
                                                title="@(closeBlocked ? $"Cannot close — room(s) {string.Join(", ", occupiedRooms)} still have guests inside. Check them out first." : (typeOpen ? "Stop new bookings for this room type" : "Reopen this room type for bookings"))"
                                                data-dash-roomtype-id="@t.RoomTypeId"
                                                data-dash-roomtype-name="@t.Name">
                                            <span class="dash-roomtype-track" aria-hidden="true"><span class="dash-roomtype-thumb"></span></span>
                                            <span class="dash-roomtype-state">@(typeOpen ? "Open" : "Closed")</span>
                                        </button>
                                    }
                                </div>
                                <div class="dash-roomtype-rooms">
                                    @{
                                        var roomGroups = new[]
                                        {
                                            (Label: "Open", Css: "is-available", Rooms: t.Rooms.Where(r => r.Status == "Available").ToList()),
                                            (Label: "Occupied", Css: "is-occupied", Rooms: t.Rooms.Where(r => r.Status == "Occupied").ToList()),
                                            (Label: "Maintaining", Css: "is-cleaning", Rooms: t.Rooms.Where(r => r.Status == "Cleaning" || r.Status == "Unavailable").ToList()),
                                        };
                                    }
                                    @foreach (var group in roomGroups.Where(g => g.Rooms.Count > 0))
                                    {
                                        <div class="dash-roomtype-group">
                                            <em>@group.Label</em>
                                            <div class="dash-roomchips">
                                                @foreach (var room in group.Rooms)
                                                {
                                                    <button type="button"
                                                            class="dash-roomchip @group.Css"
                                                            data-dash-room-id="@room.Id"
                                                            data-dash-room-number="@room.RoomNumber"
                                                            data-dash-room-status="@room.Status"
                                                            data-dash-room-type="@t.Name"
                                                            aria-label="Room @room.RoomNumber — @group.Label — view details">@room.RoomNumber</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
        <div class="grid-stack-item" gs-id="reviews" gs-x="6" gs-y="18" gs-w="6" gs-h="4" gs-min-w="3" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Guest reviews</h2>
                    <a href="/AdminReviews?replyState=pending">
                        <span data-dash-widget="reviews-count">@Model.PendingReviewCount</span> to reply
                    </a>
                </header>
                @if (Model.PendingReviews.Count == 0)
                {
                    <p class="dash-widget-empty">Every guest review has a hotel reply.</p>
                }
                else
                {
                    <ul class="dash-reviews" data-dash-widget="reviews">
                        @foreach (var review in Model.PendingReviews)
                        {
                            <li>
                                <a href="@review.Href" data-dash-open-review="@review.ReviewId">
                                    <strong>@review.Title</strong>
                                    <span>@review.Detail</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
    </div>
</section>

<div class="admin-reviews-modal dash-detail-modal" data-dash-detail-modal hidden>
    <button type="button" class="admin-reviews-modal-backdrop" data-dash-detail-close aria-label="Close details"></button>
    <section class="admin-reviews-modal-card" role="dialog" aria-modal="true" aria-labelledby="dashDetailTitle">
        <header class="admin-reviews-modal-head">
            <div class="dash-detail-head-main">
                <div class="dash-detail-meta">
                    <span class="dash-detail-kicker" data-dash-detail-kicker>Details</span>
                    <span class="dash-detail-ref" data-dash-detail-ref></span>
                </div>
                <h2 id="dashDetailTitle" data-dash-detail-title>Details</h2>
            </div>
            <button type="button" class="admin-reviews-modal-close" data-dash-detail-close aria-label="Close details">×</button>
        </header>
        <div class="admin-reviews-modal-body" data-dash-detail-body>
            <p class="admin-reviews-empty">Loading…</p>
        </div>
        <footer class="dash-detail-actions" data-dash-detail-actions></footer>
    </section>
</div>

<div class="admin-reviews-modal dash-roomtype-confirm" data-roomtype-confirm-modal hidden>
    <button type="button" class="admin-reviews-modal-backdrop" data-roomtype-confirm-cancel aria-label="Keep room type open"></button>
    <section class="admin-reviews-modal-card dash-roomtype-confirm-card" role="alertdialog" aria-modal="true"
        aria-labelledby="roomtypeConfirmTitle" aria-describedby="roomtypeConfirmDesc">
        <header class="admin-reviews-modal-head">
            <div class="dash-detail-head-main">
                <div class="dash-detail-meta">
                    <span class="dash-detail-kicker">Room availability</span>
                </div>
                <h2 id="roomtypeConfirmTitle">Proceed closing <span data-roomtype-confirm-name>this room type</span>?</h2>
            </div>
            <button type="button" class="admin-reviews-modal-close" data-roomtype-confirm-cancel aria-label="Keep room type open">×</button>
        </header>
        <div class="admin-reviews-modal-body">
            <p class="dash-roomtype-confirm-note" id="roomtypeConfirmDesc">
                <span class="dash-roomtype-confirm-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 2.6 19.5h18.8L12 3.5z"/><path d="M12 9.5v4.6"/><circle cx="12" cy="17" r="0.5" fill="currentColor" stroke="none"/></svg>
                </span>
                <span>Guests will stop seeing and booking these rooms online right away. Rooms already checked in or assigned stay as they are — this only blocks new bookings.</span>
            </p>
        </div>
        <footer class="dash-detail-actions">
            <div class="dash-attention-actions">
                <button type="button" class="dash-roomtype-confirm-keep" data-roomtype-confirm-cancel>Keep open</button>
                <button type="button" class="dash-roomtype-confirm-proceed" data-roomtype-confirm-ok>Yes, close it</button>
            </div>
        </footer>
    </section>
</div>

<div class="admin-reviews-modal dash-room-modal" data-dash-room-modal hidden>
    <button type="button" class="admin-reviews-modal-backdrop" data-dash-room-close aria-label="Close room details"></button>
    <section class="admin-reviews-modal-card" role="dialog" aria-modal="true" aria-labelledby="dashRoomTitle">
        <header class="admin-reviews-modal-head">
            <div class="dash-detail-head-main">
                <div class="dash-detail-meta">
                    <span class="dash-detail-kicker">Room</span>
                    <span class="dash-detail-ref" data-dash-room-type></span>
                </div>
                <h2 id="dashRoomTitle" data-dash-room-title>Room</h2>
            </div>
            <button type="button" class="admin-reviews-modal-close" data-dash-room-close aria-label="Close room details">×</button>
        </header>
        <div class="admin-reviews-modal-body">
            <dl class="dash-room-facts">
                <div>
                    <dt><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 8v4.5l3 1.7"/></svg>Status</dt>
                    <dd><span class="dash-pay-status" data-dash-room-status></span></dd>
                </div>
                <div>
                    <dt><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg>Rate / night</dt>
                    <dd data-dash-room-rate></dd>
                </div>
                <div>
                    <dt><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="10" cy="8" r="3.2"/><path d="M4.5 19.5c.6-3.4 2.8-5 5.5-5s4.9 1.6 5.5 5"/><path d="M15.5 5.4a3.2 3.2 0 0 1 0 5.2M18.8 14.8c1.2.8 2 2 2.4 4.7"/></svg>Max guests</dt>
                    <dd data-dash-room-occupancy></dd>
                </div>
                <div>
                    <dt><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M3.5 18.5v-9.8M3.5 12.4h17M20.5 18.5v-4.1M6.5 12.4V9.2h5v3.2"/></svg>Beds</dt>
                    <dd data-dash-room-beds></dd>
                </div>
            </dl>
            <div class="dash-room-acc">
                <div class="dash-room-acc-item" data-dash-room-acc-item="desc">
                    <button type="button" class="dash-room-acc-head" data-dash-room-acc="desc" aria-expanded="false" aria-controls="dashRoomDescBody">
                        <span class="dash-room-acc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M7 3.5h7.5L19 8v12.5H7z"/><path d="M14 3.5V8.5h5M9.5 12h5.5M9.5 15.5h5.5"/></svg></span>
                        <span>Description</span>
                        <span class="dash-room-acc-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m6.5 9.5 5.5 5.5 5.5-5.5"/></svg></span>
                    </button>
                    <div class="dash-room-acc-body" id="dashRoomDescBody" data-dash-room-acc-body="desc" hidden>
                        <p data-dash-room-desc></p>
                    </div>
                </div>
                <div class="dash-room-acc-item" data-dash-room-acc-item="inclusions">
                    <button type="button" class="dash-room-acc-head" data-dash-room-acc="inclusions" aria-expanded="false" aria-controls="dashRoomInclBody">
                        <span class="dash-room-acc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m4.5 12.5 4.5 4.5L19.5 6.5"/><path d="M4.5 6h.01M4.5 19h.01" opacity=".4"/></svg></span>
                        <span>Inclusions</span>
                        <span class="dash-room-acc-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m6.5 9.5 5.5 5.5 5.5-5.5"/></svg></span>
                    </button>
                    <div class="dash-room-acc-body" id="dashRoomInclBody" data-dash-room-acc-body="inclusions" hidden>
                        <ul class="dash-room-inclusions" data-dash-room-inclusions></ul>
                    </div>
                </div>
            </div>
            <div class="dash-room-occupant" data-dash-room-occupant hidden>
                <em>Currently occupied by</em>
                <strong data-dash-room-guest></strong>
                <span data-dash-room-stay></span>
            </div>
            <p class="dash-roomtype-confirm-note dash-room-warning" data-dash-room-warning hidden role="alert">
                <span class="dash-roomtype-confirm-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 2.6 19.5h18.8L12 3.5z"/><path d="M12 9.5v4.6"/><circle cx="12" cy="17" r="0.5" fill="currentColor" stroke="none"/></svg>
                </span>
                <span data-dash-room-warning-text></span>
            </p>
            <p class="dash-offer-error" data-dash-room-error hidden role="alert"></p>
        </div>
        <footer class="dash-detail-actions">
            <div class="dash-attention-actions">
                <button type="button" class="is-quiet" data-dash-room-close>Close</button>
                <a class="dash-detail-manage" data-dash-room-booking href="/AdminBookings" hidden>Open booking →</a>
                <button type="button" data-dash-room-toggle>Close room</button>
            </div>
        </footer>
    </section>
</div>

<div class="admin-reviews-modal dash-roomtype-confirm" data-dash-roomconfirm-modal hidden>
    <button type="button" class="admin-reviews-modal-backdrop" data-dash-roomconfirm-cancel aria-label="Keep room as is"></button>
    <section class="admin-reviews-modal-card dash-roomtype-confirm-card" role="alertdialog" aria-modal="true"
        aria-labelledby="roomConfirmTitle" aria-describedby="roomConfirmDesc">
        <header class="admin-reviews-modal-head">
            <div class="dash-detail-head-main">
                <div class="dash-detail-meta">
                    <span class="dash-detail-kicker">Room availability</span>
                </div>
                <h2 id="roomConfirmTitle" data-dash-roomconfirm-title>Close Room <span data-dash-roomconfirm-name>this room</span>?</h2>
            </div>
            <button type="button" class="admin-reviews-modal-close" data-dash-roomconfirm-cancel aria-label="Cancel">×</button>
        </header>
        <div class="admin-reviews-modal-body">
            <p class="dash-roomtype-confirm-note" id="roomConfirmDesc">
                <span class="dash-roomtype-confirm-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 2.6 19.5h18.8L12 3.5z"/><path d="M12 9.5v4.6"/><circle cx="12" cy="17" r="0.5" fill="currentColor" stroke="none"/></svg>
                </span>
                <span data-dash-roomconfirm-desc>Are you sure you want to close this room?</span>
            </p>
            <p class="dash-offer-error" data-dash-roomconfirm-error hidden role="alert"></p>
        </div>
        <footer class="dash-detail-actions">
            <div class="dash-attention-actions">
                <button type="button" class="dash-roomtype-confirm-keep" data-dash-roomconfirm-cancel>Cancel</button>
                <button type="button" class="dash-roomtype-confirm-proceed" data-dash-roomconfirm-ok>Yes, close it</button>
            </div>
        </footer>
    </section>
</div>

<div class="admin-reviews-modal dash-offer-modal" data-dash-offer-modal hidden>
    <button type="button" class="admin-reviews-modal-backdrop" data-dash-offer-close aria-label="Close offer activation"></button>
    <section class="admin-reviews-modal-card" role="dialog" aria-modal="true" aria-labelledby="dashOfferTitle">
        <header class="admin-reviews-modal-head">
            <div class="dash-detail-head-main">
                <div class="dash-detail-meta">
                    <span class="dash-detail-kicker">Special offer</span>
                </div>
                <h2 id="dashOfferTitle">Activate offer</h2>
            </div>
            <button type="button" class="admin-reviews-modal-close" data-dash-offer-close aria-label="Close offer activation">×</button>
        </header>
        <div class="admin-reviews-modal-body">
            <p class="dash-offer-lede" data-dash-offer-lede>Choose a new start and end (Manila time). Previous dates are cleared.</p>
            <div class="dash-offer-fields">
                <label class="dash-offer-field">
                    <span>Starts</span>
                    <input type="datetime-local" class="form-control" data-dash-offer-start />
                </label>
                <label class="dash-offer-field">
                    <span>Ends</span>
                    <input type="datetime-local" class="form-control" data-dash-offer-end />
                </label>
            </div>
            <p class="dash-offer-error" data-dash-offer-error role="alert" hidden></p>
        </div>
        <footer class="dash-detail-actions">
            <div class="dash-attention-actions">
                <a class="dash-detail-manage" data-dash-offer-edit href="/AdminSpecialOffers">Edit full details →</a>
                <button type="button" class="is-quiet" data-dash-offer-close>Cancel</button>
                <button type="button" data-dash-offer-activate>Activate offer</button>
            </div>
        </footer>
    </section>
</div>

<div class="admin-report-modal" data-dash-report-modal hidden>
    <div class="admin-report-modal-card" role="dialog" aria-modal="true" aria-labelledby="dashReportTitle">
        <button type="button" class="admin-report-x" data-dash-report-close aria-label="Close report preview">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </button>
        <header class="admin-report-modal-head">
            <div class="admin-report-title">
                <img class="admin-report-head-logo" src="~/Images/Logo.png" alt="Mori International Hotel logo">
                <div>
                    <h2 id="dashReportTitle">Operations report</h2>
                    <p>Pick a date range, preview the document, then save it as PDF. Preview matches the downloaded file exactly — tables first, charts on the last page.</p>
                </div>
            </div>
            <div class="admin-report-modal-actions">
                <label class="admin-report-date">
                    <span>From</span>
                    <input type="date" data-dash-report-from>
                </label>
                <label class="admin-report-date">
                    <span>To</span>
                    <input type="date" data-dash-report-to>
                </label>
                <button type="button" class="btn btn-primary admin-report-btn" data-dash-report-preview>
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 13h7M9 17h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Preview report
                </button>
                <button type="button" class="btn btn-primary admin-report-btn" data-dash-report-print disabled>
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 17v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Save as PDF
                </button>
            </div>
        </header>
        <div class="admin-report-modal-body">
            <div class="admin-report-doc" data-dash-report-doc>
                <p class="admin-report-placeholder">Choose a date range, then select <strong>Preview report</strong>.</p>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="dashLayoutData">@(ViewBag.DashboardLayoutJson as string ?? "[]")</script>
<script type="application/json" id="dashChartData">@Html.Raw(chartPayload)</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/gridstack@11.3.0/dist/gridstack-all.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
