@model TestingDemo.Services.DashboardSnapshot
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var peso = CultureInfo.GetCultureInfo("en-PH");
    string Money(decimal value) => value.ToString("C", peso);
    var chartPayload = JsonSerializer.Serialize(new
    {
        days = Model.Last7Days.Select(d => new { d.Label, d.Revenue, d.Arrivals, d.OccupiedRooms }),
        status = Model.StatusMix.Select(s => new { s.Label, s.Count }),
        channels = Model.ChannelMix.Select(s => new { s.Label, s.Count })
    });
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@11.3.0/dist/gridstack.min.css" />
}

<section class="admin-flush-page admin-dash-page admin-dash-page--neumo">
    <section class="admin-flush-hero" aria-labelledby="dashTitle">
        <div class="admin-flush-hero-copy">
            <p class="admin-flush-eyebrow">@Model.RoleName operations</p>
            <h1 id="dashTitle">Business dashboard</h1>
            <p class="admin-flush-lede">
                Occupancy, cash, channel mix, and front-desk load for Mori International Hotel.
                Drag a report frame by its header, or resize from the corner. Your layout is saved to your staff account.
            </p>
        </div>
        <ul class="admin-flush-kpis" aria-label="Snapshot" data-dash-hero-kpis>
            <li>
                <span>Occupancy</span>
                <strong data-dash-field="occupancyPercent">@Model.OccupancyPercent.ToString("0.#")%</strong>
                <em data-dash-field="occupancyRooms">@Model.RoomsOccupied of @Model.RoomsTotal rooms</em>
            </li>
            <li>
                <span>Taken in today</span>
                <strong data-dash-field="revenueToday">@Money(Model.RevenueToday)</strong>
                <em>posted payments</em>
            </li>
            <li>
                <span>As of</span>
                <strong>PH</strong>
                <em data-dash-field="asOfPh">@Model.AsOfPh</em>
            </li>
        </ul>
    </section>

    <div class="admin-dash-toolbar">
        <p>Rearrange frames for the decision you need first. Your layout follows you after sign-out. Reception and admin share the same house numbers; refunds stay on the money frame for managers.</p>
        <div class="admin-dash-toolbar-actions">
            <button type="button" class="btn btn-primary" data-dash-report>Generate report</button>
            <button type="button" class="btn btn-outline-secondary" data-dash-reset>Reset layout</button>
        </div>
    </div>

    <div class="grid-stack" id="dashGrid"
         data-dash-user="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"
         data-dash-role="@Model.RoleName"
         data-layout-url="@Url.Action("SaveLayout")"
         data-dash-snapshot-url="@Url.Content("~/api/admin/dashboard/snapshot")">
        <div class="grid-stack-item" gs-id="occupancy" gs-x="0" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Occupancy</h2>
                    <a href="/Rooms">Rooms</a>
                </header>
                <p class="dash-widget-stat" data-dash-widget="occupancy-stat">@Model.OccupancyPercent.ToString("0.#")%</p>
                <p class="dash-widget-meta" data-dash-widget="occupancy-meta">@Model.RoomsOccupied occupied · @Model.RoomsAvailable open</p>
                <p class="dash-widget-note" data-dash-widget="occupancy-note">@Model.RoomsCleaning maintaining · @Model.RoomsUnavailable unavailable</p>
                <p class="dash-widget-note" data-dash-widget="occupancy-rates">ADR @Money(Model.Adr) · RevPAR @Money(Model.RevPar)</p>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="arrivals" gs-x="3" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Today’s board</h2>
                    <a href="/AdminBookings">Bookings</a>
                </header>
                <dl class="dash-widget-dl" data-dash-widget="arrivals">
                    <div><dt>Arrivals</dt><dd data-dash-arrivals>@Model.ArrivalsToday</dd></div>
                    <div><dt>Departures</dt><dd data-dash-departures>@Model.DeparturesToday</dd></div>
                    <div><dt>In house</dt><dd data-dash-inhouse>@Model.InHouseStays</dd></div>
                    <div><dt>Pending</dt><dd data-dash-pending>@Model.PendingStays</dd></div>
                </dl>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="money" gs-x="6" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Money</h2>
                    <a href="/AdminPayments">Payments</a>
                </header>
                <p class="dash-widget-stat" data-dash-widget="money-stat">@Money(Model.RevenueMonth)</p>
                <p class="dash-widget-meta" data-dash-widget="money-meta">This month posted · today <span data-dash-revenue-today>@Money(Model.RevenueToday)</span></p>
                @if (Model.IsAdminManager)
                {
                    <p class="dash-widget-note" data-dash-widget="money-refunds">Refunded this month @Money(Model.RefundsMonth)</p>
                }
                <p class="dash-widget-note" data-dash-widget="money-pipeline">Open stay value @Money(Model.PipelineValue) · avg @Money(Model.AverageStayValue)</p>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="offers" gs-x="9" gs-y="0" gs-w="3" gs-h="3" gs-min-w="2" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Offers &amp; books</h2>
                    <a href="/AdminSpecialOffers">Offers</a>
                </header>
                <p class="dash-widget-stat" data-dash-widget="offers-stat">@Model.ActiveOffers</p>
                <p class="dash-widget-meta">Active promotions now</p>
                <p class="dash-widget-note" data-dash-widget="offers-note">@Model.ConfirmedStays confirmed · @Model.BookedSharePercent.ToString("0.#")% of open stays confirmed</p>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="revenue-chart" gs-x="0" gs-y="4" gs-w="8" gs-h="4" gs-min-w="4" gs-min-h="3">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Posted revenue &amp; arrivals · 7 days</h2>
                </header>
                <div class="dash-chart-wrap">
                    <canvas id="dashRevenueChart" aria-label="Seven day posted revenue and arrivals"></canvas>
                </div>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="status-chart" gs-x="8" gs-y="4" gs-w="4" gs-h="4" gs-min-w="3" gs-min-h="3">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Stay mix</h2>
                </header>
                <div class="dash-chart-wrap dash-chart-wrap--pie">
                    <canvas id="dashStatusChart" aria-label="Booking status mix"></canvas>
                </div>
            </article>
        </div>

        <div class="grid-stack-item" gs-id="signals" gs-x="0" gs-y="9" gs-w="6" gs-h="3" gs-min-w="3" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Chatbot AI · API</h2>
                </header>
                @if (Model.Signals.Count == 0)
                {
                    <p class="dash-widget-empty">No chatbot API consumption or house signals yet.</p>
                }
                else
                {
                    <ul class="dash-signals" data-dash-widget="signals">
                        @foreach (var signal in Model.Signals)
                        {
                            <li class="dash-signal dash-signal--@signal.Level">
                                <strong>@signal.Title</strong>
                                <span>@signal.Detail</span>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>

        <div class="grid-stack-item" gs-id="channels" gs-x="6" gs-y="9" gs-w="6" gs-h="3" gs-min-w="3" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Open-stay channels</h2>
                </header>
                @if (Model.ChannelMix.Count == 0)
                {
                    <p class="dash-widget-empty">No pending or confirmed stays to split by channel.</p>
                }
                else
                {
                    <div class="dash-chart-wrap dash-chart-wrap--pie">
                        <canvas id="dashChannelChart" aria-label="Open stay channel mix"></canvas>
                    </div>
                }
            </article>
        </div>

        <div class="grid-stack-item" gs-id="attention" gs-x="0" gs-y="13" gs-w="12" gs-h="3" gs-min-w="4" gs-min-h="2">
            <article class="grid-stack-item-content dash-widget">
                <header class="dash-widget-handle">
                    <h2>Front desk attention</h2>
                    <a href="/AdminBookings">Open list</a>
                </header>
                @if (Model.Attention.Count == 0)
                {
                    <p class="dash-widget-empty">No pending calls or same-day arrivals in the next window.</p>
                }
                else
                {
                    <ul class="dash-attention" data-dash-widget="attention">
                        @foreach (var item in Model.Attention)
                        {
                            <li>
                                <a href="@item.Href">
                                    <strong>@item.Title</strong>
                                    <span>@item.Detail</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
    </div>
</section>

<div class="admin-report-modal" data-dash-report-modal hidden>
    <div class="admin-report-modal-card" role="dialog" aria-modal="true" aria-labelledby="dashReportTitle">
        <button type="button" class="admin-report-x" data-dash-report-close aria-label="Close report preview">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </button>
        <header class="admin-report-modal-head">
            <div class="admin-report-title">
                <img class="admin-report-head-logo" src="~/Images/Logo.png" alt="Mori International Hotel logo">
                <div>
                    <h2 id="dashReportTitle">Operations report</h2>
                    <p>Pick a date range, preview the document, then save it as PDF. Preview matches the downloaded file exactly — tables first, charts on the last page.</p>
                </div>
            </div>
            <div class="admin-report-modal-actions">
                <label class="admin-report-date">
                    <span>From</span>
                    <input type="date" data-dash-report-from>
                </label>
                <label class="admin-report-date">
                    <span>To</span>
                    <input type="date" data-dash-report-to>
                </label>
                <button type="button" class="btn btn-primary admin-report-btn" data-dash-report-preview>
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 13h7M9 17h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Preview report
                </button>
                <button type="button" class="btn btn-primary admin-report-btn" data-dash-report-print disabled>
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 17v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Save as PDF
                </button>
            </div>
        </header>
        <div class="admin-report-modal-body">
            <div class="admin-report-doc" data-dash-report-doc>
                <p class="admin-report-placeholder">Choose a date range, then select <strong>Preview report</strong>.</p>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="dashLayoutData">@(ViewBag.DashboardLayoutJson as string ?? "[]")</script>
<script type="application/json" id="dashChartData">@Html.Raw(chartPayload)</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/gridstack@11.3.0/dist/gridstack-all.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
