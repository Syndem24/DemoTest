@{
    ViewData["Title"] = "Review moderation";
}

<div class="admin-flush-page admin-reviews-page" data-admin-reviews>
    @Html.AntiForgeryToken()

    <section class="admin-flush-hero" aria-labelledby="adminReviewsTitle">
        <div class="admin-flush-hero-copy">
            <p class="admin-flush-eyebrow">Guest voices</p>
            <h1 id="adminReviewsTitle">Review moderation</h1>
            <p class="admin-flush-lede">
                Manage what appears on the public site. Hide or publish reviews and add a hotel reply for each guest stay.
            </p>
        </div>
        <ul class="admin-flush-kpis">
            <li>
                <span>Total</span>
                <strong data-admin-reviews-total>0</strong>
                <em>reviews</em>
            </li>
            <li>
                <span>Scale mode</span>
                <strong>Summary</strong>
                <em>open details on demand</em>
            </li>
        </ul>
    </section>

    <p class="admin-bookings-message" data-admin-reviews-message role="status" hidden></p>

    <section class="admin-flush-card">
        <header class="admin-flush-card-head">
            <h2>Published and hidden reviews</h2>
            <p>List stays lightweight with summaries. Open a review to view full content and actions.</p>
        </header>
        <div class="admin-reviews-toolbar">
            <label class="admin-reviews-page-size">
                <span>Rows</span>
                <select data-admin-reviews-page-size aria-label="Reviews per page">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
            <label class="admin-reviews-page-size">
                <span>Reply status</span>
                <select data-admin-reviews-reply-state aria-label="Filter by reply status">
                    <option value="all" selected>All</option>
                    <option value="replied">Done replying</option>
                    <option value="pending">Not replied yet</option>
                </select>
            </label>
        </div>
        <div class="admin-reviews-list" data-admin-reviews-list>
            <p class="admin-reviews-empty">Loading reviews…</p>
        </div>
        <nav class="admin-bookings-pagination" data-admin-reviews-pager hidden>
            <button type="button" data-admin-reviews-prev>Previous</button>
            <em data-admin-reviews-page-label>Page 1</em>
            <button type="button" data-admin-reviews-next>Next</button>
        </nav>
    </section>

    <div class="admin-reviews-modal" data-admin-reviews-modal hidden>
        <button type="button" class="admin-reviews-modal-backdrop" data-admin-reviews-modal-close aria-label="Close review detail"></button>
        <section class="admin-reviews-modal-card" role="dialog" aria-modal="true" aria-labelledby="adminReviewDetailTitle">
            <header class="admin-reviews-modal-head">
                <h2 id="adminReviewDetailTitle" data-admin-reviews-modal-title>Review details</h2>
                <button type="button" class="admin-reviews-modal-close" data-admin-reviews-modal-close aria-label="Close review detail">×</button>
            </header>
            <div class="admin-reviews-modal-body" data-admin-reviews-modal-body>
                <p class="admin-reviews-empty">Select a review.</p>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-reviews.js" asp-append-version="true"></script>
}
