@model TestingDemo.ViewModels.BookingPageViewModel
@using TestingDemo.Services
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Accommodations";
    ViewData["I18nTitle"] = "rooms.pageTitle";
    var typeCount = Model.RoomTypes.Count;
    var maxOccupancy = Model.RoomTypes.Count == 0
        ? 4
        : Math.Max(4, Model.RoomTypes.Max(t => t.MaxOccupancy));
    var bookableCount = Model.RoomTypes.Count(t => t.AvailableCount > 0);
}

<div class="wiz-page"
     id="rooms"
     data-google-guest="@(Model.GoogleGuestSignedIn ? "true" : "false")"
     data-google-login="@(Model.GoogleLoginEnabled ? "true" : "false")"
     data-wiz-root
     data-max-guests="@maxOccupancy">

    <form id="wizAntiForgery" class="visually-hidden" hidden>@Html.AntiForgeryToken()</form>
    @if (Model.GoogleLoginEnabled && !Model.GoogleGuestSignedIn)
    {
        <form id="wizGoogleLoginForm"
              asp-controller="Account"
              asp-action="ExternalLogin"
              method="post"
              class="visually-hidden"
              hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Url.Action("Accommodations", "Booking")" />
            <input type="hidden" name="rememberMe" value="true" />
        </form>
    }

    <section class="wiz-hero" aria-labelledby="wizHeroTitle">
        <div class="wiz-hero-media" aria-hidden="true">
            <img src="~/Images/Hallways/Hallway3.jpg" asp-append-version="true" alt="" decoding="async" fetchpriority="high" />
        </div>
        <div class="wiz-hero-fade" aria-hidden="true"></div>
        <div class="wiz-hero-glow" aria-hidden="true"></div>
        <div class="wiz-hero-inner">
            <nav class="wiz-crumb" aria-label="Breadcrumb">
                <a asp-controller="Booking" asp-action="Index" data-i18n="wiz.home">Home</a>
                <span aria-hidden="true">›</span>
                <span aria-current="page" data-i18n="wiz.crumbHere">Accommodation</span>
            </nav>
            <p class="wiz-chip">
                <span class="wiz-chip-dot" aria-hidden="true"></span>
                <span data-i18n="@(typeCount == 0 ? "wiz.guestRooms" : typeCount == 1 ? "wiz.roomTypesCount" : "wiz.roomTypesCountPlural")"
                      data-i18n-params='{"n":@typeCount}'>
                    @(typeCount == 0 ? "Guest rooms" : $"{typeCount} room type{(typeCount == 1 ? "" : "s")}")
                </span>
            </p>
            <h1 id="wizHeroTitle"><span data-i18n="wiz.heroTitle">Reserve Your Sanctuary at Mori</span></h1>
            <p class="wiz-hero-lede" data-i18n="wiz.heroLede">
                Tell us when you’re arriving and how many guests, and we’ll surface rooms that fit your stay.
            </p>
        </div>
    </section>

    <section class="wiz-wrap" aria-label="Book a stay" data-i18n="rooms.bookStay" data-i18n-attr="aria-label">
        <div class="wiz-steps" data-wiz-steps role="list" aria-label="Booking steps" data-i18n="wiz.stepsAria" data-i18n-attr="aria-label">
            <div class="wiz-step-node is-active" data-wiz-step-node="1" role="listitem">
                <span class="wiz-step-dot" data-wiz-step-dot>1</span>
                <span class="wiz-step-label" data-i18n="wiz.stepDates">Stay Dates</span>
            </div>
            <div class="wiz-step-rail" data-wiz-step-rail="1" aria-hidden="true"></div>
            <div class="wiz-step-node" data-wiz-step-node="2" role="listitem">
                <span class="wiz-step-dot" data-wiz-step-dot>2</span>
                <span class="wiz-step-label" data-i18n="wiz.stepRoom">Choose Room</span>
            </div>
        </div>

        <div class="wiz-panel is-in" data-wiz-panel="1">
            <p class="wiz-kicker" data-i18n="wiz.step1of2">Step 1 of 2</p>
            <div class="wiz-rule" aria-hidden="true"></div>
            <h2 data-i18n="wiz.whenStay">When would you like to stay?</h2>
            <p class="wiz-lede" data-i18n="wiz.whenStayLede">Select your arrival and departure dates, then add how many guests are staying.</p>

            <div class="wiz-search" data-wiz-search>
                <div class="wiz-search-tabs" role="tablist" aria-label="Stay search" data-i18n="wiz.searchAria" data-i18n-attr="aria-label">
                    <button type="button"
                            class="wiz-search-tab is-need"
                            role="tab"
                            data-wiz-search-tab="guests"
                            data-wiz-tab-guests
                            aria-haspopup="dialog"
                            aria-expanded="false"
                            aria-controls="wizStayDlg"
                            aria-selected="false">
                        <span class="wiz-search-tab-face">
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="6.2" cy="6" r="2.2" stroke="currentColor" stroke-width="1.4"/><circle cx="12.2" cy="6.4" r="1.8" stroke="currentColor" stroke-width="1.4"/><path d="M2.4 14.2c.4-2.2 2.2-3.5 3.8-3.5s3.4 1.3 3.8 3.5M10.2 11.2c1.4 0 2.8.9 3.2 2.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                            <span>
                                <strong><span data-i18n="wiz.guests">Guests</span> <span class="wiz-req">*</span></strong>
                                <em data-wiz-stay-heads data-i18n="wiz.addDetails">Add details</em>
                            </span>
                        </span>
                    </button>
                    <button type="button"
                            class="wiz-search-tab is-on"
                            role="tab"
                            data-wiz-search-tab="in"
                            data-wiz-field="checkIn"
                            aria-selected="true">
                        <span class="wiz-search-tab-face">
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2.2" y="3.2" width="13.6" height="12.6" rx="2.2" stroke="currentColor" stroke-width="1.4"/><path d="M2.2 7.2h13.6M6.2 2.2v2.4M11.8 2.2v2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M6.6 11.2l1.6 1.6 3.4-3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>
                                <strong data-i18n="wiz.checkIn">Check-in</strong>
                                <em data-wiz-tab-in data-i18n="wiz.selectDate">Select date</em>
                            </span>
                        </span>
                    </button>
                    <button type="button"
                            class="wiz-search-tab"
                            role="tab"
                            data-wiz-search-tab="out"
                            data-wiz-field="checkOut"
                            aria-selected="false">
                        <span class="wiz-search-tab-face">
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2.2" y="3.2" width="13.6" height="12.6" rx="2.2" stroke="currentColor" stroke-width="1.4"/><path d="M2.2 7.2h13.6M6.2 2.2v2.4M11.8 2.2v2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M6.6 11.2l1.6 1.6 3.4-3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>
                                <strong data-i18n="wiz.checkOut">Check-out</strong>
                                <em data-wiz-tab-out data-i18n="wiz.selectDate">Select date</em>
                            </span>
                        </span>
                    </button>
                </div>

                <div class="wiz-cal" data-wiz-cal>
                    <div class="wiz-cal-nav">
                        <button type="button" class="wiz-cal-shift" data-wiz-cal-prev aria-label="Previous month" data-i18n="wiz.prevMonth" data-i18n-attr="aria-label" data-i18n-attr-only>
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M7.5 2.5 3.5 6l4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <p class="wiz-cal-nav-title" data-wiz-cal-title></p>
                        <button type="button" class="wiz-cal-shift" data-wiz-cal-next aria-label="Next month" data-i18n="wiz.nextMonth" data-i18n-attr="aria-label" data-i18n-attr-only>
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4.5 2.5 8.5 6l-4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                    <div class="wiz-cal-months" data-wiz-cal-months></div>
                </div>

                <div class="wiz-cal-foot">
                    <p class="wiz-cal-rate-note" data-i18n="wiz.calRateNote">Prices on each date are the lowest nightly room rate. Special offers may be lower.</p>
                    <div class="wiz-cal-foot-row">
                        <p class="wiz-cal-sum" data-wiz-cal-sum data-i18n="wiz.calSumIdle">Select check-in, then check-out, and confirm guests.</p>
                        <div class="wiz-cal-nights-slot">
                            <p class="wiz-nights" data-wiz-nights hidden role="status" aria-live="polite">
                                <span class="wiz-nights-dot" aria-hidden="true"></span>
                                <span data-wiz-nights-text></span>
                            </p>
                        </div>
                        <div class="wiz-cal-actions">
                            <button type="button" class="wiz-cal-cancel" data-wiz-cal-clear data-i18n="wiz.clearDates">Clear dates</button>
                            <button type="button" class="wiz-btn wiz-btn-primary" data-wiz-next="1" disabled aria-disabled="true">
                                <span data-i18n="wiz.continue">Continue</span>
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                        </div>
                    </div>
                    <span class="wiz-field-error" data-wiz-error="checkIn" role="alert"></span>
                    <span class="wiz-field-error" data-wiz-error="checkOut" role="alert"></span>
                </div>
            </div>

            <div class="visually-hidden">
                <label for="wizCheckIn" data-i18n="wiz.checkIn">Check-in</label>
                <input id="wizCheckIn" name="checkIn" type="date" autocomplete="off" required />
                <label for="wizCheckOut" data-i18n="wiz.checkOut">Check-out</label>
                <input id="wizCheckOut" name="checkOut" type="date" autocomplete="off" required />
            </div>
        </div>

        <div class="wiz-panel" data-wiz-panel="2" hidden>
            <div class="wiz-rooms-head">
                <div>
                    <p class="wiz-kicker" data-i18n="wiz.step2of2">Step 2 of 2</p>
                    <div class="wiz-rule" aria-hidden="true"></div>
                    <h2 data-wiz-rooms-title>@(bookableCount) Rooms Available</h2>
                </div>
                <div class="wiz-rooms-meta">
                    <span class="wiz-mini-chip" data-wiz-chip-dates></span>
                    <span class="wiz-mini-chip" data-wiz-chip-guests></span>
                    <button type="button" class="wiz-change" data-wiz-change-dates aria-label="Back to stay dates" data-i18n="wiz.changeDatesAria" data-i18n-attr="aria-label">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M8.2 3.2 4.4 7l3.8 3.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span data-i18n="wiz.changeDates">Change dates</span>
                </button>
                </div>
            </div>
            <ul class="wiz-slot-list" data-wiz-slots hidden></ul>
            <p class="wiz-lede" data-wiz-rooms-lede data-i18n="wiz.roomsLede">
                Add one room type for each room in your stay.
            </p>
            <p class="wiz-form-alert" data-wiz-rooms-alert hidden role="alert"></p>

            @if (!Model.RoomTypes.Any())
            {
                <p class="wiz-empty" role="status" data-i18n="wiz.emptyTypes">No room types to show right now. Please check back soon, or contact the front desk.</p>
    }
    else
    {
                <div class="wiz-grid" data-wiz-grid>
                @foreach (var type in Model.RoomTypes)
                {
                var images = type.Images ?? new List<string>();
                var inclusions = InclusionCatalog.OrderForGuestDisplay(type.Inclusions);
                        var image = images.FirstOrDefault() ?? "";
                        var description = type.Description ?? "";
                var imagesJson = System.Text.Json.JsonSerializer.Serialize(images);
                var inclusionsJson = System.Text.Json.JsonSerializer.Serialize(inclusions);
                var canBook = type.AvailableCount > 0;
                        var viewHint = inclusions.FirstOrDefault(i => i.Contains("view", StringComparison.OrdinalIgnoreCase))
                            ?? (canBook ? $"{type.AvailableCount} available" : "Sold out");
                        var tagline = string.IsNullOrWhiteSpace(description)
                            ? $"{type.MaxOccupancy} guests · {type.BedCount} bed{(type.BedCount == 1 ? "" : "s")}"
                            : (description.Length > 110 ? description[..107] + "…" : description);
                        <article class="wiz-card"
                                 data-wiz-card
                                 data-room-type-id="@type.RoomTypeId"
                         data-room-type="@type.Name"
                         data-price="@type.PricePerNight.ToString("0.00")"
                         data-occupancy="@type.MaxOccupancy"
                         data-beds="@type.BedCount"
                         data-available="@type.AvailableCount"
                         data-images='@Html.Raw(imagesJson)'
                         data-inclusions='@Html.Raw(inclusionsJson)'
                                 data-description="@description">
                            <div class="wiz-card-media" data-wiz-open-detail aria-label="View @type.Name details">
                        @if (!string.IsNullOrWhiteSpace(image))
                        {
                                    <img src="@image" alt="" loading="lazy" />
                                }
                                <div class="wiz-card-media-fade" aria-hidden="true"></div>
                                <span class="wiz-badge@(canBook ? "" : " is-sold")" data-i18n="@(canBook ? "wiz.available" : "wiz.soldOut")">@(canBook ? "Available" : "Sold out")</span>
                                <span class="wiz-offer-flag" data-wiz-offer-flag hidden></span>
                                <span class="wiz-card-check" aria-hidden="true">
                                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2 6.5l3 3 6-6" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>
                                <span class="wiz-card-view">
                                    <span class="wiz-card-view-dot" aria-hidden="true"></span>
                                    @viewHint
                                </span>
                            </div>
                            <div class="wiz-card-body">
                                <div class="wiz-card-title-row">
                                    <h3 data-wiz-open-detail>@type.Name</h3>
                                    <span class="wiz-card-cat" data-i18n="wiz.guestRoom">Guest room</span>
                                </div>
                                <p class="wiz-card-tag">@tagline</p>
                                <dl class="wiz-stats">
                                    <div>
                                        <dt data-i18n="wiz.open">Open</dt>
                                        <dd>@type.AvailableCount</dd>
                                    </div>
                                    <div>
                                        <dt data-i18n="wiz.guests">Guests</dt>
                                        <dd data-i18n="wiz.upToGuests" data-i18n-params='{"n":@type.MaxOccupancy}'>Up to @type.MaxOccupancy</dd>
                                    </div>
                                    <div>
                                        <dt data-i18n="wiz.bedLabel">Bed</dt>
                                        <dd data-i18n="@(type.BedCount == 1 ? "wiz.bed" : "wiz.beds")" data-i18n-params='{"n":@type.BedCount}'>@type.BedCount @(type.BedCount == 1 ? "bed" : "beds")</dd>
                                    </div>
                                </dl>
                                <div class="wiz-est">
                                    <div class="wiz-est-row">
                                        <div>
                                            <small data-wiz-est-label data-i18n="wiz.estTotal">Est. total</small>
                                            <strong data-wiz-est-total>₱@type.PricePerNight.ToString("N2")</strong>
                                        </div>
                                        <div>
                                            <small data-i18n="wiz.perNight">Per night</small>
                                            <span class="wiz-night-wrap">
                                                <s data-wiz-est-was hidden></s>
                                                <span data-wiz-est-night>₱@type.PricePerNight.ToString("N2")</span>
                        </span>
                            </div>
                    </div>
                                    <p class="wiz-card-offer" data-wiz-card-offer hidden></p>
                        </div>
                                <div class="wiz-card-actions">
                                    <button type="button" class="wiz-btn wiz-btn-ghost" data-wiz-detail data-i18n="wiz.details">Details</button>
                                    @if (canBook)
                                    {
                                        <button type="button" class="wiz-btn wiz-btn-primary" data-wiz-toggle>
                                            <span data-i18n="wiz.addToBooking">Add to Booking</span>
                                        </button>
                        }
                        else
                        {
                                        <button type="button" class="wiz-btn wiz-btn-primary" disabled data-i18n="wiz.soldOut">Sold out</button>
                                    }
                        </div>
                    </div>
                    </article>
                }
            </div>
                <p class="wiz-empty" data-wiz-empty hidden role="status" data-i18n="wiz.emptyTypes">No room types are listed right now. Please check back soon, or contact the front desk.</p>
            }

            <div class="wiz-sticky" data-wiz-sticky hidden>
                <p>
                    <span class="wiz-sticky-kicker" data-i18n="wiz.bookingSummary">Booking Summary</span>
                    <strong data-wiz-sticky-text>0 rooms</strong>
                </p>
                <button type="button" class="wiz-btn wiz-btn-primary" data-wiz-review>
                    <span data-wiz-review-label data-i18n="wiz.reviewBook">Review &amp; Book</span>
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>
        </div>
    </section>

    <div class="wiz-policy">
        <div class="wiz-policy-inner">
            <div class="wiz-policy-item">
                <span class="wiz-policy-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <p><strong data-i18n="wiz.wifiTitle">Wi-Fi in every room</strong><span data-i18n="wiz.wifiCopy">Stay connected throughout your visit</span></p>
                </div>
            <div class="wiz-policy-item">
                <span class="wiz-policy-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="11" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M2 7h12" stroke="currentColor" stroke-width="1.4"/></svg>
                </span>
                <p><strong data-i18n="wiz.ratesTitle">Rates in Philippine pesos</strong><span data-i18n="wiz.ratesCopy">Pay at the hotel on arrival</span></p>
            </div>
            <div class="wiz-policy-item">
                <span class="wiz-policy-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                </span>
                <p><strong data-i18n="wiz.checkTimesTitle">Check-in from 2:00 PM</strong><span data-i18n="wiz.checkTimesCopy">Check-out by 12:00 NN · late checkout on request</span></p>
        </div>
            <div class="wiz-policy-item">
                <span class="wiz-policy-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5 6 11.5 13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <p><strong data-i18n="wiz.cancelTitle">Cancellation in the Terms of Stay</strong><span data-i18n="wiz.cancelCopy">Read the policy before you confirm</span></p>
            </div>
                        </div>
                        </div>
                    </div>

<div class="wiz-stay-back" data-wiz-stay-back hidden></div>
<div class="wiz-stay-dlg" id="wizStayDlg" data-wiz-stay-sheet hidden role="dialog" aria-modal="true" aria-labelledby="wizStayTitle">
    <header class="wiz-sheet-head">
        <div>
            <p class="wiz-kicker" style="margin:0 0 0.2rem;" data-i18n="wiz.stayRequired">Required</p>
            <h2 id="wizStayTitle" tabindex="-1" data-i18n="wiz.stayTitle">How many people are staying?</h2>
        </div>
        <button type="button" class="wiz-icon-btn wiz-modal-close" data-wiz-stay-close aria-label="Close guests" data-i18n="wiz.closeGuests" data-i18n-attr="aria-label" data-i18n-attr-only>
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2.5 2.5l8 8M10.5 2.5l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
    </header>
    <div class="wiz-stay-body">
        <p class="wiz-lede" data-i18n="wiz.stayLede">Two guests are included per room. Extra guest ₱200 / night. Confirm this before you continue.</p>
        <p class="wiz-form-alert" id="wizStayAlert" data-wiz-stay-alert hidden role="alert"></p>
        <div class="wiz-pills" role="group" aria-label="Quick stay setup" data-i18n="wiz.quickStayAria" data-i18n-attr="aria-label">
            <button type="button" class="wiz-pill" data-wiz-preset="solo">
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.2" fill="currentColor"/></svg>
                <span data-i18n="wiz.solo">Solo</span>
            </button>
            <button type="button" class="wiz-pill is-on" data-wiz-preset="couple">
                <svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true"><circle cx="3.5" cy="5" r="2.6" fill="currentColor"/><circle cx="8.5" cy="5" r="2.6" fill="currentColor"/></svg>
                <span data-i18n="wiz.couple">Couple</span>
            </button>
            <button type="button" class="wiz-pill" data-wiz-preset="group">
                <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true"><circle cx="3" cy="5" r="2.2" fill="currentColor"/><circle cx="7" cy="5" r="2.2" fill="currentColor"/><circle cx="11" cy="5" r="2.2" fill="currentColor"/></svg>
                <span data-i18n="wiz.extraGuest">Extra guest</span>
            </button>
            <button type="button" class="wiz-pill" data-wiz-preset="family">
                <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true"><circle cx="5" cy="3.2" r="2" fill="currentColor"/><circle cx="9" cy="3.2" r="2" fill="currentColor"/><circle cx="4" cy="7.4" r="2" fill="currentColor"/><circle cx="10" cy="7.4" r="2" fill="currentColor"/></svg>
                <span data-i18n="wiz.twoRooms">Two rooms</span>
            </button>
                        </div>
        <div class="wiz-stay-grid">
            <div class="wiz-stay-rooms" data-wiz-stay-rooms></div>
            <button type="button" class="wiz-add-room" data-wiz-add-room>
