        <p class="wiz-offer-pick" data-wiz-offer-pick role="status"></p>
                        </div>
    <div class="wiz-sheet-foot">
        <div class="wiz-actions">
            <button type="button" class="wiz-btn wiz-btn-ghost" data-wiz-to-details>
