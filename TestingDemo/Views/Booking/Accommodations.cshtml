@model TestingDemo.ViewModels.BookingPageViewModel
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Accommodations";
    var typeCount = Model.RoomTypes.Count;
    var roomsGallery = new[]
    {
        new { Src = "/Images/Rooms/Room1.jpg", Position = "42% 48%", Label = "Queen room", Alt = "Calm queen guest room with made bed and soft lighting" },
        new { Src = "/Images/Rooms/Room2.jpg", Position = "46% 48%", Label = "Deluxe room", Alt = "Guest room with tropical curtains and a made bed" },
        new { Src = "/Images/Rooms/Twin1.jpg", Position = "48% 46%", Label = "Twin room", Alt = "Bright twin guest room with two single beds" }
    };
}

<section class="guest-hero guest-hero-rooms" id="roomsHero" aria-labelledby="roomsHeroTitle">
    <div class="guest-hero-media guest-hero-tour"
         data-hero-tour
         data-hero-tour-duration="12000"
         aria-hidden="true">
        @for (var i = 0; i < roomsGallery.Length; i++)
        {
            var slide = roomsGallery[i];
            <img src="@slide.Src"
                 asp-append-version="true"
                 alt=""
                 decoding="async"
                 fetchpriority="@(i == 0 ? "high" : "low")"
                 loading="@(i == 0 ? "eager" : "lazy")"
                 class="@(i == 0 ? "is-active is-drifting" : null)"
                 style="--hero-tour-position: @slide.Position"
                 data-hero-tour-slide />
        }
    </div>
    <div class="guest-hero-copy guest-hero-rooms-panel">
        <p class="guest-brand-mark" data-i18n="nav.brand">Mori International Hotel</p>
        <p class="guest-eyebrow guest-hero-rooms-eyebrow" data-i18n="rooms.eyebrow">Guest rooms</p>
        <h1 id="roomsHeroTitle" data-i18n="rooms.pageTitle">Accommodations</h1>
        <p class="guest-hero-lede" data-i18n="rooms.heroLede">
            Clean, quiet rooms for rest after a day in Cebu — browse availability and book in a few steps.
        </p>
        <div class="guest-hero-actions">
            <button type="button" class="guest-btn guest-btn-primary" data-guest-modal="guests" data-i18n="rooms.bookStay">Book a stay</button>
            <a class="guest-btn guest-btn-ghost" href="#rooms" data-i18n="rooms.browseRooms">Browse rooms</a>
        </div>
    </div>
</section>

<div class="guest-rooms-page" id="rooms">
    <header class="guest-section guest-rooms-intro guest-reveal guest-reveal--ink" data-reveal>
        <p class="guest-intro-kana guest-rooms-kana" aria-hidden="true">宿</p>
        <p class="guest-eyebrow" data-i18n="rooms.ourRooms">Our rooms</p>
        <h2 data-i18n="rooms.chooseRoom">Choose your room</h2>
        <div class="guest-rooms-intro-copy">
            <p data-i18n="rooms.introCopy">
                Air conditioning, hot showers, drinking water, and Wi‑Fi in every room —
                so your stay feels simple from the first night.
            </p>
        </div>
        @if (typeCount > 0)
        {
            var bookableCount = Model.RoomTypes.Count(t => t.AvailableCount > 0);
            <p class="guest-rooms-intro-meta"
               data-i18n-types-meta
               data-types="@typeCount"
               data-available-types="@bookableCount">
                @typeCount room type@(typeCount == 1 ? "" : "s")
                · @bookableCount available to book
            </p>
        }
    </header>

    @if (!Model.RoomTypes.Any())
    {
        <section class="guest-section">
            <div class="guest-empty" role="status">
                <strong data-i18n="rooms.emptyTitle">No room types to show right now.</strong>
                <p data-i18n="rooms.emptyBody">Please check back soon, or contact the front desk for assistance.</p>
            </div>
            <div class="guest-flow-bar guest-rooms-book-cta guest-reveal guest-reveal--shoji" data-reveal>
                <button type="button"
                        class="guest-flow-summary"
                        id="guestFlowSummaryBtn"
                        data-guest-modal="guests"
                        aria-haspopup="dialog">
                    <span class="guest-flow-summary-label" data-i18n="rooms.guests">Guests</span>
                    <strong id="guestFlowSummaryText">2 guests · 1 room</strong>
                </button>
                <button type="button" class="guest-btn guest-btn-primary" data-guest-modal="guests" data-i18n="rooms.startBooking">
                    Start booking
                </button>
            </div>
        </section>
    }
    else
    {
        <div class="guest-room-carousel guest-room-feature-carousel"
             data-room-carousel
             data-carousel-page-size="3"
             aria-label="Room types">
            <button type="button"
                    class="guest-room-carousel-nav is-prev"
                    data-room-carousel-prev
                    aria-label="Show previous room types"
                    data-i18n="rooms.prevTypes"
                    data-i18n-attr="aria-label"
                    data-i18n-attr-only>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>

            <div class="guest-room-features guest-room-track"
                 data-room-carousel-track
                 tabindex="0"
                 aria-label="Room types. Use the left and right arrow keys to browse."
                 data-i18n="rooms.carouselHint"
                 data-i18n-attr="aria-label"
                 data-i18n-attr-only>
                @foreach (var type in Model.RoomTypes)
                {
                var images = type.Images ?? new List<string>();
                var inclusions = type.Inclusions ?? new List<string>();
                var image = images.FirstOrDefault();
                var description = string.IsNullOrWhiteSpace(type.Description)
                    ? null
                    : type.Description;
                var imagesJson = System.Text.Json.JsonSerializer.Serialize(images);
                var inclusionsJson = System.Text.Json.JsonSerializer.Serialize(inclusions);
                var canBook = type.AvailableCount > 0;
                <article class="guest-room guest-room-feature guest-reveal guest-reveal--noren@(canBook ? "" : " is-sold-out")"
                         data-reveal
                         data-guest-modal="details"
                         data-fill-room="@type.Name"
                         data-room-type="@type.Name"
                         data-room-type-id="@type.RoomTypeId"
                         data-price="@type.PricePerNight.ToString("0.00")"
                         data-occupancy="@type.MaxOccupancy"
                         data-beds="@type.BedCount"
                         data-available="@type.AvailableCount"
                         data-images='@Html.Raw(imagesJson)'
                         data-inclusions='@Html.Raw(inclusionsJson)'
                         aria-labelledby="room-title-@type.RoomTypeId">
                    <div class="guest-room-desc-full" hidden>@(description ?? "")</div>

                    <div class="guest-room-feature-media" data-feature-media>
                        @if (!string.IsNullOrWhiteSpace(image))
                        {
                            <img src="@image"
                                 alt="@type.Name"
                                 loading="lazy"
                                 data-feature-image />
                        }
                        else
                        {
                            <div class="guest-room-placeholder" aria-hidden="true">
                                <span>@(string.IsNullOrWhiteSpace(type.Name) ? "R" : type.Name.Trim()[0].ToString().ToUpperInvariant())</span>
                            </div>
                        }

                        <span class="guest-room-availability@(canBook ? "" : " is-sold-out")"
                              data-i18n-available="@type.AvailableCount"
                              data-available="@type.AvailableCount">
                            @(canBook ? $"{type.AvailableCount} available" : "Fully booked")
                        </span>

                        @if (images.Count > 1)
                        {
                            <div class="guest-feature-pager" data-feature-pager>
                                <button type="button"
                                        class="guest-feature-pager-btn is-prev"
                                        data-feature-prev
                                        aria-label="Previous photo for @type.Name">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                                </button>
                                <span class="guest-feature-pager-count" data-feature-count>1 / @images.Count</span>
                                <button type="button"
                                        class="guest-feature-pager-btn is-next"
                                        data-feature-next
                                        aria-label="Next photo for @type.Name">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="guest-room-feature-copy">
                        <div class="guest-room-feature-heading">
                            <p class="guest-eyebrow" data-i18n="rooms.guestRoom">Guest room</p>
                            <h2 id="room-title-@type.RoomTypeId">@type.Name</h2>
                        </div>
                        @if (string.IsNullOrWhiteSpace(description))
                        {
                            <p class="guest-room-feature-desc" data-i18n="rooms.defaultDescription">
                                A comfortable stay with everything you need for a quiet night in.
                            </p>
                        }
                        else
                        {
                            <p class="guest-room-feature-desc">
                                @(description.Length > 180 ? description.Substring(0, 180).TrimEnd() + "…" : description)
                            </p>
                        }

                        <ul class="guest-room-feature-meta">
                            <li>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
                                <span data-i18n-up-to="@type.MaxOccupancy">Up to @type.MaxOccupancy guests</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5v14M3 9h18M21 5v14M7 13h10"/></svg>
                                <span data-i18n-beds="@type.BedCount">@type.BedCount bed@(type.BedCount == 1 ? "" : "s")</span>
                            </li>
                        </ul>

                        @if (inclusions.Count > 0)
                        {
                            <ul class="guest-room-feature-tags">
                                @foreach (var inclusion in inclusions.Take(3))
                                {
                                    <li>@inclusion</li>
                                }
                                @if (inclusions.Count > 3)
                                {
                                    <li data-i18n-more="@(inclusions.Count - 3)">+@(inclusions.Count - 3) more</li>
                                }
                            </ul>
                        }

                        <p class="guest-room-feature-price">
                            <small data-i18n="rooms.from">From</small>
                            <span>₱@type.PricePerNight.ToString("N2")</span>
                            <small data-i18n="rooms.perNight">per night</small>
                        </p>

                        <div class="guest-room-feature-actions">
                            <button type="button"
                                    class="guest-btn guest-btn-ghost"
                                    data-guest-modal="details"
                                    data-fill-room="@type.Name"
                                    aria-label="View details for @type.Name"
                                    data-i18n="rooms.details">
                                Details
                            </button>
                        </div>
                    </div>
                    </article>
                }
            </div>

            <button type="button"
                    class="guest-room-carousel-nav is-next"
                    data-room-carousel-next
                    aria-label="Show next room types"
                    data-i18n="rooms.nextTypes"
                    data-i18n-attr="aria-label"
                    data-i18n-attr-only>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
        </div>

        <div class="guest-flow-bar guest-rooms-book-cta guest-reveal guest-reveal--shoji" data-reveal>
            <button type="button"
                    class="guest-flow-summary"
                    id="guestFlowSummaryBtn"
                    data-guest-modal="guests"
                    aria-haspopup="dialog">
                <span class="guest-flow-summary-label" data-i18n="rooms.guests">Guests</span>
                <strong id="guestFlowSummaryText">2 guests · 1 room</strong>
            </button>
            <button type="button" class="guest-btn guest-btn-primary" data-guest-modal="guests" data-i18n="rooms.startBooking">
                Start booking
            </button>
        </div>
    }

    <section class="guest-section guest-rooms-frame guest-reveal guest-reveal--shoji"
             data-reveal
             data-reveal-stagger
             aria-labelledby="roomsFrameTitle">
        <div class="guest-rooms-frame-shell">
            <p class="guest-rooms-frame-kana" aria-hidden="true">間</p>
            <div class="guest-rooms-frame-inner">
                <header class="guest-rooms-frame-head" data-reveal-child>
                    <p class="guest-eyebrow" data-i18n="rooms.everyStay">Every stay</p>
                    <h2 id="roomsFrameTitle" data-i18n="rooms.inclusionsTitle">Guest rooms &amp; inclusions</h2>
                    <p class="guest-rooms-frame-lede" data-i18n="rooms.inclusionsLede">
                        The essentials every guest room includes — quiet space, ready for rest.
                    </p>
                </header>

                <div class="guest-rooms-frame-body is-twin">
                    <figure class="guest-rooms-frame-photo is-featured" data-reveal-child>
                        <img src="~/Images/Rooms/Twin1.jpg"
                             asp-append-version="true"
                             alt="Bright twin guest room with two single beds"
                             loading="lazy"
                             decoding="async" />
                        <figcaption data-i18n="rooms.twinRoom">Twin room</figcaption>
                    </figure>

                    <div class="guest-rooms-frame-amenities" data-reveal-child style="--reveal-child-delay: 160ms">
                        <h3 data-i18n="rooms.allInclude">All guest rooms include</h3>
                        <ul class="guest-rooms-amenities-list">
                            <li data-i18n="rooms.amenity1">1.5hp inverter split-type air conditioning</li>
                            <li data-i18n="rooms.amenity2">24-hour hot and cold shower</li>
                            <li data-i18n="rooms.amenity3">Complimentary flowing drinking water</li>
                            <li data-i18n="rooms.amenity4">Unlimited Wi‑Fi</li>
                            <li data-i18n="rooms.amenity5">Approximately 18 m² modular room</li>
                            <li data-i18n="rooms.amenity6">Ample on-site parking</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@* Details modal *@
<div class="guest-modal" id="detailsModal" hidden>
    <div class="guest-modal-backdrop" data-close-modal></div>
    <div class="guest-modal-dialog guest-modal-dialog-lg" role="dialog" aria-modal="true" aria-labelledby="detailsTitle">
        <div class="guest-details-header">
            <div class="guest-details-title-row">
                <h2 id="detailsTitle">Room</h2>
                <span class="guest-pill is-available" id="detailsStatusPill" data-i18n="details.available">Available</span>
                <div class="guest-details-rate-wrap">
                    <span class="guest-details-rate" id="detailsPrice">—</span>
                    <span class="guest-details-rate-period" data-i18n="details.night">/ night</span>
                </div>
            </div>
            <button type="button" class="guest-modal-close" data-close-modal aria-label="Close" data-i18n="details.close" data-i18n-attr="aria-label" data-i18n-attr-only>&times;</button>
        </div>

        <div class="guest-details-layout">
            <div class="guest-details-media">
                <div class="guest-details-gallery">
                    <div class="guest-details-stage" id="detailsPhotoStage" tabIndex="0" role="button" aria-label="Click to enlarge photo" data-i18n="details.enlargePhoto" data-i18n-attr="aria-label" data-i18n-attr-only>
                        <img id="detailsMainImage" class="guest-details-main-image" alt="" hidden />
                        <div id="detailsImageEmpty" class="guest-details-image-empty" hidden>
                            <span data-i18n="details.noPhotos">No photos yet</span>
                        </div>
                        <button type="button" class="guest-gallery-nav is-prev" id="detailsPrevPhoto" aria-label="Previous photo" data-i18n="details.prevPhoto" data-i18n-attr="aria-label" data-i18n-attr-only hidden>&lsaquo;</button>
                        <button type="button" class="guest-gallery-nav is-next" id="detailsNextPhoto" aria-label="Next photo" data-i18n="details.nextPhoto" data-i18n-attr="aria-label" data-i18n-attr-only hidden>&rsaquo;</button>
                        <span class="guest-gallery-count" id="detailsPhotoCount" hidden></span>
                        <div class="guest-gallery-zoom-hint" id="detailsZoomHint" hidden>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35M11 8v6M8 11h6"/></svg>
                            <span data-i18n="details.expandPhoto">Click photo to expand</span>
                        </div>
                    </div>
                    <div class="guest-details-thumbs" id="detailsThumbs" hidden></div>
                </div>

                <div class="guest-modal-actions guest-modal-actions-under-photo">
                    <button type="button" class="guest-btn guest-btn-primary" data-guest-modal="guests" id="detailsBookBtn" data-i18n="details.bookThisRoom">
                        Book this room
                    </button>
                    <button type="button" class="guest-btn guest-btn-ghost" data-close-modal data-i18n="details.close">Close</button>
                </div>
            </div>

            <div class="guest-details-copy">
                <div class="guest-specs-grid">
                    <div class="guest-spec-chip">
                        <div class="guest-spec-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <div class="guest-spec-meta">
                            <span class="guest-spec-label" data-i18n="details.capacity">Capacity</span>
                            <strong id="detailsOccupancy">—</strong>
                        </div>
                    </div>

                    <div class="guest-spec-chip">
                        <div class="guest-spec-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16M2 8h20M2 17h20M22 4v16"/><path d="M6 12h12"/></svg>
                        </div>
                        <div class="guest-spec-meta">
                            <span class="guest-spec-label" data-i18n="details.bedSetup">Bed Setup</span>
                            <strong id="detailsBeds">—</strong>
                        </div>
                    </div>

                    <div class="guest-spec-chip">
                        <div class="guest-spec-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        </div>
                        <div class="guest-spec-meta">
                            <span class="guest-spec-label" data-i18n="details.checkIn">Check-in</span>
                            <strong>14:00</strong>
                        </div>
                    </div>

                    <div class="guest-spec-chip">
                        <div class="guest-spec-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l-4-2"/></svg>
                        </div>
                        <div class="guest-spec-meta">
                            <span class="guest-spec-label" data-i18n="details.checkOut">Check-out</span>
                            <strong>12:00</strong>
                        </div>
                    </div>
                </div>

                <div class="guest-details-accordions">
                    <details class="guest-acc">
                        <summary>
                            <span data-i18n="details.description">Description & Experience</span>
                        </summary>
                        <div class="guest-acc-body">
                            <p class="guest-details-desc" id="detailsDescription"></p>
                        </div>
                    </details>

                    <details class="guest-acc">
                        <summary>
                            <span data-i18n="details.inclusions">Inclusions & Amenities</span>
                        </summary>
                        <div class="guest-acc-body">
                            <div class="guest-inclusion-groups" id="detailsInclusions"></div>
                        </div>
                    </details>

                    <details class="guest-acc">
                        <summary>
                            <span data-i18n="details.terms">Terms of Stay</span>
                        </summary>
                        <div class="guest-acc-body">
                            <div class="guest-terms-stay">
                                <p class="guest-terms-intro" data-i18n="details.termsIntro">
                                    Our top priority is ensuring your comfort and satisfaction throughout your stay with us. From the moment you walk through our doors, you will experience exceptional hospitality and personalized service designed to cater to your every need. Thank you for choosing us as your home away from home – we look forward to exceeding all of your expectations during your stay at our hotel.
                                </p>
                                <dl class="guest-terms-schedule">
                                    <div>
                                        <dt data-i18n="details.checkIn">Check-in</dt>
                                        <dd>14:00</dd>
                                    </div>
                                    <div>
                                        <dt data-i18n="details.checkOut">Check-out</dt>
                                        <dd>12:00</dd>
                                    </div>
                                </dl>
                                <div class="guest-terms-cancellation">
                                    <strong data-i18n="details.cancellationTitle">Booking cancellation</strong>
                                    <p data-i18n="details.cancellationBody">Cancellation and prepayment policies vary according to booking.</p>
                                </div>
                            </div>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
</div>

@* Guests count modal *@
<div class="guest-modal" id="guestsModal" hidden>
    <div class="guest-modal-backdrop" data-close-modal></div>
    <div class="guest-modal-dialog guest-modal-dialog-guests" role="dialog" aria-modal="true" aria-labelledby="guestsTitle">
        <button type="button" class="guest-modal-close" data-close-modal aria-label="Close" data-i18n="details.close" data-i18n-attr="aria-label" data-i18n-attr-only>&times;</button>
        <header class="guest-guests-head">
            <h2 id="guestsTitle" data-i18n="booking.guestsTitle">Guests</h2>
            <p class="guest-guests-rule" data-i18n="booking.guestsRule">Each room holds up to 2 guests included. One extra guest (3 total) is allowed for ₱200 / night. Children under 12 must stay with an adult.</p>
        </header>
        <div class="guest-guests-list" id="guestsRoomList" aria-live="polite"></div>
        <p class="guest-capacity-banner" id="guestsCapacityBanner" role="status" hidden></p>
        <p class="guest-guests-hint" id="guestsHint" hidden></p>
        <footer class="guest-guests-footer">
            <button type="button" class="guest-btn guest-btn-ghost" id="guestsAddRoomBtn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span data-i18n="booking.addRoom">Add room</span>
            </button>
            <button type="button" class="guest-btn guest-btn-primary" id="guestsSubmitBtn" data-i18n="booking.ok">OK</button>
        </footer>
    </div>
</div>

@* Room & offer selection *@
<div class="guest-modal" id="offerSelectModal" hidden>
    <div class="guest-modal-backdrop" data-close-modal></div>
    <div class="guest-modal-dialog guest-modal-dialog-lg guest-modal-dialog-offers" role="dialog" aria-modal="true" aria-labelledby="offerSelectTitle">
        <button type="button" class="guest-modal-close" data-close-modal aria-label="Close" data-i18n="details.close" data-i18n-attr="aria-label" data-i18n-attr-only>&times;</button>
        <header class="guest-offers-head">
            <div class="guest-offers-head-row">
                <button type="button" class="guest-offers-back" id="offerBackToGuestsBtn" aria-label="Back to guests" data-i18n="booking.backToGuests" data-i18n-attr="aria-label" data-i18n-attr-only>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                    <span id="offerBackLabel" data-i18n="booking.guestsTitle">Guests</span>
                </button>
                <div class="guest-offers-head-titles">
                    <p class="guest-eyebrow" data-i18n="booking.step2">Step 2</p>
                    <h2 id="offerSelectTitle" data-i18n="booking.addRoomsOffer">Add rooms &amp; offer</h2>
                </div>
            </div>
            <p class="guest-modal-lede guest-offers-lede" id="offerSelectLede" data-i18n="booking.offerLede">Add room types to your stay. Prices shown are per night.</p>
            <p class="guest-offers-party" id="offerPartySummary"></p>
            <p class="guest-capacity-banner guest-offers-capacity-banner" id="offerCapacityBanner" role="status" hidden></p>
        </header>

        <div class="guest-offers-layout">
            <div class="guest-offers-main">
                <div class="guest-offers-list" id="offerRoomList"></div>
                <p class="guest-offers-empty" id="offerEmptyState" hidden>
                    <strong id="offerEmptyTitle" data-i18n="booking.notEnoughTitle">Not enough rooms for your guests</strong>
                    <span id="offerEmptyMessage" data-i18n="booking.notEnoughBody">We do not have enough available rooms for this party. Reduce the number of rooms or guests, or check back later.</span>
                </p>
            </div>

            <aside class="guest-offer-cart" id="offerCartPanel" aria-label="Selected rooms" data-i18n="booking.selectedRooms" data-i18n-attr="aria-label" data-i18n-attr-only>
                <div class="guest-offer-cart-head">
                    <h3 data-i18n="booking.yourRooms">Your rooms</h3>
                    <p class="guest-offer-cart-lede" data-i18n="booking.cartLede">Added rooms and nightly price breakdown.</p>
                </div>
                <div class="guest-offer-cart-empty" id="offerCartEmpty">
                    <strong data-i18n="booking.noRoomsYet">No rooms added yet</strong>
                    <span data-i18n="booking.tapAddRoom">Tap Add room on a rate to build your stay.</span>
                </div>
                <ul class="guest-offer-cart-list" id="offerCartList" hidden></ul>
                <div class="guest-offer-cart-summary" id="offerCartSummary" hidden>
                    <div class="guest-offer-cart-summary-row">
                        <span data-i18n="booking.roomsAdded">Rooms added</span>
                        <strong id="offerCartRoomCount">0</strong>
                    </div>
                    <div class="guest-offer-cart-summary-row">
                        <span data-i18n="booking.perNight">Per night</span>
                        <strong id="offerCartNightlyTotal">₱0.00</strong>
                    </div>
                    <p class="guest-offer-cart-note" id="offerCartNote" data-i18n="booking.stayTotalAfterDates">Stay total is calculated after you choose dates.</p>
                </div>
                <p class="guest-offer-cart-hint" id="offerCartHint" hidden></p>
            </aside>
        </div>

        <footer class="guest-offers-footer">
            <button type="button"
                    class="guest-offers-selection-status is-empty"
                    id="offerSelectionStatus"
                    aria-live="polite"
                    disabled
                    data-i18n="booking.noRoomSelected">
                No room selected yet
            </button>
            <div class="guest-offers-footer-actions">
                <button type="button" class="guest-btn guest-btn-ghost" id="offerBackFooterBtn" data-i18n="booking.back">Back</button>
                <button type="button" class="guest-btn guest-btn-primary" id="offerContinueBtn" disabled data-i18n="booking.continue">
                    Continue
                </button>
            </div>
        </footer>
    </div>
</div>

@* Booking modal *@
<div class="guest-modal" id="bookModal" hidden>
    <div class="guest-modal-backdrop" data-close-modal></div>
    <div class="guest-modal-dialog guest-modal-dialog-lg guest-modal-dialog-book" role="dialog" aria-modal="true" aria-labelledby="bookTitle">
        <button type="button" class="guest-modal-close" data-close-modal aria-label="Close" data-i18n="details.close" data-i18n-attr="aria-label" data-i18n-attr-only>&times;</button>

        <header class="guest-book-modal-head">
            <p class="guest-eyebrow" data-i18n="booking.booking">Booking</p>
            <h2 id="bookTitle" data-i18n="booking.completeBooking">Complete your booking</h2>
            <p class="guest-modal-lede" id="bookModalLede" data-i18n="booking.bookLede">
                Step through guest details, dates, rooms, then payment and terms.
            </p>
            <p class="guest-book-party" id="bookPartySummary" hidden></p>
            <p class="guest-capacity-banner" id="bookCapacityBanner" role="status" hidden></p>
            <ol class="guest-book-steps" id="bookStepList" aria-label="Booking steps" data-i18n="booking.stepsAria" data-i18n-attr="aria-label" data-i18n-attr-only>
                <li class="is-guest is-current" data-book-step-tab="guest" aria-current="step">
                    <span class="guest-book-step-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </span>
                    <span data-i18n="booking.stepGuest">Guest</span>
                </li>
                <li class="is-dates" data-book-step-tab="dates">
                    <span class="guest-book-step-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    </span>
                    <span data-i18n="booking.stepDates">Dates</span>
                </li>
                <li class="is-rooms" data-book-step-tab="rooms">
                    <span class="guest-book-step-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21V8l9-5 9 5v13"/><path d="M9 21v-6h6v6"/></svg>
                    </span>
                    <span data-i18n="booking.stepRooms">Rooms</span>
                </li>
                <li class="is-payment" data-book-step-tab="confirm">
                    <span class="guest-book-step-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                    </span>
                    <span data-i18n="booking.stepConfirm">Confirm</span>
                </li>
            </ol>
        </header>

        <form class="guest-form guest-book-modal-form is-wizard" id="bookModalForm" novalidate data-min-lead-hours="24" data-book-step="guest">
            @Html.AntiForgeryToken()
            <section class="guest-book-section is-guest is-wizard-panel" id="bookGuestSection" data-book-step-panel="guest">
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">1</span>
                    <div>
                        <h3>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <span data-i18n="booking.guestDetails">Guest details</span>
                        </h3>
                        <p data-i18n="booking.guestDetailsLede">How we reach you about this stay.</p>
                    </div>
                </div>
                <p class="guest-room-capacity-msg" id="guestDetailsRequiredMsg" hidden></p>
                <div class="guest-form-grid">
                    <label>
                        <span data-i18n="booking.fullName">Full name</span>
                        <input type="text" name="guestName" id="guestName" placeholder="Guest full name" required data-i18n="booking.fullNamePlaceholder" data-i18n-attr="placeholder" data-i18n-attr-only />
                    </label>
                    <label>
                        <span data-i18n="booking.email">Email</span>
                        <input type="email" name="guestEmail" id="guestEmail" placeholder="name@email.com" required data-i18n="booking.emailPlaceholder" data-i18n-attr="placeholder" data-i18n-attr-only />
                    </label>
                    <label>
                        <span data-i18n="booking.phone">Phone</span>
                        <input type="tel" name="guestPhone" id="guestPhone" placeholder="+63 9XX XXX XXXX" autocomplete="tel" required data-i18n="booking.phonePlaceholder" data-i18n-attr="placeholder" data-i18n-attr-only />
                    </label>
                </div>
            </section>

            <section class="guest-book-section is-dates is-wizard-panel" id="bookDatesSection" data-book-step-panel="dates" hidden>
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">2</span>
                    <div>
                        <h3>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                            <span data-i18n="booking.stayDates">Stay dates</span>
                        </h3>
                        <p data-i18n="booking.stayDatesLede">One date range applies to every room in this booking.</p>
                    </div>
                </div>
                <p class="guest-room-capacity-msg" id="stayDatesRequiredMsg" hidden></p>
                <div class="guest-form-grid guest-form-grid-2">
                    <label>
                        <span data-i18n="booking.checkInDate">Check-in date</span>
                        <input type="date" name="modalCheckIn" id="modalCheckIn" required inputmode="none" autocomplete="off" class="guest-date-picker" />
                    </label>
                    <label>
                        <span data-i18n="booking.checkOutDate">Check-out date</span>
                        <input type="date" name="modalCheckOut" id="modalCheckOut" required inputmode="none" autocomplete="off" class="guest-date-picker" />
                    </label>
                </div>
                <div class="guest-form-grid guest-form-grid-2 guest-time-grid">
                    <label>
                        <span data-i18n="booking.checkInTime">Check-in time</span>
                        <select name="modalCheckInTime" id="modalCheckInTime" class="guest-time-select" aria-describedby="stayTimeFeesHint">
                            <option value="14:00" selected>14:00 — free of charge</option>
                        </select>
                    </label>
                    <label>
                        <span data-i18n="booking.checkOutTime">Check-out time</span>
                        <select name="modalCheckOutTime" id="modalCheckOutTime" class="guest-time-select" aria-describedby="stayTimeFeesHint">
                            <option value="12:00" selected>12:00 — free of charge</option>
                        </select>
                    </label>
                </div>
                <p class="guest-time-fees" id="stayTimeFeesHint" hidden></p>
                <p class="guest-lead-hint" id="modalLeadHint" hidden></p>
            </section>

            <section class="guest-book-section is-rooms is-wizard-panel" id="bookRoomsSection" data-book-step-panel="rooms" hidden>
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">3</span>
                    <div>
                        <h3>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 21V8l9-5 9 5v13"/><path d="M9 21v-6h6v6"/></svg>
                            <span data-i18n="booking.roomsInBooking">Rooms in this booking</span>
                        </h3>
                        <p data-i18n="booking.roomsInBookingLede">Review your rooms. Tap Change to switch room type.</p>
                    </div>
                    <span class="guest-cart-status is-empty" id="bookingCartStatus" data-i18n="booking.cartEmpty">Cart empty</span>
                </div>
                <p class="guest-room-capacity-msg" id="bookRoomsCapacityMsg" hidden></p>

                <div class="guest-booking-cart" id="bookingCart" aria-live="polite">
                    <div class="guest-cart-empty" id="bookingCartEmpty">
                        <span class="guest-cart-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h18l-1.5 12H4.5L3 7z"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
                        </span>
                        <strong data-i18n="booking.cartEmptyTitle">Your cart is empty</strong>
                        <span data-i18n="booking.cartEmptyBody">Go back and add rooms from the room list, or reopen Change after selecting a stay.</span>
                    </div>
                    <ul class="guest-cart-list" id="bookingCartList" hidden></ul>
                    <div class="guest-cart-totals" id="bookingCartSummary" hidden>
                        <button type="button" class="guest-cart-totals-toggle" id="bookingCartTotalsToggle" aria-expanded="false" aria-controls="bookingCartTotalsPanel">
                            <span class="guest-cart-totals-toggle-main">
                                <span class="guest-cart-totals-eyebrow" data-i18n="booking.totalPrices">Total prices</span>
                                <span id="bookingCartSummaryLabel">0 rooms</span>
                            </span>
                            <span class="guest-cart-totals-toggle-end">
                                <strong id="bookingCartSummaryTotal">₱0.00</strong>
                                <svg class="guest-cart-totals-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                            </span>
                        </button>
                        <div class="guest-cart-totals-panel" id="bookingCartTotalsPanel" hidden>
                            <ul class="guest-cart-totals-lines" id="bookingCartTotalsLines"></ul>
                        </div>
                    </div>
                </div>
            </section>

            <section class="guest-book-section is-payment is-wizard-panel" id="bookPaymentSection" data-book-step-panel="confirm" hidden>
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">4</span>
                    <div>
                        <h3 data-i18n="details.terms">Terms of Stay</h3>
                        <p data-i18n="booking.termsLede">Please read these conditions before submitting your booking. Reception will call to verify before check-in.</p>
                    </div>
                </div>
                <input type="hidden" name="paymentOption" id="paymentOption" value="Full" />

                <div class="guest-terms-stay guest-book-terms">
                    <p class="guest-terms-intro" data-i18n="details.termsIntro">
                        Our top priority is ensuring your comfort and satisfaction throughout your stay with us. From the moment you walk through our doors, you will experience exceptional hospitality and personalized service designed to cater to your every need. Thank you for choosing us as your home away from home – we look forward to exceeding all of your expectations during your stay at our hotel.
                    </p>
                    <dl class="guest-terms-schedule">
                        <div>
                            <dt data-i18n="details.checkIn">Check-in</dt>
                            <dd>14:00</dd>
                        </div>
                        <div>
                            <dt data-i18n="details.checkOut">Check-out</dt>
                            <dd>12:00</dd>
                        </div>
                    </dl>
                    <div class="guest-terms-cancellation">
                        <strong data-i18n="details.cancellationTitle">Booking cancellation</strong>
                        <p data-i18n="details.cancellationBody">Cancellation and prepayment policies vary according to booking.</p>
                    </div>
                    <label class="guest-terms-accept">
                        <input type="checkbox" id="acceptStayTerms" name="acceptStayTerms" required />
                        <span data-i18n="booking.acceptTerms">I have read and agree to the Terms of Stay.</span>
                    </label>
                </div>
            </section>

            <p class="guest-form-message" id="bookFormMessage" hidden></p>

            <div class="guest-modal-actions guest-book-modal-actions guest-book-wizard-actions">
                <button type="button" class="guest-btn guest-btn-ghost" id="bookWizardBackBtn" data-i18n="booking.backToRooms">
                    Back to rooms
                </button>
                <button type="button" class="guest-btn guest-btn-primary" id="bookWizardNextBtn" data-i18n="booking.next">
                    Next
                </button>
                <button type="submit" class="guest-btn guest-btn-primary guest-btn-lg" id="bookModalSubmit" hidden disabled>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <span data-i18n="booking.submitRequest">Submit request</span>
                </button>
                <button type="button" class="guest-btn guest-btn-ghost" data-close-modal data-i18n="booking.cancel">Cancel</button>
            </div>
        </form>
    </div>
</div>

@* Success modal *@
<div class="guest-modal" id="successModal" hidden>
    <div class="guest-modal-backdrop" data-close-modal></div>
    <div class="guest-modal-dialog guest-modal-dialog-sm" role="dialog" aria-modal="true" aria-labelledby="successTitle">
        <button type="button" class="guest-modal-close" data-close-modal aria-label="Close" data-i18n="details.close" data-i18n-attr="aria-label" data-i18n-attr-only>&times;</button>
        <p class="guest-eyebrow" id="successEyebrow" data-i18n="booking.booking">Booking</p>
        <h2 id="successTitle" data-i18n="booking.successTitleBooking">Booking received</h2>
        <p class="guest-modal-lede" id="successMessage" data-i18n="booking.successBody">
            Your request has been sent to the hotel for review.
        </p>
        <div class="guest-modal-actions">
            <button type="button" class="guest-btn guest-btn-primary" data-close-modal data-i18n="booking.done">Done</button>
        </div>
    </div>
</div>
