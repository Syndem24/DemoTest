<div class="wiz-date-back" data-wiz-date-back hidden></div>
<div class="wiz-date-dlg" data-wiz-date-sheet hidden role="dialog" aria-modal="true" aria-labelledby="wizDateTitle">
    <header class="wiz-sheet-head">
                                    <div>
            <p class="wiz-kicker" style="margin:0 0 0.2rem;" data-i18n="wiz.adjustDates">Adjust stay dates</p>
            <h2 id="wizDateTitle" data-wiz-date-title data-i18n="wiz.chooseDatesOffer">Choose dates for this offer</h2>
                                    </div>
        <button type="button" class="wiz-icon-btn wiz-modal-close" data-wiz-date-close aria-label="Close date adjustment" data-i18n="wiz.closeDateAdjust" data-i18n-attr="aria-label" data-i18n-attr-only>
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2.5 2.5l8 8M10.5 2.5l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
    </header>
    <div class="wiz-date-body">
        <p class="wiz-lede" data-wiz-date-copy></p>
        <div class="wiz-dates">
            <div class="wiz-field" data-wiz-date-field="in">
                <label for="wizOfferCheckIn" data-i18n="wiz.checkIn">Check-in</label>
                <div class="wiz-field-control">
                    <input id="wizOfferCheckIn" type="date" autocomplete="off" data-wiz-date-in />
                    <span class="wiz-field-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="3" width="14" height="13" rx="2.5" stroke="currentColor" stroke-width="1.4"/><path d="M2 7h14M6 2v2M12 2v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    </span>
                                    </div>
                <span class="wiz-field-error" data-wiz-date-error="in" role="alert"></span>
                                </div>
            <div class="wiz-field" data-wiz-date-field="out">
                <label for="wizOfferCheckOut" data-i18n="wiz.checkOut">Check-out</label>
                <div class="wiz-field-control">
                    <input id="wizOfferCheckOut" type="date" autocomplete="off" data-wiz-date-out />
                    <span class="wiz-field-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="3" width="14" height="13" rx="2.5" stroke="currentColor" stroke-width="1.4"/><path d="M2 7h14M6 2v2M12 2v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    </span>
                </div>
                <span class="wiz-field-error" data-wiz-date-error="out" role="alert"></span>
            </div>
        </div>
        <p class="wiz-nights is-on" data-wiz-date-nights role="status"></p>
    </div>
    <div class="wiz-sheet-foot">
        <div class="wiz-actions">
            <button type="button" class="wiz-btn wiz-btn-ghost" data-wiz-date-cancel data-i18n="wiz.cancel">Cancel</button>
            <button type="button" class="wiz-btn wiz-btn-primary" data-wiz-date-confirm data-i18n="wiz.useTheseDates">Use these dates</button>
        </div>
    </div>
</div>

<div class="wiz-drawer-back" data-wiz-drawer-back hidden></div>
<aside class="wiz-drawer" id="wizDrawer" data-wiz-drawer hidden role="dialog" aria-modal="true" aria-labelledby="wizDrawerTitle">
    <button type="button" class="wiz-icon-btn wiz-modal-close" data-wiz-drawer-close aria-label="Close booking panel" data-i18n="wiz.closeBooking" data-i18n-attr="aria-label" data-i18n-attr-only>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <header class="wiz-drawer-head">
        <div>
            <p class="wiz-drawer-kicker" data-i18n="wiz.drawerKicker">Mori International</p>
            <h2 id="wizDrawerTitle" data-wiz-drawer-title data-i18n="wiz.yourBooking">Your Booking</h2>
        </div>
        </header>
    <div class="wiz-drawer-body">
        <div data-wiz-drawer-step="summary">
            <div class="wiz-stay-strip" data-wiz-stay-strip></div>
            <p class="wiz-kicker" style="margin-bottom:0.75rem;" data-i18n="wiz.selectedRooms">Selected Rooms</p>
            <div data-wiz-drawer-lines></div>
            <div class="wiz-total" data-wiz-total></div>
            <p class="wiz-need-rooms" id="wizNeedRoomsAlert" data-wiz-drawer-rooms-alert hidden role="alert"></p>
            <button type="button" class="wiz-btn wiz-btn-primary" data-wiz-enter-details style="width:100%;">
                <span data-i18n="wiz.enterGuestDetails">Enter Guest Details</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <p class="wiz-hint" data-i18n="wiz.noPayHint">No payment collected now · Check-in 2:00 PM · Check-out 12:00 NN</p>
</div>

        <form data-wiz-drawer-step="form" hidden novalidate>
            <div class="wiz-who">
                <p data-i18n="wiz.whoBooking">Who is this booking for?</p>
                <div class="wiz-toggle" role="radiogroup" aria-label="Booking for" data-i18n="wiz.bookingForAria" data-i18n-attr="aria-label">
                    <button type="button" class="is-on" data-wiz-for="myself" role="radio" aria-checked="true" data-i18n="wiz.forMyself">Booking for myself</button>
                    <button type="button" data-wiz-for="someone" role="radio" aria-checked="false" data-i18n="wiz.forSomeone">For someone else</button>
                </div>
            </div>

            <fieldset class="wiz-fieldset">
                <legend><span class="wiz-num">1</span> <span data-wiz-details-legend data-i18n="wiz.yourDetails">Your Details</span></legend>
                <div class="wiz-form-grid">
                    <div class="wiz-field" data-wiz-field="firstName">
                        <label class="wiz-label-plain" for="wizFirstName"><span data-i18n="wiz.firstName">First Name</span> <span class="wiz-req">*</span></label>
                        <input id="wizFirstName" name="firstName" type="text" autocomplete="given-name" data-mori-filter="person-name" maxlength="60" />
                        <span class="wiz-field-error" data-wiz-error="firstName" role="alert"></span>
            </div>
                    <div class="wiz-field" data-wiz-field="lastName">
                        <label class="wiz-label-plain" for="wizLastName"><span data-i18n="wiz.lastName">Last Name</span> <span class="wiz-req">*</span></label>
                        <input id="wizLastName" name="lastName" type="text" autocomplete="family-name" data-mori-filter="person-name" maxlength="60" />
                        <span class="wiz-field-error" data-wiz-error="lastName" role="alert"></span>
                </div>
                    <div class="wiz-field wiz-span" data-wiz-field="email">
                        <label class="wiz-label-plain" for="wizEmail"><span data-i18n="wiz.email">Email Address</span> <span class="wiz-req">*</span></label>
                        <input id="wizEmail" name="email" type="email" autocomplete="email" data-mori-filter="email" maxlength="254" />
                        <span class="wiz-hint-field" data-i18n="wiz.emailHint">Confirmation will be sent here</span>
                        <span class="wiz-field-error" data-wiz-error="email" role="alert"></span>
                    </div>
                    <div class="wiz-field wiz-span" data-wiz-field="phone">
                        <label class="wiz-label-plain" for="wizPhone"><span data-i18n="wiz.phone">Phone Number</span> <span class="wiz-req">*</span></label>
                        <input id="wizPhone" name="phone" type="tel" autocomplete="tel" data-mori-filter="phone" maxlength="40" placeholder="+63 917 000 0000" />
                        <span class="wiz-field-error" data-wiz-error="phone" role="alert"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="wiz-fieldset" data-wiz-guest-block hidden>
                <legend><span class="wiz-num">2</span> <span data-i18n="wiz.guestDetailsLegend">Guest's Details</span></legend>
                <div class="wiz-guest-box">
                    <div class="wiz-field" data-wiz-field="guestFirst">
                        <label class="wiz-label-plain" for="wizGuestFirst"><span data-i18n="wiz.guestFirst">Guest First Name</span> <span class="wiz-req">*</span></label>
                        <input id="wizGuestFirst" name="guestFirst" type="text" data-mori-filter="person-name" maxlength="60" />
                        <span class="wiz-field-error" data-wiz-error="guestFirst" role="alert"></span>
            </div>
                    <div class="wiz-field" data-wiz-field="guestLast">
                        <label class="wiz-label-plain" for="wizGuestLast"><span data-i18n="wiz.guestLast">Guest Last Name</span> <span class="wiz-req">*</span></label>
                        <input id="wizGuestLast" name="guestLast" type="text" data-mori-filter="person-name" maxlength="60" />
                        <span class="wiz-field-error" data-wiz-error="guestLast" role="alert"></span>
    </div>
                    <div class="wiz-field wiz-span" data-wiz-field="guestEmail">
                        <label class="wiz-label-plain" for="wizGuestEmail"><span data-i18n="wiz.guestEmail">Guest Email</span> <span class="wiz-req">*</span></label>
                        <input id="wizGuestEmail" name="guestEmail" type="email" data-mori-filter="email" maxlength="254" />
                        <span class="wiz-hint-field" data-i18n="wiz.guestEmailHint">Guest receives stay confirmation</span>
                        <span class="wiz-field-error" data-wiz-error="guestEmail" role="alert"></span>
                    </div>
                    <div class="wiz-field wiz-span" data-wiz-field="guestPhone">
                        <label class="wiz-label-plain" for="wizGuestPhone" data-i18n="wiz.guestPhone">Guest Phone</label>
                        <input id="wizGuestPhone" name="guestPhone" type="tel" data-mori-filter="phone" maxlength="40" />
                    </div>
                </div>
            </fieldset>

            <div class="wiz-actions">
                <button type="button" class="wiz-btn wiz-btn-ghost" data-wiz-form-back data-i18n="wiz.back">← Back</button>
                <button type="submit" class="wiz-btn wiz-btn-primary" data-wiz-to-review style="flex:1;">
                    <span data-i18n="wiz.continueReview">Continue — Review stay</span>
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
            <p class="wiz-form-alert" data-wiz-form-alert hidden role="alert"></p>
        </form>

        <div data-wiz-drawer-step="review" hidden>
            <p class="wiz-lead-hint" data-wiz-lead-hint></p>
            <p class="wiz-kicker" data-i18n="wiz.priceBreakdown">Price breakdown</p>
            <div class="wiz-breakdown" data-wiz-breakdown></div>
            <p class="wiz-offer-cash" data-wiz-cash-note hidden></p>

            <fieldset class="wiz-fieldset wiz-arrival">
                <legend><span class="wiz-num">1</span> <span data-i18n="wiz.arrivalDiscount">Senior Citizen &amp; PWD</span></legend>
                <div class="wiz-radios" role="radiogroup" aria-labelledby="wizArrivalLegend">
                    <p id="wizArrivalLegend" class="visually-hidden" data-i18n="wiz.arrivalDiscountAria">Arrival discount request</p>
                    <label class="wiz-radio">
                        <input type="radio" name="wizArrivalDiscount" value="None" checked />
                        <span data-i18n="wiz.noArrivalDiscount">No arrival discount</span>
                    </label>
                    <label class="wiz-radio">
                        <input type="radio" name="wizArrivalDiscount" value="SeniorCitizen" />
                        <span data-i18n="wiz.seniorArrival">Senior Citizen (20% at arrival)</span>
                    </label>
                    <label class="wiz-radio">
                        <input type="radio" name="wizArrivalDiscount" value="Pwd" />
                        <span data-i18n="wiz.pwdArrival">PWD (20% at arrival)</span>
                    </label>
                </div>
                <p class="wiz-hint-field" data-wiz-arrival-hint></p>
            </fieldset>

            <section class="wiz-policy-box" aria-labelledby="wizCancelTitle">
                <h3 id="wizCancelTitle" data-i18n="wiz.cancellation">Cancellation</h3>
                <p data-i18n="wiz.cancellationBody">Cancellation and prepayment policies vary according to booking. If you need to change or cancel, contact the hotel and we will confirm any charges or refunds in writing when we can.</p>
                <p><a asp-controller="Booking" asp-action="Terms" target="_blank" rel="noopener" data-i18n="wiz.readTerms">Read the full Terms of Stay</a></p>
            </section>

            <section class="wiz-policy-box" aria-labelledby="wizStayAgreeTitle">
                <h3 id="wizStayAgreeTitle" data-i18n="wiz.stayAgreement">Stay agreement</h3>
                <ul>
                    <li data-i18n="wiz.stayRule1">Check-in 14:00 · check-out 12:00 (Manila). Early check-in and late checkout may be offered for a fee.</li>
                    <li data-i18n="wiz.stayRule2">Each room includes two guests. A third guest is ₱200 per night, subject to room capacity.</li>
                    <li data-i18n="wiz.stayRule3">Senior Citizen and PWD discounts are claimed at arrival with valid ID. They are not applied online.</li>
                </ul>
            </section>

            <div class="wiz-consent-stack">
                <label class="wiz-check" for="wizConsentOffers">
                    <input type="checkbox" id="wizConsentOffers" name="consentOffers" />
                    <span data-i18n="wiz.consentOffers">I give my Consent to receive news and information about special offers</span>
                </label>
                <div class="wiz-consent" data-wiz-field="consentData">
                    <label class="wiz-check" for="wizConsentData">
                        <input type="checkbox" id="wizConsentData" name="consentData" />
                        <span>
                            <span data-i18n="wiz.consentDataBefore">I give my Consent to personal data processing and confirm that I have read the </span>
                            <a asp-controller="Booking" asp-action="Terms" target="_blank" rel="noopener" data-i18n="wiz.termsLink">Terms and policies</a>
                            <span data-i18n="wiz.consentDataMid"> and the </span>
                            <a asp-controller="Booking" asp-action="PrivacyPolicy" target="_blank" rel="noopener" data-i18n="wiz.privacyLink">Privacy policy</a>
                            <span class="wiz-req">*</span>
                    </span>
                    </label>
                    <span class="wiz-field-error" data-wiz-error="consentData" role="alert"></span>
                </div>
            </div>

            <div class="wiz-actions">
                <button type="button" class="wiz-btn wiz-btn-ghost" data-wiz-review-back data-i18n="wiz.back">← Back</button>
                <button type="button" class="wiz-btn wiz-btn-primary" data-wiz-submit disabled aria-disabled="true" style="flex:1;" data-i18n="wiz.confirmReservation">Confirm Reservation</button>
    </div>
            <p class="wiz-form-alert" data-wiz-review-alert hidden role="alert"></p>
</div>

        <div class="wiz-confirm" data-wiz-drawer-step="confirm" hidden>
            <div class="wiz-confirm-mark" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M5 14l6 6 12-12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p class="wiz-kicker" data-wiz-confirm-kicker data-i18n="wiz.bookingConfirmed">Booking Confirmed</p>
            <h3 data-wiz-confirm-title></h3>
            <p class="wiz-lede" data-wiz-confirm-copy></p>
            <div class="wiz-rows" data-wiz-confirm-rows></div>
            <button type="button" class="wiz-btn wiz-btn-primary" data-wiz-done style="width:100%;" data-i18n="wiz.done">Done</button>
        </div>
    </div>
</aside>

<div class="wiz-far-checkin-back" data-wiz-far-checkin-back hidden></div>
<div class="wiz-far-checkin-dlg" data-wiz-far-checkin-sheet hidden role="dialog" aria-modal="true" aria-labelledby="wizFarCheckInTitle">
    <header class="wiz-sheet-head">
        <div>
            <p class="wiz-kicker" style="margin:0 0 0.2rem;" data-i18n="wiz.farCheckInKicker">Date check</p>
