@model TestingDemo.ViewModels.BookingPageViewModel
@{
    var showLogin = !Model.GoogleGuestSignedIn && Model.GoogleLoginEnabled;
}
<aside class="guest-loyalty-ad"
       data-loyalty-banner
       hidden
       aria-label="Loyalty Coupon"
       data-i18n="loyalty.aria"
       data-i18n-attr="aria-label"
       aria-live="polite">
    <button type="button"
            class="guest-loyalty-ad-close"
            data-loyalty-dismiss
            aria-label="Dismiss offer"
            data-i18n="loyalty.dismiss"
            data-i18n-attr="aria-label"
            data-i18n-attr-only>
        <span aria-hidden="true">&times;</span>
    </button>
    <span class="guest-loyalty-ad-seal" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="6" />
            <path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12" />
        </svg>
    </span>
    <div class="guest-loyalty-ad-face">
        <p class="guest-loyalty-ad-issuer" data-i18n="loyalty.issuer">Mori International Hotel</p>
        <p class="guest-loyalty-ad-kicker" data-i18n="loyalty.kicker">Loyalty Coupon</p>
        <p class="guest-loyalty-ad-amount" data-loyalty-amount>−₱0.00</p>
        <p class="guest-loyalty-ad-when" data-loyalty-when></p>
        <p class="guest-loyalty-title" data-loyalty-title data-i18n="loyalty.title">
            A guest offer for your next stay
        </p>
    </div>
    <div class="guest-loyalty-ad-perf" aria-hidden="true"></div>
    <div class="guest-loyalty-ad-stub">
        @if (showLogin)
        {
            <form id="guestLoyaltyGoogleForm"
                  asp-controller="Account"
                  asp-action="ExternalLogin"
                  method="post"
                  class="guest-loyalty-form"
                  data-loyalty-google-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Accommodations", "Booking")" />
                <input type="hidden" name="rememberMe" value="true" />
                <button type="submit" class="guest-btn guest-btn-primary guest-loyalty-login" data-loyalty-login data-i18n="loyalty.claim">
                    Claim offer
                </button>
            </form>
        }
        else
        {
            <p class="guest-loyalty-ad-claim" data-loyalty-claim data-i18n="loyalty.ready">Ready on your stay</p>
        }
    </div>
</aside>
