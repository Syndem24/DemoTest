        </div>
        <div class="guest-contact-map">
            <iframe
                title="Mori International Hotel location on AS Fortuna, Mandaue City, Cebu"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                src="https://maps.google.com/maps?q=Moriyama+Hotel%4010.3388879%2C123.9281139&ll=10.3388879%2C123.9281139&z=17&output=embed">
            </iframe>
        </div>
    </div>
</section>

@if (Model.ReviewCount > 0)
{
    <div class="guest-reviews-modal" data-reviews-modal hidden>
        <button type="button" class="guest-reviews-modal-backdrop" data-reviews-modal-close aria-label="Close all reviews"></button>
        <section class="guest-reviews-modal-card" role="dialog" aria-modal="true" aria-labelledby="allReviewsTitle">
            <header class="guest-reviews-modal-head">
                <div>
                    <p class="guest-eyebrow">Guest voices</p>
                    <h3 id="allReviewsTitle">All verified reviews</h3>
                    <p>Read more guest feedback from completed stays at Mori International Hotel.</p>
                </div>
                <button type="button" class="guest-reviews-modal-close" data-reviews-modal-close aria-label="Close all reviews">×</button>
            </header>

            <div class="guest-reviews-modal-summary">
                <strong>@Model.ReviewAverage.ToString("0.0")/5</strong>
                <span>@Model.ReviewCount @(Model.ReviewCount == 1 ? "verified review" : "verified reviews")</span>
            </div>

            <div class="guest-reviews-modal-body" data-reviews-modal-list>
                <p class="guest-reviews-empty">Loading reviews…</p>
            </div>
        </section>
    </div>
}
