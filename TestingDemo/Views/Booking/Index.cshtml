@model TestingDemo.ViewModels.BookingPageViewModel
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Mori International Hotel";
    ViewData["GuestImmersive"] = true;
    var galleryJsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
    var buildingsPhotos = new[]
    {
        new { Src = "/Images/Buildings/Building1.jpg", Alt = "Wide daytime view of Mori International Hotel and guest parking" },
        new { Src = "/Images/Buildings/Building2.jpg", Alt = "Front entrance of Mori International Hotel in the evening" },
        new { Src = "/Images/Buildings/Building3.jpg", Alt = "Front façade and entrance of Mori International Hotel" }
    };
    var hallwaysPhotos = new[]
    {
        new { Src = "/Images/Hallways/Hallway1.jpg", Alt = "Illuminated hotel entrance and inner hallway at night" },
        new { Src = "/Images/Hallways/Hallway3.jpg", Alt = "Upper guest corridor with stairs and indoor palms" },
        new { Src = "/Images/Hallways/Hallway4.jpg", Alt = "Ground-floor hallway with palms and guest room entrances" },
        new { Src = "/Images/Hallways/Hallway5.jpg", Alt = "Open guest corridor overlooking the hotel entrance" }
    };
    var loungePhotos = new[]
    {
        new { Src = "/Images/Hallways/Hallway2.jpg", Alt = "Bright shared courtyard lounge with greenery and seating" },
        new { Src = "/Images/Lounge/Lounge1.jpg", Alt = "Quiet guest lounge with seating and artwork" }
    };
    var receptionPhotos = new[]
    {
        new { Src = "/Images/ReceptionArea/Reception1.jpg", Alt = "Mori International Hotel reception desk framed by indoor plants" }
    };
    var buildingsJson = System.Text.Json.JsonSerializer.Serialize(buildingsPhotos, galleryJsonOptions);
    var hallwaysJson = System.Text.Json.JsonSerializer.Serialize(hallwaysPhotos, galleryJsonOptions);
    var loungeJson = System.Text.Json.JsonSerializer.Serialize(loungePhotos, galleryJsonOptions);
    var receptionJson = System.Text.Json.JsonSerializer.Serialize(receptionPhotos, galleryJsonOptions);
    var galleryWallTiles = new[]
    {
        new { Slot = "a5-left", Label = "Hallways", ItemsJson = hallwaysJson, Photo = hallwaysPhotos[2], Count = hallwaysPhotos.Length },
        new { Slot = "a5-mid", Label = "Reception", ItemsJson = receptionJson, Photo = receptionPhotos[0], Count = receptionPhotos.Length },
        new { Slot = "a4", Label = "Lounge", ItemsJson = loungeJson, Photo = loungePhotos[0], Count = loungePhotos.Length },
        new { Slot = "a3", Label = "Buildings", ItemsJson = buildingsJson, Photo = buildingsPhotos[0], Count = buildingsPhotos.Length }
    };
}

@{
    var landingHeroTour = new[]
    {
        new { Src = "/Images/Buildings/Building1.jpg", Position = "54% 46%" },
        new { Src = "/Images/Hallways/Hallway4.jpg", Position = "50% 42%" },
        new { Src = "/Images/Lounge/Lounge1.jpg", Position = "50% 52%" },
        new { Src = "/Images/Rooms/Room1.jpg", Position = "42% 48%" }
    };
}

<section class="guest-hero guest-hero-book guest-hero-immersive" id="guestHero">
    <div class="guest-hero-media guest-hero-tour"
         data-hero-tour
         data-hero-tour-duration="12000"
         aria-hidden="true">
        @for (var i = 0; i < landingHeroTour.Length; i++)
        {
            var slide = landingHeroTour[i];
            <img src="@slide.Src"
                 asp-append-version="true"
                 alt=""
                 decoding="async"
                 fetchpriority="@(i == 0 ? "high" : "low")"
                 loading="@(i < 3 ? "eager" : "lazy")"
                 class="@(i == 0 ? "is-active is-drifting" : null)"
                 style="--hero-tour-position: @slide.Position"
                 data-hero-tour-slide />
        }
    </div>
    <div class="guest-hero-copy" id="guestHeroCopy">
        <p class="guest-brand-mark guest-typewriter" id="heroBrandType" data-typewriter data-i18n="nav.brand" data-i18n-attr="aria-label" aria-label="Mori International Hotel">Mori International Hotel</p>
        <h1 class="guest-typewriter" id="heroTitleType" data-typewriter data-i18n="home.heroTitle" data-i18n-attr="aria-label" aria-label="Stay close to everything in Cebu.">Stay close to everything in Cebu.</h1>
        <div class="guest-hero-reveal">
            <p class="guest-hero-lede" data-i18n="home.heroLede">
                Clean rooms, easy parking, and a simple way to book your stay.
            </p>
            <div class="guest-hero-actions">
                <a class="guest-btn guest-btn-primary"
                   asp-controller="Booking"
                   asp-action="Accommodations"
                   data-i18n="home.viewAccommodations">
                    View accommodations
                </a>
                <a class="guest-btn guest-btn-ghost" href="#gallery" data-i18n="home.exploreHotel">Explore the hotel</a>
            </div>
        </div>
    </div>
    <a class="guest-hero-scroll" id="guestHeroScroll" href="#about" aria-label="Scroll to content" data-i18n="home.scrollContent" data-i18n-attr="aria-label" data-i18n-attr-only hidden>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
    </a>
    <div class="guest-hero-sentinel" id="guestHeroSentinel" aria-hidden="true"></div>
</section>

<section class="guest-section guest-intro" id="about">
    <div class="guest-intro-frame">
        <p class="guest-intro-kana guest-reveal" data-reveal aria-hidden="true">森</p>
        <div class="guest-intro-copy guest-reveal" data-reveal>
            <p class="guest-eyebrow" data-i18n="home.eyebrowWhere">Mandaue, Cebu</p>
            <h2 data-i18n="home.introTitle">A quiet stay with a Japanese spirit</h2>
            <p class="guest-intro-lede" data-i18n="home.introLede">
                Welcome to Mori International Hotel — where traditional Japanese calm meets contemporary comfort.
            </p>
        </div>

        <div class="guest-intro-story">
            <figure class="guest-intro-media guest-reveal" data-reveal>
                <img src="~/Images/Hallways/Hallway2.jpg"
                     asp-append-version="true"
                     alt="Bright inner courtyard and guest floors at Mori International Hotel"
                     loading="lazy" />
                <figcaption>
                    <span data-i18n="home.insideMori">Inside Mori</span>
                    <strong data-i18n="home.insideMoriStrong">Light, greenery, and quiet spaces</strong>
                </figcaption>
            </figure>
            <div class="guest-intro-body guest-reveal" data-reveal>
                <p data-i18n="home.introP1">
                    Our property features a pioneering modular design with 19 cozy rooms of about 18 square meters,
                    each with inverter air conditioning, 24-hour hot and cold showers, complimentary drinking water,
                    unlimited Wi-Fi, and ample parking.
                </p>
                <p data-i18n="home.introP2">
                    Just 6 kilometers from the airport and 4 kilometers from Cebu City’s major seaports,
                    you are close to restaurants, shops, and everyday conveniences — without losing the sense of rest.
                </p>
                <p class="guest-intro-note" data-i18n="home.introNote">
                    Book ahead and your room is held as a reservation. Arriving within the minimum lead time?
                    It stays a standard booking.
                </p>
                <a class="guest-btn guest-btn-primary"
                   asp-controller="Booking"
                   asp-action="Accommodations"
                   data-i18n="home.browseRooms">
                    Browse rooms
                </a>
            </div>
        </div>
    </div>
</section>

<section class="guest-section guest-gallery" id="gallery">
    <div class="guest-section-head guest-reveal" data-reveal>
        <div>
            <p class="guest-eyebrow" data-i18n="home.galleryEyebrow">A closer look</p>
            <h2 data-i18n="home.galleryTitle">Inside Mori</h2>
            <p class="guest-section-copy" data-i18n="home.galleryCopy">
                Buildings, Hallways, Lounge, and Reception — tap a frame to browse that album.
            </p>
        </div>
        <a class="guest-gallery-all-rooms"
           asp-controller="Booking"
           asp-action="Accommodations">
            <span data-i18n="home.viewAllAccommodations">View all accommodations</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
    </div>

    <div class="guest-gallery-wall guest-reveal" data-reveal aria-label="Hotel photo gallery wall">
        @foreach (var tile in galleryWallTiles)
        {
            <figure class="guest-gallery-wall-tile is-@tile.Slot">
                <button type="button"
                        class="guest-gallery-wall-photo"
                        data-photo-zoom
                        data-photo-zoom-items='@Html.Raw(tile.ItemsJson)'
                        data-photo-zoom-src="@tile.Photo.Src"
                        data-photo-zoom-alt="@tile.Photo.Alt"
                        aria-label="Open @tile.Label gallery starting with @tile.Photo.Alt">
                    <img src="@tile.Photo.Src"
                         alt="@tile.Photo.Alt"
                         loading="lazy"
                         decoding="async" />
                    <span class="guest-gallery-wall-caption">
                        <span class="guest-gallery-caption" data-i18n="home.gallery@(tile.Label)">@tile.Label</span>
                        <strong data-i18n-photo-count="@tile.Count">@tile.Count photo@(tile.Count == 1 ? "" : "s")</strong>
                    </span>
                </button>
            </figure>
        }
    </div>

    @if (Model.RoomTypes.Any())
    {
        <div class="guest-gallery-rooms">
            <div class="guest-gallery-rooms-head guest-reveal" data-reveal>
                <div>
                    <p class="guest-eyebrow" data-i18n="home.chooseStay">Choose your stay</p>
                    <h3 data-i18n="home.ourRoomTypes">Our room types</h3>
                </div>
                    <p data-i18n="home.browseRoomTypes">Browse our room types — open a room to see availability and book.</p>
            </div>

            <div class="guest-room-carousel guest-gallery-room-carousel"
                 data-room-carousel
                 data-carousel-page-size="3"
                 aria-label="Available room types">
                <button type="button"
                        class="guest-room-carousel-nav is-prev"
                        data-room-carousel-prev
                        aria-label="Show previous room types">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>

                <div class="guest-gallery-room-track guest-room-track"
                     data-room-carousel-track
                     tabindex="0"
                     aria-label="Room types. Use the left and right arrow keys to browse.">
                    @foreach (var roomType in Model.RoomTypes)
                    {
                        var roomImage = roomType.Images.FirstOrDefault();
                        var roomImageSrc = string.IsNullOrWhiteSpace(roomImage)
                            ? "/Images/NIghtPicIm.jpg"
                            : roomImage;

                        <a class="guest-gallery-room guest-reveal"
                           data-reveal
                           asp-controller="Booking"
                           asp-action="Accommodations"
                           asp-fragment="rooms"
                           aria-label="View @roomType.Name accommodation">
                            <img src="@roomImageSrc"
                                 alt="@roomType.Name guest room"
                                 loading="lazy" />
                            <span class="guest-gallery-room-overlay">
                                <span class="guest-gallery-caption" data-i18n="home.roomType">Room type</span>
                                <strong>@roomType.Name</strong>
                                <span class="guest-gallery-room-link">
                                    <span data-i18n="home.viewRoom">View room</span>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                                </span>
                            </span>
                        </a>
                    }
                </div>

                <button type="button"
                        class="guest-room-carousel-nav is-next"
                        data-room-carousel-next
                        aria-label="Show next room types">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>
    }
</section>

<section class="guest-section guest-contact" id="contact">
    <div class="guest-section-head guest-reveal" data-reveal>
        <div>
            <p class="guest-eyebrow" data-i18n="home.contactEyebrow">Get in touch</p>
            <h2 data-i18n="home.contactTitle">Contact Us</h2>
            <p class="guest-section-copy" data-i18n="home.contactCopy">Mori International Hotel, Cebu</p>
        </div>
    </div>

    <div class="guest-contact-layout guest-reveal" data-reveal>
        <div class="guest-contact-main">
            <p class="guest-contact-address">
                MCity Properties Building, AS Fortuna, Mandaue City, Cebu
            </p>

            <ul class="guest-contact-list">
                <li>
                    <a href="tel:+639604417525">+63 960 441 7525</a>
                    <span data-i18n="home.staff247">24/7 Hotel Staff</span>
                </li>
                <li>
                    <a href="tel:+63322388855">(032) 238 8855</a>
                    <span data-i18n="home.hotelPhone">Hotel Phone Number</span>
                </li>
                <li>
                    <a href="mailto:moriyamahotel@gmail.com">moriyamahotel&#64;gmail.com</a>
                    <span data-i18n="home.hotelEmail">Hotel Official email</span>
                </li>
            </ul>

            <div class="guest-contact-cta">
                <p data-i18n="home.contactCta">
                    Always busy? No time for calls? You wish to book a room in the soonest possible time
                    and make sure the room will be ready for you by the time you arrive? We recommend that
                    you use our online booking with best available prices!
                </p>
                <a class="guest-btn guest-btn-primary"
                   asp-controller="Booking"
                   asp-action="Accommodations"
                   data-i18n="home.bookNow">
                    Book now
                </a>
            </div>
        </div>

        <div class="guest-contact-location">
            <h3 data-i18n="home.locationTitle">Location and directions</h3>
            <p class="guest-contact-address">
                MCity Properties, AS Fortuna Street, Mandaue City, Cebu
            </p>
            <p data-i18n="home.locationBody">
                The hotel's convenient location, approximately 700 meters from SM Jmall and just a mere
                four-minute drive from Oakridge Business Park, makes it an ideal choice for business
                travelers and tourists alike. Its close proximity to these key destinations allows for
                easy access to shopping, dining, and commercial activities in the area.
            </p>
            <div class="guest-contact-map">
                <iframe
                    title="Mori International Hotel location on AS Fortuna, Mandaue City, Cebu"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    src="https://maps.google.com/maps?q=Moriyama+Hotel%4010.3388879%2C123.9281139&ll=10.3388879%2C123.9281139&z=17&output=embed">
                </iframe>
            </div>
            <div class="guest-contact-map-meta">
                <div>
                    <strong>Mori International Hotel, Mandaue City, Cebu</strong>
                    <span>MCity Properties Building, AS Fortuna, Mandaue City, Cebu</span>
                </div>
            </div>
        </div>
    </div>
</section>
