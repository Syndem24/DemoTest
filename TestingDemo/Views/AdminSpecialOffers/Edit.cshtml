@model TestingDemo.DTOs.UpsertSpecialOfferRequest
@{
    ViewData["Title"] = "Edit special offer";
    var pricesJson = ViewBag.RoomTypePricesJson as string ?? "{}";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/hotel-toast.js" asp-append-version="true"></script>
    <script src="~/js/admin-special-offer-form.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const serverErrors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ViewData["OfferValidationToasts"] as IReadOnlyList<string> ?? Array.Empty<string>()));
            initOfferPricingForm(
                document.getElementById('editOfferForm'),
                @Html.Raw(pricesJson)
            );
            initOfferValidationToasts('editOfferForm', serverErrors);
        });
    </script>
}

<div class="admin-offers-page">
<section class="admin-offers-hero">
    <div>
        <p class="admin-offers-eyebrow">Special offers</p>
        <h1>Edit offer</h1>
        <p class="admin-offers-lede">Set rooms, discount, and schedule.</p>
    </div>
    <a class="admin-offers-back" asp-action="Index">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 18l-6-6 6-6" />
        </svg>
        <span>Back to list</span>
    </a>
</section>

<div class="admin-offers-form-panel">
    <form asp-action="Edit" method="post" class="admin-offers-form" id="editOfferForm">
        @Html.AntiForgeryToken()
        <partial name="_OfferForm" model="Model" />
        <div class="admin-offers-form-actions">
            <button type="submit" class="admin-offers-btn-primary">Save changes</button>
            @if (ViewBag.CanReactivate is bool canReactivate && canReactivate)
            {
                <button type="submit" class="admin-offers-btn-primary" name="intent" value="reactivate">
                    Reactivate now
                </button>
            }
            <a class="admin-offers-btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
</div>
