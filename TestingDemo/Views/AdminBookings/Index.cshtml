@{
    ViewData["Title"] = "Bookings";
}

<section class="hotel-page-hero">
    <div>
        <p class="hero-eyebrow">Guest requests</p>
        <h1>Bookings</h1>
        <p>Review requests in a compact table or scan upcoming reservations on the calendar.</p>
    </div>
</section>

<section class="hotel-panel admin-bookings-panel" data-admin-bookings>
    @Html.AntiForgeryToken()

    <div class="admin-booking-view-tabs" role="tablist" aria-label="Booking views">
        <button type="button" class="is-active" role="tab" aria-selected="true" data-booking-view="table">
            Booking table
        </button>
        <button type="button" role="tab" aria-selected="false" data-booking-view="calendar">
            Booking calendar
        </button>
        <button type="button" role="tab" aria-selected="false" data-booking-view="history">
            History
        </button>
    </div>

    <div data-booking-table-panel>
        <div class="admin-arrivals-panel" data-arrivals-panel hidden>
            <div class="admin-arrivals-head">
                <div>
                    <strong>Arriving soon</strong>
                    <p>Confirmed guests with check-in in the next 20 minutes (Philippines time).</p>
                </div>
                <button type="button" class="admin-booking-refresh" data-arrivals-close>Back to bookings</button>
            </div>
            <div class="admin-arrivals-list" data-arrivals-list>
                <p class="admin-bookings-loading">Loading arrivals…</p>
            </div>
        </div>

        <div class="admin-arrivals-panel" data-pending-calls-panel hidden>
            <div class="admin-arrivals-head">
                <div>
                    <strong>Call guests soon</strong>
                    <p>Pending bookings with check-in in the next 20 minutes — call to verify, then Confirm &amp; continue setup.</p>
                </div>
                <button type="button" class="admin-booking-refresh" data-pending-calls-close>Back to bookings</button>
            </div>
            <div class="admin-arrivals-list" data-pending-calls-list>
                <p class="admin-bookings-loading">Loading pending calls…</p>
            </div>
        </div>

        <div class="admin-arrivals-panel" data-checkouts-panel hidden>
            <div class="admin-arrivals-head">
                <div>
                    <strong>Checkout soon</strong>
                    <p>Confirmed stays with checkout in the next 20 minutes — call to ask if they will extend for late checkout.</p>
                </div>
                <button type="button" class="admin-booking-refresh" data-checkouts-close>Back to bookings</button>
            </div>
            <div class="admin-arrivals-list" data-checkouts-list>
                <p class="admin-bookings-loading">Loading checkouts…</p>
            </div>
        </div>

        <div class="admin-bookings-toolbar">
            <div class="admin-booking-filters" role="group" aria-label="Filter bookings">
                <button type="button" class="admin-booking-filter is-active" data-booking-filter="">All</button>
                <button type="button" class="admin-booking-filter" data-booking-filter="Pending">Pending</button>
                <button type="button" class="admin-booking-filter" data-booking-filter="Confirmed">Confirmed</button>
            </div>
            <label class="admin-booking-search">
                <span class="visually-hidden">Search bookings</span>
                <input type="search" placeholder="Search reference or guest…" data-booking-search />
            </label>
            <button type="button" class="guest-btn guest-btn-primary admin-walkin-open-btn" data-walkin-open>
                Walk-in
            </button>
            <button type="button" class="admin-booking-refresh admin-payment-flush-btn" data-history-flush hidden>
                Export history to PDF
            </button>
            <button type="button" class="admin-booking-refresh" data-booking-refresh>Refresh</button>
        </div>

        <div class="admin-payment-flush-log" data-history-flush-log hidden>
            <button
                type="button"
                class="admin-payment-flush-toggle"
                data-history-flush-toggle
                aria-expanded="false"
                aria-controls="historyFlushLogPanel">
                <span class="admin-payment-flush-toggle-label">
                    <strong>History export log</strong>
                    <span data-history-flush-count>Closed · audit of PDF exports &amp; deletes</span>
                </span>
                <span class="admin-payment-flush-chevron" aria-hidden="true"></span>
            </button>
            <div id="historyFlushLogPanel" class="admin-payment-flush-log-body" data-history-flush-body hidden>
                <p class="admin-payment-flush-log-hint">
                    Archived bookings are hard-deleted after data export. Export logs auto-clear after 7 days.
                </p>
                <div class="admin-payment-flush-table-wrap">
                    <table class="admin-bookings-table admin-payment-flush-table">
                        <thead>
                            <tr>
                                <th>When (PH)</th>
                                <th>Staff</th>
                                <th>Records</th>
                                <th>PDF file</th>
                                <th>Expires</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody data-history-flush-log-list>
                            <tr><td colspan="6" class="admin-bookings-loading">No export actions yet.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <p class="admin-bookings-message" data-bookings-message role="status" hidden></p>

        <div class="admin-bookings-table-wrap">
            <table class="admin-bookings-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Guest</th>
                        <th>Stay</th>
                        <th>Rooms</th>
                        <th>Type</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody data-bookings-list aria-live="polite">
                    <tr><td colspan="8" class="admin-bookings-loading">Loading bookings…</td></tr>
                </tbody>
            </table>
        </div>

        <nav class="admin-bookings-pagination" aria-label="Booking pages">
            <button type="button" data-bookings-prev disabled>Previous</button>
            <span data-bookings-page>Page 1</span>
            <button type="button" data-bookings-next disabled>Next</button>
        </nav>
    </div>

    <div class="admin-reservation-calendar-panel" data-booking-calendar-panel hidden>
        <div class="admin-calendar-intro">
            <div>
                <strong>Booking calendar</strong>
                <p>Shows pending and confirmed stays for the visible range.</p>
            </div>
            <div class="admin-calendar-legend" aria-label="Status legend">
                <span class="is-full">Booking</span>
                <span class="is-half">Reservation</span>
            </div>
        </div>
        <div class="admin-reservation-calendar" data-reservation-calendar></div>
        <p class="admin-calendar-fallback" data-calendar-fallback hidden>
            The calendar could not load. Use the booking table instead.
        </p>
    </div>
</section>

<div class="admin-booking-modal" data-booking-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-booking-modal-close aria-label="Close details"></button>
    <section class="admin-booking-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="adminBookingDetailTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-detail-reference></span>
                <h2 id="adminBookingDetailTitle" data-detail-guest>Booking details</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-booking-modal-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body" data-booking-detail>
            <p>Loading details…</p>
        </div>
        <footer class="admin-booking-detail-actions" data-booking-detail-actions></footer>
        <div class="admin-fees-saved-popup" data-fees-saved-popup hidden>
            <div class="admin-fees-saved-popup-card" role="alertdialog" aria-modal="true" aria-labelledby="feesSavedPopupTitle">
                <h3 id="feesSavedPopupTitle">Additional fees</h3>
                <ul class="admin-fees-saved-list" data-fees-saved-list></ul>
                <p class="admin-fees-saved-empty" data-fees-saved-empty hidden>No additional fees on this booking.</p>
                <button type="button" class="admin-booking-confirm" data-fees-saved-ok>OK</button>
            </div>
        </div>
    </section>
</div>

<div class="admin-booking-modal" data-history-flush-detail-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-history-flush-detail-close aria-label="Close export details"></button>
    <section class="admin-booking-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="historyFlushDetailTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-flush-detail-file></span>
                <h2 id="historyFlushDetailTitle">Export details</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-history-flush-detail-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body" data-flush-detail-body>
            <p>Select an export log row to view details.</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-history-flush-detail-close>Close</button>
        </footer>
    </section>
</div>

<div class="admin-booking-modal" data-payment-view-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payment-view-close aria-label="Close payment record"></button>
    <section class="admin-booking-modal-dialog admin-payment-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentViewTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-payment-view-ref></span>
                <h2 id="paymentViewTitle">Payment record</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payment-view-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body admin-payment-modal-body">
            <p class="admin-payment-guest-line" data-payment-view-guest>Guest</p>
            <dl class="admin-flush-detail-grid" data-payment-view-summary></dl>
            <h3 class="admin-payment-panel-title">Posted payments</h3>
            <div class="admin-payment-view-list-wrap">
                <table class="admin-bookings-table admin-payment-view-table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Receipt</th>
                            <th>Event</th>
                            <th>Method</th>
                            <th>Amount</th>
                            <th>Staff</th>
                        </tr>
                    </thead>
                    <tbody data-payment-view-list>
                        <tr><td colspan="6" class="admin-bookings-loading">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="admin-payments-future-note">Posted payments cannot be edited. Use Payments → View to void if needed.</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payment-view-close>Close</button>
            <button type="button" class="admin-booking-confirm" data-payment-view-add hidden>Record payment</button>
        </footer>
    </section>
</div>

<div class="admin-booking-modal" data-payment-add-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payment-add-close aria-label="Close add payment"></button>
    <section class="admin-booking-modal-dialog admin-payment-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="addPaymentTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-payment-add-ref></span>
                <h2 id="addPaymentTitle">Add payment</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payment-add-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body admin-payment-modal-body">
            <p class="admin-payment-add-banner is-error" data-payment-add-banner hidden role="alert"></p>
            <p class="admin-payment-guest-line" data-payment-add-guest>Guest</p>

            <div class="admin-payment-prices">
                <button
                    type="button"
                    class="admin-payment-prices-toggle"
                    data-payment-prices-toggle
                    aria-expanded="false"
                    aria-controls="paymentPricesPanel">
                    <span>
                        <strong>Price details</strong>
                        <span data-payment-prices-preview>Balance due shown here</span>
                    </span>
                    <span class="admin-payment-prices-chevron" aria-hidden="true"></span>
                </button>
                <div id="paymentPricesPanel" class="admin-payment-prices-body" data-payment-prices-body hidden>
                    <ul class="admin-payment-prices-list" data-payment-prices-list>
                        <li><button type="button" data-payment-price-pick="stayTotal">Stay total <strong data-price-stay>₱0.00</strong></button></li>
                        <li><button type="button" data-payment-price-pick="amountPaid">Already paid <strong data-price-paid>₱0.00</strong></button></li>
                        <li><button type="button" data-payment-price-pick="balanceDue">Balance due <strong data-price-balance>₱0.00</strong></button></li>
                    </ul>
                    <p class="admin-payment-prices-hint">Pick a row to set the locked amount (not typed).</p>
                </div>
            </div>

            <div class="admin-payment-form">
                <label>
                    <span>Method</span>
                    <select data-payment-method>
                        <option value="Cash">Cash</option>
                        <option value="EWallet">E-wallet</option>
                        <option value="BankTransfer">Bank transfer (InstaPay QR)</option>
                    </select>
                </label>

                <label>
                    <span>Received by (staff) *</span>
                    <input type="text" maxlength="120" autocomplete="name" data-payment-received-by placeholder="e.g. Ana Reyes" />
                </label>

                <div class="admin-payment-cash-panel" data-payment-cash-panel>
                    <p class="admin-payment-panel-title">Cash tender</p>
                    <label>
                        <span>Amount due (₱) <em>locked</em></span>
                        <input type="text" inputmode="decimal" data-payment-cash-due readonly tabindex="-1" />
                    </label>
                    <label>
                        <span>Cash from guest (₱)</span>
                        <input type="text" inputmode="decimal" data-payment-cash-tendered placeholder="0.00" autocomplete="off" />
                    </label>
                    <div class="admin-payment-change" data-payment-change-box>
                        <span>Change</span>
                        <strong data-payment-cash-change>₱0.00</strong>
                    </div>
                    <p class="admin-payment-cash-formula" data-payment-cash-formula>
                        Guest cash − amount due = change
                    </p>
                </div>

                <div class="admin-payment-epay-panel" data-payment-epay-panel hidden>
                    <p class="admin-payment-panel-title">Digital payment proof</p>
                    <p class="admin-payment-prices-hint" data-payment-epay-hint>
                        Guest pays via hotel InstaPay QR or e-wallet. Scan their receipt (or type the reference) and correct OCR if needed.
                    </p>
                    <label>
                        <span>Amount paid (₱) <em>locked</em></span>
                        <input type="text" inputmode="decimal" data-payment-epay-amount readonly tabindex="-1" />
                    </label>
                    <div class="admin-payment-receipt-actions">
                        <span class="admin-payment-receipt-label">Receipt photo</span>
                        <div class="admin-payment-receipt-buttons">
                            <button type="button" class="admin-booking-confirm" data-payment-open-camera>Open camera</button>
                            <button type="button" data-payment-choose-photo>Choose photo</button>
                        </div>
                        <input type="file" accept="image/*" data-payment-receipt-upload hidden />
                        <input type="file" accept="image/*" capture="environment" data-payment-receipt-capture hidden />
                    </div>
                    <p class="admin-payment-ocr-status" data-payment-ocr-status hidden role="status"></p>

                    <div class="admin-payment-ocr-compare" data-payment-ocr-compare hidden>
                        <p class="admin-payment-panel-title">Compare OCR result</p>
                        <div class="admin-payment-ocr-grid">
                            <figure class="admin-payment-ocr-photo">
                                <div class="admin-payment-ocr-photo-frame">
                                    <img
                                        alt="Uploaded payment receipt"
                                        data-payment-ocr-image
                                        data-photo-zoom
                                        data-photo-zoom-alt="Payment receipt"
                                        title="Click to zoom · Esc to exit" />
                                </div>
                                <div class="admin-payment-ocr-photo-meta">
                                    <p class="admin-payment-ocr-caption" data-payment-ocr-caption>Receipt photo · click to zoom · Esc to exit</p>
                                    <label class="admin-payment-ocr-filter-switch">
                                        <input type="checkbox" data-payment-ocr-scanner-filter />
                                        <span class="admin-payment-ocr-filter-track" aria-hidden="true"></span>
                                        <span class="admin-payment-ocr-filter-text">Scanner filter</span>
                                    </label>
                                </div>
                            </figure>
                            <div class="admin-payment-ocr-fields">
                                <label>
                                    <span>Detected reference</span>
                                    <input type="text" maxlength="120" data-payment-ocr-ref placeholder="Ref No. / transaction id" />
                                </label>
                                <label>
                                    <span>Detected amount (₱)</span>
                                    <input type="text" inputmode="decimal" data-payment-ocr-amount placeholder="0.00" autocomplete="off" />
                                </label>
                                <label>
                                    <span>Transfer from / sender</span>
                                    <input type="text" maxlength="160" data-payment-ocr-from placeholder="Sender name or number" />
                                </label>
                                <label>
                                    <span>Transfer to / recipient</span>
                                    <input type="text" maxlength="160" data-payment-ocr-to placeholder="Recipient name or number" />
                                </label>
                                <label>
                                    <span>OCR text (for checking)</span>
                                    <textarea rows="6" readonly data-payment-ocr-raw></textarea>
                                </label>
                                <p class="admin-payment-prices-hint">
                                    Scan or upload the guest receipt (Azure OCR when available, otherwise local). Fix fields, then Apply.
                                </p>
                                <div class="admin-payment-ocr-actions">
                                    <button type="button" data-payment-ocr-discard>Discard scan</button>
                                    <button type="button" class="admin-booking-confirm" data-payment-ocr-apply>Apply to payment</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <label>
                        <span>Payment reference <em>from OCR or manual</em></span>
                        <input type="text" maxlength="120" data-payment-external-ref placeholder="Reference / transaction id" />
                    </label>
                    <label data-payment-bank-ref-wrap hidden>
                        <span>InstaPay / bank reference</span>
                        <input type="text" maxlength="120" data-payment-bank-ref placeholder="Clearing / transfer code if shown" />
                    </label>
                    <input type="hidden" data-payment-receipt-path value="" />
                    <input type="hidden" data-payment-ocr-channel value="" />
                </div>

                <label>
                    <span>Notes (optional)</span>
                    <textarea rows="2" maxlength="1000" data-payment-notes></textarea>
                </label>
            </div>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payment-add-close>Cancel</button>
            <button type="button" class="admin-booking-confirm" data-payment-add-save>Save payment</button>
        </footer>
        <div class="admin-payment-add-popup" data-payment-add-popup hidden>
            <div class="admin-payment-add-popup-card" role="alertdialog" aria-modal="true" aria-labelledby="paymentAddPopupTitle">
                <h3 id="paymentAddPopupTitle">Apply receipt first</h3>
                <p data-payment-add-popup-text></p>
                <button type="button" class="admin-booking-confirm" data-payment-add-popup-ok>OK</button>
            </div>
        </div>
    </section>
</div>

<div class="admin-booking-modal" data-payment-camera-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payment-camera-close aria-label="Close camera"></button>
    <section class="admin-booking-modal-dialog admin-payment-camera-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentCameraTitle">
        <header>
            <div>
                <span class="admin-booking-reference">E-payment</span>
                <h2 id="paymentCameraTitle">Scan receipt</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payment-camera-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body admin-payment-camera-body">
            <p class="admin-payment-prices-hint">
                Hold the guest’s phone upright. Fit the full mobile receipt inside the portrait frame — capture is automatic when details are clear, or tap Capture anytime.
            </p>
            <div class="admin-payment-camera-stage">
                <video data-payment-camera-video playsinline autoplay muted></video>
                <canvas data-payment-camera-canvas hidden></canvas>
                <div class="admin-payment-camera-guide" aria-hidden="true">
                    <div class="admin-payment-camera-guide-frame" data-payment-camera-guide-frame>
                        <span class="admin-payment-camera-guide-corner is-tl"></span>
                        <span class="admin-payment-camera-guide-corner is-tr"></span>
                        <span class="admin-payment-camera-guide-corner is-bl"></span>
                        <span class="admin-payment-camera-guide-corner is-br"></span>
                        <span class="admin-payment-camera-guide-tick is-top"></span>
                        <span class="admin-payment-camera-guide-tick is-bottom"></span>
                        <span class="admin-payment-camera-guide-tick is-left"></span>
                        <span class="admin-payment-camera-guide-tick is-right"></span>
                        <p class="admin-payment-camera-guide-label" data-payment-camera-guide-label>Mobile receipt</p>
                    </div>
                </div>
            </div>
            <p class="admin-payment-ocr-status" data-payment-camera-status hidden role="status"></p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payment-camera-close>Cancel</button>
            <button type="button" data-payment-camera-switch>Flip camera</button>
            <button type="button" class="admin-booking-confirm" data-payment-camera-capture>Capture photo</button>
        </footer>
    </section>
</div>

<div class="admin-booking-modal" data-history-flush-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-history-flush-close aria-label="Close export dialog"></button>
    <section class="admin-booking-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="historyFlushTitle">
        <header>
            <div>
                <span class="admin-booking-reference">Permanent delete</span>
                <h2 id="historyFlushTitle">Export history to PDF</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-history-flush-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body">
            <p>
                This exports every history record (guest, stay, rooms, amounts) into a branded Mori International Hotel PDF
                softcopy with logo and trademark, saves it to this device, then <strong>permanently deletes</strong> those
                history rows. Only an export log (who / when / count) will remain for 7 days.
            </p>
            <label class="admin-payment-flush-name">
                <span>Staff name performing this data export</span>
                <input type="text" maxlength="120" autocomplete="name" data-history-flush-by placeholder="e.g. Ana Reyes" />
            </label>
            <p class="admin-payment-flush-warn" role="status">This cannot be undone. Export log entries clear after 7 days.</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-history-flush-close>Cancel</button>
            <button type="button" class="admin-booking-confirm admin-payment-flush-confirm" data-history-flush-confirm>Export PDF &amp; delete history</button>
        </footer>
    </section>
</div>

<partial name="_AdminWalkInModals" />

@section Scripts {
    <script src="~/js/walk-in.js" asp-append-version="true"></script>
}
