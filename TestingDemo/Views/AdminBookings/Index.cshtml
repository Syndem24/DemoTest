@{
    ViewData["Title"] = "Bookings";
}

<section class="hotel-page-hero">
    <div>
        <p class="hero-eyebrow">Guest requests</p>
        <h1>Bookings</h1>
        <p>Review requests in a compact table or scan upcoming reservations on the calendar.</p>
    </div>
</section>

<section class="hotel-panel admin-bookings-panel" data-admin-bookings>
    @Html.AntiForgeryToken()

    <div class="admin-bookings-topbar">
        <div class="admin-booking-view-tabs" role="tablist" aria-label="Booking views">
            <button type="button" class="is-active" role="tab" aria-selected="true" data-booking-view="table">
                Booking table
            </button>
            <button type="button" role="tab" aria-selected="false" data-booking-view="calendar">
                Booking calendar
            </button>
            <button type="button" role="tab" aria-selected="false" data-booking-view="history">
                History
            </button>
        </div>
        <div class="admin-room-type-availability" data-room-type-availability aria-live="polite"
            aria-label="Realtime room type availability">
            <span class="admin-room-type-availability-label">Available now</span>
            <div class="admin-room-type-availability-chips" data-room-type-availability-chips>
                <span class="admin-room-type-availability-loading">Loading…</span>
            </div>
        </div>
    </div>

    <div data-booking-table-panel>
        <div class="admin-arrivals-panel" data-arrivals-panel hidden>
            <div class="admin-arrivals-head">
                <div>
                    <strong>Arriving soon</strong>
                    <p>Confirmed guests with check-in in the next 20 minutes (Philippines time).</p>
                </div>
                <button type="button" class="admin-booking-refresh" data-arrivals-close>Back to bookings</button>
            </div>
            <div class="admin-arrivals-list" data-arrivals-list>
                <p class="admin-bookings-loading">Loading arrivals…</p>
            </div>
        </div>

        <div class="admin-arrivals-panel" data-pending-calls-panel hidden>
            <div class="admin-arrivals-head">
                <div>
                    <strong>Call guests soon</strong>
                    <p>Pending bookings with check-in in the next 20 minutes — call to verify, then Confirm &amp;
                        continue setup.</p>
                </div>
                <button type="button" class="admin-booking-refresh" data-pending-calls-close>Back to bookings</button>
            </div>
            <div class="admin-arrivals-list" data-pending-calls-list>
                <p class="admin-bookings-loading">Loading pending calls…</p>
            </div>
        </div>

        <div class="admin-arrivals-panel" data-checkouts-panel hidden>
            <div class="admin-arrivals-head">
                <div>
                    <strong>Checkout soon</strong>
                    <p>Confirmed stays with checkout in the next 20 minutes — call to ask if they will extend for late
                        checkout.</p>
                </div>
                <button type="button" class="admin-booking-refresh" data-checkouts-close>Back to bookings</button>
            </div>
            <div class="admin-arrivals-list" data-checkouts-list>
                <p class="admin-bookings-loading">Loading checkouts…</p>
            </div>
        </div>

        <div class="admin-bookings-toolbar">
            <div class="admin-booking-filters" role="group" aria-label="Filter bookings">
                <button type="button" class="admin-booking-filter is-active" data-booking-filter="">All</button>
                <button type="button" class="admin-booking-filter" data-booking-filter="Pending">Pending</button>
                <button type="button" class="admin-booking-filter" data-booking-filter="Confirmed">Confirmed</button>
            </div>
            <label class="admin-booking-search">
                <span class="visually-hidden">Search bookings</span>
                <input type="search" placeholder="Search reference or guest…" data-booking-search />
            </label>
            <button type="button" class="guest-btn guest-btn-primary admin-walkin-open-btn" data-walkin-open>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="margin-right:0.5rem"><path d="M12 5v14M5 12h14"/></svg>
                Create booking
            </button>
            <button type="button" class="admin-booking-refresh" data-booking-refresh>Refresh</button>
        </div>

        <p class="admin-bookings-message" data-bookings-message role="status" hidden></p>

        <div class="admin-bookings-table-wrap">
            <table class="admin-bookings-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Guest</th>
                        <th>Stay</th>
                        <th>Rooms</th>
                        <th>Type</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody data-bookings-list aria-live="polite">
                    <tr>
                        <td colspan="8" class="admin-bookings-loading">Loading bookings…</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <nav class="admin-bookings-pagination" aria-label="Booking pages">
            <button type="button" data-bookings-prev disabled>Previous</button>
            <span data-bookings-page>Page 1</span>
            <button type="button" data-bookings-next disabled>Next</button>
        </nav>
    </div>

    <div class="admin-reservation-calendar-panel" data-booking-calendar-panel hidden>
        <div class="admin-calendar-intro">
            <div>
                <strong>Booking calendar</strong>
                <p>Reserved guests are waiting for a room. Occupied guests already have a door. Available rooms are those not occupied.</p>
            </div>
            <ul class="admin-calendar-key" aria-label="Calendar counts">
                <li class="is-today">Today</li>
                <li class="is-reserved">Reserved</li>
                <li class="is-occupied">Occupied</li>
                <li class="is-open">Available</li>
                <li class="is-out">Checkout</li>
            </ul>
        </div>
        <div class="admin-reservation-calendar" data-reservation-calendar></div>
        <p class="admin-calendar-fallback" data-calendar-fallback hidden>
            The calendar could not load. Use the booking table instead.
        </p>
    </div>
</section>

<div class="admin-cal-day-modal" data-calendar-day-modal hidden>
    <button type="button" class="admin-cal-day-backdrop" data-calendar-day-close aria-label="Close guest list"></button>
    <section class="admin-cal-day-dialog" role="dialog" aria-modal="true" aria-labelledby="calendarDayTitle">
        <header class="admin-cal-day-head">
            <div class="admin-cal-day-head-copy">
                <p class="admin-cal-day-kicker">Guest list</p>
                <h2 id="calendarDayTitle" data-calendar-day-title>Guests</h2>
                <div class="admin-cal-day-stats" role="group" aria-label="Filter guests for this day">
                    <button type="button" class="admin-cal-day-stat is-stay" data-calendar-day-group="stay" aria-pressed="false">
                        <strong data-calendar-day-stay-count>0</strong> stay
                    </button>
                    <button type="button" class="admin-cal-day-stat is-arrive" data-calendar-day-group="arriving" aria-pressed="false">
                        <strong data-calendar-day-in-count>0</strong> arriving
                    </button>
                    <button type="button" class="admin-cal-day-stat is-out" data-calendar-day-group="out" aria-pressed="false">
                        <strong data-calendar-day-out-count>0</strong> out
                    </button>
                </div>
            </div>
            <button type="button" class="admin-cal-day-close" data-calendar-day-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-cal-day-body">
            <details class="admin-cal-day-occupancy" data-calendar-day-occupancy hidden>
                <summary class="admin-cal-day-occupancy-summary">
                    <span class="admin-cal-day-occupancy-copy">
                        <span class="admin-cal-day-occupancy-kicker">Rooms this night</span>
                        <span class="admin-cal-day-stats admin-cal-day-stats--rooms">
                            <span class="is-reserved"><strong data-calendar-day-reserved>0</strong> reserved</span>
                            <span class="is-occupied"><strong data-calendar-day-occupied>0</strong> occupied</span>
                            <span class="is-open"><strong data-calendar-day-available>0</strong> available</span>
                        </span>
                    </span>
                    <svg class="admin-cal-day-occupancy-chevron" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                        <path d="M7 10l5 5 5-5z"/>
                    </svg>
                </summary>
                <div class="admin-cal-day-occupancy-detail">
                    <div class="admin-cal-day-occupancy-inner">
                        <div class="admin-cal-day-occupancy-meter"
                             role="meter"
                             data-calendar-day-occupancy-meter
                             aria-label="Rooms occupied this night"
                             aria-valuemin="0"
                             aria-valuemax="0"
                             aria-valuenow="0">
                            <span class="is-occupied" data-calendar-day-occupancy-occupied-fill></span>
                            <span class="is-reserved" data-calendar-day-occupancy-reserved-fill></span>
                        </div>
                        <p class="admin-cal-day-occupancy-hint" data-calendar-day-occupancy-hint></p>
                        <ul class="admin-cal-day-types" data-calendar-day-types></ul>
                    </div>
                </div>
            </details>
            <label class="admin-cal-day-find" data-calendar-day-find hidden>
                <input type="search" data-calendar-day-filter placeholder="Find a guest" aria-label="Find a guest" autocomplete="off">
            </label>
            <div class="admin-cal-day-groups">
                <p class="admin-cal-day-empty" data-calendar-day-empty hidden>No guests on this date.</p>
                <section class="admin-cal-day-group" data-cal-group="arriving" data-calendar-day-arriving-block hidden>
                    <h3>Arriving today — needs room <span data-calendar-day-arriving-heading-count></span></h3>
                    <div class="admin-cal-day-rows" data-calendar-day-arriving-list></div>
                </section>
                <section class="admin-cal-day-group" data-cal-group="stay" data-calendar-day-occupied-block hidden>
                    <h3>Occupied <span data-calendar-day-occupied-heading-count></span></h3>
                    <div class="admin-cal-day-rows" data-calendar-day-occupied-list></div>
                </section>
                <section class="admin-cal-day-group" data-cal-group="reserved" data-calendar-day-reserved-block hidden>
                    <h3>Reserved <span data-calendar-day-reserved-heading-count></span></h3>
                    <div class="admin-cal-day-rows" data-calendar-day-reserved-list></div>
                </section>
                <section class="admin-cal-day-group" data-cal-group="out" data-calendar-day-out-block hidden>
                    <h3>Checkout <span data-calendar-day-out-heading-count></span></h3>
                    <div class="admin-cal-day-rows" data-calendar-day-out-list></div>
                </section>
            </div>
        </div>
    </section>
</div>

<div class="admin-booking-modal" data-booking-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-booking-modal-close
        aria-label="Close details"></button>
    <section class="admin-booking-modal-dialog" role="dialog" aria-modal="true"
        aria-labelledby="adminBookingDetailTitle">
        <header class="admin-booking-detail-header">
            <div class="admin-booking-detail-header-main">
                <div class="admin-booking-detail-meta">
                    <span class="admin-booking-detail-kicker">Reservation</span>
                    <span class="admin-booking-reference" data-detail-reference></span>
                </div>
                <div class="admin-booking-detail-header-row">
                    <h2 id="adminBookingDetailTitle" data-detail-guest title="">Booking details</h2>
                    <div class="admin-booking-flow-path" data-detail-flow-path role="progressbar" aria-valuemin="1"
                        aria-valuemax="6" aria-valuenow="1" aria-label="Reception booking flow" hidden></div>
                </div>
            </div>
            <button type="button" class="admin-booking-modal-close" data-booking-modal-close
                aria-label="Close booking details">
                <span class="admin-booking-modal-close-icon" aria-hidden="true">&times;</span>
            </button>
        </header>
        <div class="admin-booking-detail-body" data-booking-detail>
            <p>Loading details…</p>
        </div>
        <footer class="admin-booking-detail-actions" data-booking-detail-actions></footer>
        <div class="admin-fees-saved-popup" data-extras-stage-popup hidden>
            <div class="admin-fees-saved-popup-card" role="alertdialog" aria-modal="true"
                aria-labelledby="extrasStagePopupTitle" aria-describedby="extrasStagePopupMessage">
                <h3 id="extrasStagePopupTitle">Checkout · incidental &amp; snacks</h3>
                <p id="extrasStagePopupMessage" class="admin-checkout-confirm-message">
                    You are on step 5 (Checkout). Add incidental damage or snack &amp; beverage if needed, then Save.
                    When the guest is fully paid, use Archive guest to finish.
                </p>
                <button type="button" class="admin-booking-confirm" data-extras-stage-ok>Continue to checkout
                    panel</button>
            </div>
        </div>
        <div class="admin-fees-saved-popup" data-edit-availability-popup hidden>
            <div class="admin-fees-saved-popup-card" role="alertdialog" aria-modal="true"
                aria-labelledby="editAvailabilityTitle" aria-describedby="editAvailabilityMessage">
                <h3 id="editAvailabilityTitle">Booking edit</h3>
                <p id="editAvailabilityMessage" class="admin-checkout-confirm-message" data-edit-availability-message>
                    Even if you adjust these dates, there is still no available room right now.
                </p>
                <button type="button" class="admin-booking-confirm" data-edit-availability-ok>OK</button>
            </div>
        </div>
        <div class="admin-fees-saved-popup" data-fees-saved-popup hidden>
            <div class="admin-fees-saved-popup-card" role="alertdialog" aria-modal="true"
                aria-labelledby="feesSavedPopupTitle">
                <h3 id="feesSavedPopupTitle">Additional fees</h3>
                <ul class="admin-fees-saved-list" data-fees-saved-list></ul>
                <p class="admin-fees-saved-empty" data-fees-saved-empty hidden>No additional fees on this booking.</p>
                <button type="button" class="admin-booking-confirm" data-fees-saved-ok>OK</button>
            </div>
        </div>
        <div class="admin-fees-saved-popup" data-extend-calendar-popup hidden>
            <div class="admin-fees-saved-popup-card admin-extend-calendar-card" role="dialog" aria-modal="true"
                aria-labelledby="extendCalendarTitle">
                <h3 id="extendCalendarTitle">Extend stay</h3>
                <p class="admin-extend-calendar-lede" data-extend-calendar-lede>
                    Pick a new checkout date. Extra nights fill in when you apply.
                </p>
                <p class="admin-extend-calendar-current" data-extend-calendar-current></p>
                <div class="admin-extend-calendar-nav">
                    <button type="button" class="admin-extend-calendar-nav-btn" data-extend-calendar-prev
                        aria-label="Previous month">‹</button>
                    <strong data-extend-calendar-month></strong>
                    <button type="button" class="admin-extend-calendar-nav-btn" data-extend-calendar-next
                        aria-label="Next month">›</button>
                </div>
                <div class="admin-extend-calendar-weekdays" aria-hidden="true">
                    <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                </div>
                <div class="admin-extend-calendar-grid" data-extend-calendar-grid role="grid"
                    aria-label="Checkout dates"></div>
                <ul class="admin-extend-calendar-key" aria-label="Date colors">
                    <li><span class="is-booked" aria-hidden="true"></span> Booked stay</li>
                    <li><span class="is-extend" aria-hidden="true"></span> Extended nights</li>
                </ul>
                <p class="admin-booking-fees-hint" data-extend-calendar-preview></p>
                <div class="admin-extend-calendar-actions">
                    <button type="button" class="admin-booking-rooms-adjust-btn" data-extend-calendar-cancel>Cancel</button>
                    <button type="button" class="admin-booking-confirm" data-extend-calendar-apply disabled>Apply nights</button>
                </div>
            </div>
        </div>
        <div class="admin-checkout-confirm-popup" data-checkout-confirm-popup hidden>
            <div class="admin-checkout-confirm-card" role="alertdialog" aria-modal="true"
                aria-labelledby="checkoutConfirmTitle" aria-describedby="checkoutConfirmMessage">
                <h3 id="checkoutConfirmTitle" data-checkout-confirm-title>Archive guest</h3>
                <p id="checkoutConfirmMessage" class="admin-checkout-confirm-message" data-checkout-confirm-message></p>
                <dl class="admin-checkout-confirm-summary" data-checkout-confirm-summary hidden>
                    <div>
                        <dt>Reference</dt>
                        <dd data-checkout-confirm-ref>—</dd>
                    </div>
                    <div>
                        <dt>Stay total</dt>
                        <dd data-checkout-confirm-total>—</dd>
                    </div>
                    <div>
                        <dt>Amount paid</dt>
                        <dd data-checkout-confirm-paid>—</dd>
                    </div>
                    <div class="is-balance">
                        <dt data-checkout-confirm-balance-label>Balance due</dt>
                        <dd data-checkout-confirm-balance>—</dd>
                    </div>
                </dl>
                <p class="admin-checkout-confirm-note" data-checkout-confirm-note></p>
                <div class="admin-checkout-confirm-actions">
                    <button type="button" class="admin-checkout-confirm-cancel"
                        data-checkout-confirm-cancel>Cancel</button>
                    <button type="button" class="admin-booking-confirm admin-checkout-confirm-pay"
                        data-checkout-confirm-pay hidden>Record payment</button>
                    <button type="button" class="admin-booking-confirm" data-checkout-confirm-ok>Check out</button>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="admin-booking-modal" data-payment-view-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payment-view-close
        aria-label="Close payment record"></button>
    <section class="admin-booking-modal-dialog admin-payment-modal-dialog" role="dialog" aria-modal="true"
        aria-labelledby="paymentViewTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-payment-view-ref></span>
                <h2 id="paymentViewTitle">Payment record</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payment-view-close
                aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body admin-payment-modal-body">
            <p class="admin-payment-guest-line" data-payment-view-guest>Guest</p>
            <dl class="admin-flush-detail-grid" data-payment-view-summary></dl>
            <h3 class="admin-payment-panel-title">Posted payments</h3>
            <div class="admin-payment-view-list-wrap">
                <table class="admin-bookings-table admin-payment-view-table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Receipt</th>
                            <th>Event</th>
                            <th>Method</th>
                            <th>Amount</th>
                            <th>Staff</th>
                        </tr>
                    </thead>
                    <tbody data-payment-view-list>
                        <tr>
                            <td colspan="6" class="admin-bookings-loading">Loading…</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="admin-payments-future-note">Posted payments cannot be edited. Use Payments → View to void if
                needed.</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payment-view-close>Close</button>
            <button type="button" class="admin-booking-confirm" data-payment-view-add hidden>Record payment</button>
        </footer>
    </section>
</div>

<div class="admin-booking-modal" data-payment-add-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payment-add-close
        aria-label="Close add payment"></button>
    <section class="admin-booking-modal-dialog admin-payment-modal-dialog" role="dialog" aria-modal="true"
        aria-labelledby="addPaymentTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-payment-add-ref></span>
                <h2 id="addPaymentTitle">Add payment</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payment-add-close
                aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body admin-payment-modal-body">
            <p class="admin-payment-add-banner is-error" data-payment-add-banner hidden role="alert"></p>
            <p class="admin-payment-guest-line" data-payment-add-guest>Guest</p>

            <div class="admin-payment-prices" data-payment-prices>
                <button type="button" class="admin-payment-prices-toggle" data-payment-prices-toggle
                    aria-expanded="false" aria-controls="paymentPricesPanel">
                    <span>
                        <strong>Price details</strong>
                        <span data-payment-prices-preview>Balance due shown here</span>
                    </span>
                    <span class="admin-payment-prices-chevron" aria-hidden="true"></span>
                </button>
                <div id="paymentPricesPanel" class="admin-payment-prices-body" data-payment-prices-body hidden>
                    <ul class="admin-payment-prices-list" data-payment-prices-list>
                        <li><button type="button" data-payment-price-pick="stayTotal">Stay total <strong
                                    data-price-stay>₱0.00</strong></button></li>
                        <li><button type="button" data-payment-price-pick="amountPaid">Already paid <strong
                                    data-price-paid>₱0.00</strong></button></li>
                        <li><button type="button" data-payment-price-pick="balanceDue">Balance due <strong
                                    data-price-balance>₱0.00</strong></button></li>
                    </ul>
                    <p class="admin-payment-prices-hint">Pick a row to set the locked amount (not typed).</p>
                </div>
            </div>

            <div class="admin-payment-form">
                <label>
                    <span>Method</span>
                    <select data-payment-method>
                        <option value="Cash">Cash</option>
                        <option value="EWallet">E-wallet (InstaPay QR)</option>
                    </select>
                </label>

                <div class="admin-payment-cash-panel" data-payment-cash-panel>
                    <p class="admin-payment-panel-title">Cash tender</p>
                    <label>
                        <span><span data-payment-cash-due-label>Amount due (₱)</span> <em>locked</em></span>
                        <input type="text" inputmode="decimal" data-payment-cash-due readonly tabindex="-1" />
                    </label>
                    <div data-payment-cash-tender>
                    <label>
                        <span>Cash from guest (₱)</span>
                        <input type="text" inputmode="decimal" data-payment-cash-tendered placeholder="0.00"
                            autocomplete="off" data-mori-filter="decimal" name="paymentCashTendered" />
                    </label>
                    <div class="admin-payment-change" data-payment-change-box>
                        <span>Change</span>
                        <strong data-payment-cash-change>₱0.00</strong>
                    </div>
                    <p class="admin-payment-cash-formula" data-payment-cash-formula>
                        Guest cash − amount due = change
                    </p>
                    </div>
                </div>

                <div class="admin-payment-epay-panel" data-payment-epay-panel hidden>
                    <p class="admin-payment-panel-title">Digital payment</p>
                    <p class="admin-payment-prices-hint" data-payment-epay-hint>
                        Guest pays via hotel InstaPay QR (e-wallet). Verify the receipt on the
                        guest’s phone before saving.
                    </p>
                    <label>
                        <span><span data-payment-epay-amount-label>Amount paid (₱)</span> <em>locked</em></span>
                        <input type="text" inputmode="decimal" data-payment-epay-amount readonly tabindex="-1" />
                    </label>
                </div>

                <label>
                    <span>Notes (optional)</span>
                    <textarea rows="2" maxlength="1000" data-payment-notes></textarea>
                </label>
            </div>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payment-add-close>Cancel</button>
            <button type="button" class="admin-booking-confirm" data-payment-add-save>Save payment</button>
        </footer>
        <div class="admin-payment-add-popup" data-payment-add-popup hidden>
            <div class="admin-payment-add-popup-card" role="alertdialog" aria-modal="true"
                aria-labelledby="paymentAddPopupTitle">
                <h3 id="paymentAddPopupTitle">Check payment details</h3>
                <p data-payment-add-popup-text></p>
                <button type="button" class="admin-booking-confirm" data-payment-add-popup-ok>OK</button>
            </div>
        </div>
    </section>
</div>

<partial name="_AdminWalkInModals" />

@section Scripts {
    <script src="~/js/stay-math.js" asp-append-version="true"></script>
    <script src="~/js/walk-in.js" asp-append-version="true"></script>
}
