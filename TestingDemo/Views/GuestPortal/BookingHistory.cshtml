@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Booking history";
}

<section class="guest-section guest-portal-promise" aria-labelledby="guestPortalTitle">
    <p class="guest-eyebrow">Guest account</p>
    <h1 id="guestPortalTitle">Guest booking history</h1>
    <p class="guest-section-copy">
        View past and upcoming bookings linked to your guest account — coming soon.
        Login and logout work now; booking history will connect when guest bookings are stored against your account.
    </p>
    <a class="guest-btn guest-btn-primary" asp-controller="Booking" asp-action="Index">Back to hotel site</a>
</section>
