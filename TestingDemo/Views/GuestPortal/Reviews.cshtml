@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Reviews";
    ViewData["I18nTitle"] = "reviews.title";
    ViewData["GuestImmersive"] = true;
    ViewData["GuestFullBleed"] = true;
}

<div class="guest-portal-reviews-page" data-guest-reviews>
    @Html.AntiForgeryToken()

    <section class="guest-portal-reviews-hero" aria-labelledby="guestPortalReviewsTitle">
        <div class="guest-portal-reviews-hero-media" aria-hidden="true">
            <img src="~/Images/Hallways/Hallway3.jpg"
                 asp-append-version="true"
                 alt=""
                 decoding="async"
                 fetchpriority="high" />
        </div>
        <div class="guest-portal-reviews-hero-fade" aria-hidden="true"></div>
        <div class="guest-portal-reviews-hero-glow" aria-hidden="true"></div>
        <div class="guest-portal-reviews-hero-inner">
            <nav class="guest-portal-reviews-crumb" aria-label="Breadcrumb">
                <a asp-controller="Booking" asp-action="Index" data-i18n="reviews.crumbHome">Home</a>
                <span aria-hidden="true">›</span>
                <span aria-current="page" data-i18n="reviews.crumbHere">Reviews</span>
            </nav>
            <p class="guest-portal-reviews-chip">
                <span class="guest-portal-reviews-chip-dot" aria-hidden="true"></span>
                <span data-i18n="reviews.eyebrow">Guest account</span>
            </p>
            <h1 id="guestPortalReviewsTitle" data-i18n="reviews.title">Your stay reviews</h1>
            <p class="guest-portal-reviews-hero-lede" data-i18n="reviews.lede">
                After checkout, rate staff, comfort, and facilities. Reviews appear on the hotel site for future guests.
                Stays match your account email.
            </p>
        </div>
    </section>

    <div class="guest-portal-reviews-body">
        <p class="guest-reviews-portal-message" data-review-message role="status" hidden></p>

        <section class="guest-reviews-portal-block" aria-labelledby="eligibleTitle">
            <header class="guest-reviews-portal-block-head">
                <h2 id="eligibleTitle" data-i18n="reviews.ready">Ready to review</h2>
                <p data-i18n="reviews.readyLede">Verified stays waiting for your rating.</p>
            </header>
            <div class="guest-reviews-portal-list" data-review-eligible>
                <p class="guest-reviews-empty" data-i18n="reviews.loading">Loading…</p>
            </div>
        </section>

        <section class="guest-reviews-portal-block" aria-labelledby="mineTitle">
            <header class="guest-reviews-portal-block-head">
                <h2 id="mineTitle" data-i18n="reviews.yours">Your reviews</h2>
                <p data-i18n="reviews.yoursLede">What you’ve shared with future guests.</p>
            </header>
            <div class="guest-reviews-portal-list" data-review-mine>
                <p class="guest-reviews-empty" data-i18n="reviews.loading">Loading…</p>
            </div>
        </section>

        <p class="guest-reviews-portal-foot">
            <a class="guest-btn guest-btn-ghost" asp-controller="Booking" asp-action="Index" asp-fragment="reviews" data-i18n="reviews.seePublic">See public reviews</a>
        </p>
    </div>

    <div class="guest-review-modal" data-review-modal hidden>
        <button type="button"
                class="guest-review-modal-backdrop"
                data-review-close
                aria-label="Close"
                data-i18n="reviews.close"
                data-i18n-attr="aria-label"
                data-i18n-attr-only></button>
        <div class="guest-review-modal-card" role="dialog" aria-modal="true" aria-labelledby="reviewModalTitle">
            <header class="guest-review-modal-header">
                <div class="guest-review-modal-visual" aria-hidden="true">
                    <img src="~/Images/ReceptionArea/Reception1.jpg" asp-append-version="true" alt="" decoding="async" />
                </div>
                <div class="guest-review-modal-head-copy">
                    <p class="guest-eyebrow" data-i18n="reviews.verified">Verified stay</p>
                    <h3 id="reviewModalTitle" data-review-modal-title data-i18n="reviews.write">Write a review</h3>
                    <p class="guest-review-modal-lede" data-i18n="reviews.writeLede">Share what future guests should know about staff, comfort, and facilities.</p>
                </div>
                <button type="button"
                        class="guest-review-modal-x"
                        data-review-close
                        aria-label="Close"
                        data-i18n="reviews.close"
                        data-i18n-attr="aria-label">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M6.4 6.4a1 1 0 0 1 1.4 0L12 10.6l4.2-4.2a1 1 0 1 1 1.4 1.4L13.4 12l4.2 4.2a1 1 0 0 1-1.4 1.4L12 13.4l-4.2 4.2a1 1 0 0 1-1.4-1.4L10.6 12 6.4 7.8a1 1 0 0 1 0-1.4z"/>
                    </svg>
                </button>
            </header>

            <form data-review-form id="guestReviewForm">
                <input type="hidden" data-review-booking-id />
                <input type="hidden" data-review-id />

                <section class="guest-review-modal-panel guest-review-rating-panel"
                         aria-label="Ratings"
                         data-i18n="reviews.ratingsAria"
                         data-i18n-attr="aria-label">
                    <p class="guest-review-rating-hint" data-i18n="reviews.tapStars">Tap the stars to rate each part of your stay.</p>
                    <div class="guest-review-rating-grid">
                        <div class="guest-star-field"
                             data-star-field="staff"
                             role="radiogroup"
                             aria-labelledby="reviewStaffLabel"
                             aria-required="true">
                            <div class="guest-star-field-copy">
                                <span id="reviewStaffLabel"><span data-i18n="reviews.staff">Staff / service</span> <em>*</em></span>
                                <span class="guest-star-value" data-star-label aria-live="polite"></span>
                            </div>
                            <input type="hidden" data-review-staff value="" />
                            <div class="guest-star-row" data-star-row></div>
                        </div>
                        <div class="guest-star-field"
                             data-star-field="comfort"
                             role="radiogroup"
                             aria-labelledby="reviewComfortLabel"
                             aria-required="true">
                            <div class="guest-star-field-copy">
                                <span id="reviewComfortLabel"><span data-i18n="reviews.comfort">Comfort</span> <em>*</em></span>
                                <span class="guest-star-value" data-star-label aria-live="polite"></span>
                            </div>
                            <input type="hidden" data-review-comfort value="" />
                            <div class="guest-star-row" data-star-row></div>
                        </div>
                        <div class="guest-star-field"
                             data-star-field="facilities"
                             role="radiogroup"
                             aria-labelledby="reviewFacilitiesLabel"
                             aria-required="true">
                            <div class="guest-star-field-copy">
                                <span id="reviewFacilitiesLabel"><span data-i18n="reviews.facilities">Facilities</span> <em>*</em></span>
                                <span class="guest-star-value" data-star-label aria-live="polite"></span>
                            </div>
                            <input type="hidden" data-review-facilities value="" />
                            <div class="guest-star-row" data-star-row></div>
                        </div>
                        <div class="guest-star-field"
                             data-star-field="overall"
                             role="radiogroup"
                             aria-labelledby="reviewOverallLabel"
                             aria-required="true">
                            <div class="guest-star-field-copy">
                                <span id="reviewOverallLabel"><span data-i18n="reviews.overall">Overall stay</span> <em>*</em></span>
                                <span class="guest-star-value" data-star-label aria-live="polite"></span>
                            </div>
                            <input type="hidden" data-review-overall value="" />
                            <div class="guest-star-row" data-star-row></div>
                        </div>
                    </div>
                </section>

                <fieldset class="guest-review-field guest-review-modal-panel guest-review-tags-panel">
                    <legend data-i18n="reviews.stoodOut">What stood out? (optional)</legend>
                    <div class="guest-review-tags-pick" data-review-tags>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="FriendlyStaff" /> <span data-i18n="reviews.tagFriendly">Friendly staff</span></label>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="CleanRooms" /> <span data-i18n="reviews.tagClean">Clean rooms</span></label>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="QuietStay" /> <span data-i18n="reviews.tagQuiet">Quiet stay</span></label>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="GreatValue" /> <span data-i18n="reviews.tagValue">Great value</span></label>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="ComfortableBed" /> <span data-i18n="reviews.tagBed">Comfortable bed</span></label>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="NiceBathroom" /> <span data-i18n="reviews.tagBath">Nice bathroom</span></label>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="SlowCheckIn" /> <span data-i18n="reviews.tagSlow">Slow check-in</span></label>
                        <label class="guest-review-tag-chip"><input type="checkbox" value="WifiIssues" /> <span data-i18n="reviews.tagWifi">Wi‑Fi issues</span></label>
                    </div>
                </fieldset>

                <label class="guest-review-field guest-review-field-grow guest-review-modal-panel">
                    <span data-i18n="reviews.commentLabel">Anything else to share? (optional)</span>
                    <textarea data-review-comment
                              maxlength="2000"
                              rows="5"
                              placeholder="What future guests should know…"
                              data-i18n="reviews.commentPh"
                              data-i18n-attr="placeholder"
                              data-i18n-attr-only></textarea>
                </label>
            </form>

            <footer class="guest-review-modal-actions">
                <button type="button" class="guest-btn guest-btn-ghost" data-review-close data-i18n="reviews.cancel">Cancel</button>
                <button type="submit" form="guestReviewForm" class="guest-btn guest-btn-primary" data-review-submit data-i18n="reviews.submit">Submit review</button>
            </footer>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/guest-reviews.js" asp-append-version="true"></script>
}
