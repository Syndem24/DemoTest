@model TestingDemo.ViewModels.EditAdminUserViewModel
@{
    ViewData["Title"] = "Edit staff user";
    var roleOptions = (string[])(ViewBag.RoleOptions ?? Array.Empty<string>());
}

<section class="admin-users-page">
    <header class="admin-users-hero">
        <span class="admin-users-eyebrow">Admin users</span>
        <h1>Edit staff account</h1>
        <p>Update profile details and role for this user account.</p>
        <div class="admin-users-hero-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Back to users</a>
        </div>
    </header>

    <article class="admin-users-edit-card">
        <form asp-action="Edit" method="post" class="admin-users-edit-form">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="admin-users-edit-grid">
                <div class="admin-users-edit-field">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="admin-users-edit-field">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="admin-users-edit-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="admin-users-edit-field">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="admin-users-edit-field">
                    <label asp-for="BirthDate" class="form-label"></label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
                <div class="admin-users-edit-field">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" class="form-select">
                        @foreach (var role in roleOptions)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="admin-users-edit-field admin-users-edit-field-full">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-users-edit-note">
                Account status:
                @if (Model.IsDisabled)
                {
                    <span class="admin-users-role is-disabled">Disabled</span>
                }
                else
                {
                    <span class="admin-users-role is-active">Active</span>
                }
            </div>

            <div class="admin-users-actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </article>
</section>
