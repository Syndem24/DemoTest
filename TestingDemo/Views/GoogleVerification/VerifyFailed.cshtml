@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Verification failed";
    ViewData["GuestAuthPage"] = true;
}

<section class="guest-auth guest-auth--status" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-media" aria-hidden="true">
        <img src="~/Images/ReceptionArea/Reception1.jpg"
             asp-append-version="true"
             alt=""
             decoding="async" />
        <div class="guest-auth-media-veil"></div>
    </div>
    <div class="guest-auth-panel">
        <p class="guest-eyebrow" data-i18n="auth.googleEyebrow">Google account</p>
        <h1 id="guestAuthTitle" data-i18n="auth.googleFailedTitle">Could not verify</h1>
        <p class="guest-section-copy guest-auth-lede" data-i18n="auth.googleFailedLede">
            The link is invalid or expired, or the Google account did not match. Ask an AdminManager for a new onboarding link if needed.
        </p>
        <div class="guest-auth-actions">
            <a class="guest-btn guest-btn-ghost" asp-controller="Booking" asp-action="Index" data-i18n="auth.backGuest">Back to guest site</a>
        </div>
    </div>
</section>
