@model TestingDemo.ViewModels.RoomTypeFormViewModel

<div class="hotel-accordion-list" id="editTypeAccordion">
    <section class="hotel-accordion" data-section="details">
        <button type="button" class="hotel-accordion-toggle" aria-expanded="false">
            <span class="step">1</span>
            <span class="hotel-accordion-copy">
                <span class="hotel-accordion-title">Room type details</span>
                <span class="hotel-accordion-hint">Applied to every room of this type</span>
            </span>
            <span class="hotel-accordion-chevron" aria-hidden="true"></span>
        </button>
        <div class="hotel-accordion-body is-collapsed">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="8" maxlength="5000" placeholder="Full room type description guests will see"></textarea>
                    <div class="form-text">Up to 5,000 characters.</div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PricePerNight" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text money-prefix">₱</span>
                        <input asp-for="PricePerNight"
                               class="form-control money-input"
                               inputmode="decimal"
                               placeholder="0.00" />
                    </div>
                    <div class="form-text">Philippine peso (₱).</div>
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxOccupancy" class="form-label"></label>
                    <input asp-for="MaxOccupancy" class="form-control" />
                    <span asp-validation-for="MaxOccupancy" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BedCount" class="form-label"></label>
                    <input asp-for="BedCount" class="form-control" />
                    <span asp-validation-for="BedCount" class="text-danger"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="hotel-accordion" data-section="inclusions">
        <button type="button" class="hotel-accordion-toggle" aria-expanded="false">
            <span class="step">2</span>
            <span class="hotel-accordion-copy">
                <span class="hotel-accordion-title">Inclusions</span>
                <span class="hotel-accordion-hint">Shared inclusions for all rooms of this type</span>
            </span>
            <span class="hotel-accordion-chevron" aria-hidden="true"></span>
        </button>
        <div class="hotel-accordion-body is-collapsed">
            <div class="row g-3">
                <partial name="_InclusionPicker" model="new InclusionPickerViewModel
                {
                    SelectedInclusions = Model.SelectedInclusions,
                    AvailableInclusions = Model.AvailableInclusions,
                    CustomCategories = Model.CustomCategories?.Count > 0
                        ? Model.CustomCategories
                        : CustomCategoryFormHelper.Parse(Model.CustomCategoriesJson)
                }" />
            </div>
        </div>
    </section>

    <section class="hotel-accordion" data-section="photos">
        <button type="button" class="hotel-accordion-toggle" aria-expanded="false">
            <span class="step">3</span>
            <span class="hotel-accordion-copy">
                <span class="hotel-accordion-title">Photos</span>
                <span class="hotel-accordion-hint">Add, preview, or remove room type images</span>
            </span>
            <span class="hotel-accordion-chevron" aria-hidden="true"></span>
        </button>
        <div class="hotel-accordion-body is-collapsed">
            <div class="row g-3">
                <partial name="_RoomImageUploader" model="new RoomImageUploaderViewModel
                {
                    ExistingImages = Model.ExistingImages,
                    InputName = nameof(RoomTypeFormViewModel.UploadedImages),
                    ExistingInputName = nameof(RoomTypeFormViewModel.ExistingImages)
                }" />
            </div>
        </div>
    </section>

    <section class="hotel-accordion" data-section="room-numbers">
        <button type="button" class="hotel-accordion-toggle" aria-expanded="false">
            <span class="step">4</span>
            <span class="hotel-accordion-copy">
                <span class="hotel-accordion-title">Room numbers</span>
                <span class="hotel-accordion-hint">Set how many rooms and edit each number</span>
            </span>
            <span class="hotel-accordion-chevron" aria-hidden="true"></span>
        </button>
        <div class="hotel-accordion-body is-collapsed">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="RoomCount" class="form-label"></label>
                    <input asp-for="RoomCount"
                           class="form-control"
                           type="number"
                           min="1"
                           max="50"
                           id="editTypeRoomCount" />
                    <span asp-validation-for="RoomCount" class="text-danger"></span>
                    <div class="form-text">Increase to add rooms, decrease to remove rooms (1–50).</div>
                </div>
                <div class="col-12">
                    <label class="form-label">Assign room numbers</label>
                    <div id="editTypeRoomNumberAssignments" class="border rounded p-3"></div>
                    <span asp-validation-for="Rooms" class="text-danger d-block mt-2"></span>
                    <div class="form-text">Each room number must be unique across the hotel. Removing a slot deletes that room on save.</div>
                </div>
            </div>
        </div>
    </section>
</div>
