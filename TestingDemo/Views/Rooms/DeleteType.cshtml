@model TestingDemo.ViewModels.RoomTypeSummaryViewModel
@{
    ViewData["Title"] = "Delete Room Type";
    var images = Model.Images ?? new List<string>();
}

<section class="hotel-page-hero is-danger">
    <div>
        <p class="eyebrow">Confirm deletion</p>
        <h1>Delete “@Model.Name”</h1>
        <p class="lede">This removes the room type and every physical room under it.</p>
    </div>
    <div class="hero-meta">
        <span class="hotel-chip">@Model.RoomCount room(s)</span>
        <span class="hotel-chip">@Model.AvailableCount available</span>
    </div>
</section>

@if (TempData["Error"] is string deleteError)
{
    <div class="alert alert-danger" role="alert">@deleteError</div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="hotel-panel">
            <div class="hotel-warning" role="alert">
                <span class="icon" aria-hidden="true">!</span>
                <div>
                    <strong>All @Model.RoomCount room(s) of this type will be permanently deleted.</strong>
                    Uploaded photos for this type will also be removed. This cannot be undone.
                </div>
            </div>

            <dl class="hotel-summary mb-0">
                <div class="hotel-summary-row">
                    <dt>Room type</dt>
                    <dd>@Model.Name</dd>
                </div>
                <div class="hotel-summary-row">
                    <dt>Price / night</dt>
                    <dd>@Model.PricePerNight.ToString("C")</dd>
                </div>
                <div class="hotel-summary-row">
                    <dt>Occupancy</dt>
                    <dd>@Model.MaxOccupancy guests / @Model.BedCount bed(s)</dd>
                </div>
                <div class="hotel-summary-row">
                    <dt>Rooms</dt>
                    <dd>@Model.RoomCount total (@Model.AvailableCount available)</dd>
                </div>
                <div class="hotel-summary-row">
                    <dt>Inclusions</dt>
                    <dd>
                        @(Model.Inclusions.Any()
                            ? string.Join(", ", Model.Inclusions)
                            : "—")
                    </dd>
                </div>
            </dl>

            @if (images.Any())
            {
                <div class="hotel-thumb-strip" aria-label="Room type photos">
                    @foreach (var image in images.Take(6))
                    {
                        <img src="@image"
                             alt="@Model.Name"
                             data-photo-zoom
                             data-photo-zoom-group="delete-type"
                             data-photo-zoom-src="@image"
                             title="Click to zoom" />
                    }
                </div>
            }

            <form asp-action="DeleteType" method="post" class="hotel-actions">
                <input type="hidden" name="id" value="@Model.RoomTypeId" />
                <button type="submit" class="btn btn-hotel-danger">Delete Room Type</button>
                <a asp-action="EditType" asp-route-id="@Model.RoomTypeId" class="btn btn-outline-secondary">Edit Instead</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
