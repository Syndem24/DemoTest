@model TestingDemo.ViewModels.RoomDetailsViewModel
@using TestingDemo.Services
@{
    var room = Model.Room;
    var stay = Model.CurrentStay;
    ViewData["Title"] = $"Room {room.RoomNumber}";
    var images = room.Images ?? new List<string>();
    var mainImage = images.FirstOrDefault();
    var hasDescription = !string.IsNullOrWhiteSpace(room.Description);
    var assignedRooms = stay?.Items
        .SelectMany(item => item.AssignedRooms)
        .Select(item => item.RoomNumber)
        .Where(number => !string.IsNullOrWhiteSpace(number))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(number => number, StringComparer.OrdinalIgnoreCase)
        .ToList() ?? new List<string>();
}

<section class="hotel-page-hero">
    <div>
        <p class="eyebrow">Room details</p>
        <h1>Room @room.RoomNumber</h1>
        <p class="lede">@room.Name · review photos, pricing, and inclusions.</p>
    </div>
    <div class="hero-meta">
        <span class="hotel-chip">@room.Name</span>
        <span class="hotel-chip">@room.PricePerNight.ToString("C") / night</span>
        <span class="hotel-chip">@TestingDemo.Models.RoomStatusDisplay.Label(room.Status)</span>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-hotel alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 hotel-details-layout">
    <div class="col-xl-7">
        <div class="hotel-panel hotel-details-gallery mb-3">
            @if (images.Any())
            {
                <div class="hotel-gallery-main">
                    <img id="mainRoomImage"
                         src="@mainImage"
                         alt="@RoomImageStorage.GetFileName(mainImage!)"
                         data-photo-zoom
                         data-photo-zoom-group="room-details"
                         data-photo-zoom-src="@mainImage" />
                    <div class="hotel-gallery-caption">
                        <span id="mainRoomImageName">@RoomImageStorage.GetFileName(mainImage!)</span>
                        <span class="hotel-gallery-count">@images.Count photo@(images.Count == 1 ? "" : "s") · click to zoom</span>
                    </div>
                </div>
                <div class="hotel-gallery-thumbs" role="list">
                    @foreach (var image in images)
                    {
                        var fileName = RoomImageStorage.GetFileName(image);
                        var isActive = string.Equals(image, mainImage, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="hotel-gallery-thumb @(isActive ? "is-active" : string.Empty) room-image-thumb"
                                data-image-src="@image"
                                data-image-name="@fileName"
                                title="@fileName"
                                role="listitem">
                            <img src="@image"
                                 alt="@fileName"
                                 loading="lazy"
                                 data-photo-zoom
                                 data-photo-zoom-group="room-details"
                                 data-photo-zoom-src="@image" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="hotel-gallery-empty">
                    <strong>No photos yet</strong>
                    <p>Add images from the room type settings.</p>
                    <a asp-action="EditType" asp-route-id="@room.RoomTypeId" class="btn btn-primary btn-sm">Add photos</a>
                </div>
            }
        </div>

        <div class="hotel-panel hotel-details-actions-bar">
            <div class="hotel-details-actions-main">
                <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-primary">
                    Edit this room
                </a>
                <a asp-action="Index" asp-route-view="list" class="btn btn-outline-secondary">
                    Back to room list
                </a>
            </div>
            <div class="hotel-details-actions-links">
                <a asp-action="EditType" asp-route-id="@room.RoomTypeId" class="hotel-action-link">
                    Edit room type (all @room.Name rooms)
                </a>
                <a asp-action="Delete" asp-route-id="@room.Id" class="hotel-action-link is-danger">
                    Delete this room
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        @if (room.Status == TestingDemo.Models.RoomStatus.Occupied)
        {
            var guestLabel = stay?.GuestName ?? "Current guest";
            var checkoutConfirm = stay is null
                ? string.Empty
                : assignedRooms.Count > 1
                    ? $"Check out {stay.Reference} and free rooms {string.Join(", ", assignedRooms)}?"
                    : $"Check out {stay.Reference}?";

            <div class="hotel-panel hotel-guest-stay mb-3">
                <div class="hotel-desc-collapse hotel-guest-stay-dropdown" id="guestStayCollapse">
                    <button type="button"
                            class="hotel-desc-toggle hotel-guest-stay-toggle"
                            id="guestStayToggle"
                            aria-expanded="false"
                            aria-controls="guestStayBody">
                        <span class="hotel-guest-stay-toggle-label">
                            <span class="hotel-status is-occupied">Occupied</span>
                            <span>
                                <strong>Guest details</strong>
                                <small>@guestLabel</small>
                            </span>
                        </span>
                        <span class="hotel-desc-chevron" aria-hidden="true"></span>
                    </button>
                    <div class="hotel-desc-body is-collapsed" id="guestStayBody" hidden>
                        @if (stay is not null)
                        {
                            <dl class="hotel-summary mb-0">
                                <div class="hotel-summary-row">
                                    <dt>Guest</dt>
                                    <dd>@stay.GuestName</dd>
                                </div>
                                <div class="hotel-summary-row">
                                    <dt>Email</dt>
                                    <dd><a href="mailto:@stay.GuestEmail">@stay.GuestEmail</a></dd>
                                </div>
                                <div class="hotel-summary-row">
                                    <dt>Phone</dt>
                                    <dd><a href="tel:@stay.GuestPhone">@stay.GuestPhone</a></dd>
                                </div>
                                <div class="hotel-summary-row">
                                    <dt>Reference</dt>
                                    <dd>@stay.Reference</dd>
                                </div>
                                <div class="hotel-summary-row">
                                    <dt>Stay</dt>
                                    <dd>@stay.CheckInAtUtc.ToString("MMM d, yyyy") → @stay.CheckoutTimeUtc.ToString("MMM d, yyyy")</dd>
                                </div>
                                <div class="hotel-summary-row">
                                    <dt>Type</dt>
                                    <dd>@stay.Kind</dd>
                                </div>
                                <div class="hotel-summary-row">
                                    <dt>Total</dt>
                                    <dd>@stay.TotalAmount.ToString("C")</dd>
                                </div>
                                @if (assignedRooms.Count > 0)
                                {
                                    <div class="hotel-summary-row">
                                        <dt>Assigned rooms</dt>
                                        <dd>@string.Join(", ", assignedRooms)</dd>
                                    </div>
                                }
                            </dl>
                            <p class="hotel-guest-stay-note">
                                Check out ends this stay and sets assigned rooms to Maintaining until housekeeping opens them.
                            </p>
                            <form asp-action="Checkout"
                                  asp-route-id="@room.Id"
                                  method="post"
                                  class="hotel-guest-stay-actions"
                                  onsubmit="return confirm(@System.Text.Json.JsonSerializer.Serialize(checkoutConfirm));">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary">Check out guest</button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                This room is marked Occupied, but no confirmed booking assignment was found.
                            </p>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="hotel-panel mb-3">
            <div class="hotel-details-stats">
                <div class="hotel-stat">
                    <span class="hotel-stat-label">Price</span>
                    <strong>@room.PricePerNight.ToString("C")</strong>
                    <span class="hotel-stat-note">per night</span>
                </div>
                <div class="hotel-stat">
                    <span class="hotel-stat-label">Guests</span>
                    <strong>@room.MaxOccupancy</strong>
                    <span class="hotel-stat-note">max occupancy</span>
                </div>
                <div class="hotel-stat">
                    <span class="hotel-stat-label">Beds</span>
                    <strong>@room.BedCount</strong>
                    <span class="hotel-stat-note">bed count</span>
                </div>
            </div>
        </div>

        <div class="hotel-panel mb-3">
            <div class="hotel-details-overview-head">
                <h2 class="hotel-details-heading">Overview</h2>
                @{
                    var isOccupied = room.Status == TestingDemo.Models.RoomStatus.Occupied;
                    var isOpen = room.Status == TestingDemo.Models.RoomStatus.Available;
                    var switchTitle = isOccupied
                        ? "Guest is in-house — check out before changing availability"
                        : isOpen
                            ? "Turn off to close for maintaining (e.g. broken tap)"
                            : "Turn on when the room is ready for guests";
                }
                <form asp-action="SetRoomOpen"
                      asp-route-id="@room.Id"
                      method="post"
                      class="hotel-cleaning-ready @(isOccupied ? "is-disabled" : string.Empty)"
                      data-room-open-toggle>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="open" value="@(isOpen ? "true" : "false")" data-room-open-value />
                    <label class="hotel-cleaning-switch" title="@switchTitle">
                        <input type="checkbox"
                               class="hotel-cleaning-switch-input"
                               value="true"
                               aria-label="@(isOpen ? "Room is open for guests" : "Room is closed for maintaining")"
                               @(isOpen ? "checked" : null)
                               @(isOccupied ? "disabled" : null) />
                        <span class="hotel-cleaning-switch-track" aria-hidden="true">
                            <span class="hotel-cleaning-switch-thumb"></span>
                        </span>
                        <span class="hotel-cleaning-switch-copy">
                            <strong>@(isOpen ? "Open for guests" : "Maintaining")</strong>
                            <small>@(isOccupied ? "Occupied — checkout first" : isOpen ? "Turn off to close room" : "Turn on when ready")</small>
                        </span>
                    </label>
                </form>
            </div>
            <dl class="hotel-summary mb-0">
                <div class="hotel-summary-row">
                    <dt>Room number</dt>
                    <dd>@room.RoomNumber</dd>
                </div>
                <div class="hotel-summary-row">
                    <dt>Room type</dt>
                    <dd>@room.Name</dd>
                </div>
                <div class="hotel-summary-row">
                    <dt>Status</dt>
                    <dd>
                        <span class="hotel-status @TestingDemo.Models.RoomStatusDisplay.CssClass(room.Status)">
                            @TestingDemo.Models.RoomStatusDisplay.Label(room.Status)
                        </span>
                    </dd>
                </div>
            </dl>

            <div class="hotel-desc-collapse @(hasDescription ? string.Empty : "is-empty")" id="roomDescriptionCollapse">
                <button type="button"
                        class="hotel-desc-toggle"
                        id="roomDescriptionToggle"
                        aria-expanded="false"
                        aria-controls="roomDescriptionBody"
                        @(!hasDescription ? "disabled" : null)>
                    <span>Description</span>
                    <span class="hotel-desc-chevron" aria-hidden="true"></span>
                </button>
                <div class="hotel-desc-body is-collapsed" id="roomDescriptionBody" hidden>
                    @if (hasDescription)
                    {
                        <p>@room.Description</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No description provided.</p>
                    }
                </div>
            </div>
        </div>

        <div class="hotel-panel mb-3">
            <h2 class="hotel-details-heading">Inclusions</h2>
            @if (room.Inclusions.Any())
            {
                <div class="hotel-inclusion-chips">
                    @foreach (var inclusion in room.Inclusions)
                    {
                        <span class="hotel-inclusion-chip">@inclusion</span>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No inclusions assigned.</p>
            }
        </div>
    </div>
</div>

<div class="hotel-confirm-overlay"
     id="roomCloseConfirm"
     hidden
     data-room-close-confirm>
    <button type="button"
            class="hotel-confirm-backdrop"
            data-room-close-confirm-ok
            aria-label="Confirm close room"></button>
    <div class="hotel-confirm-dialog"
         role="alertdialog"
         aria-modal="true"
         aria-labelledby="roomCloseConfirmTitle"
         aria-describedby="roomCloseConfirmLede">
        <div class="hotel-confirm-dialog-icon" aria-hidden="true">!</div>
        <h2 id="roomCloseConfirmTitle" class="hotel-confirm-dialog-title">Close room for Maintaining?</h2>
        <p id="roomCloseConfirmLede" class="hotel-confirm-dialog-lede">
            Guests will not be able to book this room until you open it again.
        </p>
        <div class="hotel-confirm-dialog-actions">
            <button type="button" class="btn hotel-confirm-btn-cancel" data-room-close-confirm-cancel>
                Cancel
            </button>
            <button type="button" class="btn hotel-confirm-btn-ok" data-room-close-confirm-ok>
                Okay
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const main = document.getElementById('mainRoomImage');
            const mainName = document.getElementById('mainRoomImageName');
            const descToggle = document.getElementById('roomDescriptionToggle');
            const descBody = document.getElementById('roomDescriptionBody');
            const descWrap = document.getElementById('roomDescriptionCollapse');

            function wireCollapse(toggle, body, wrap) {
                if (!toggle || !body || !wrap || toggle.disabled) {
                    return;
                }

                toggle.addEventListener('click', function () {
                    const open = toggle.getAttribute('aria-expanded') === 'true';
                    const next = !open;
                    toggle.setAttribute('aria-expanded', next ? 'true' : 'false');
                    wrap.classList.toggle('is-open', next);
                    body.classList.toggle('is-collapsed', !next);
                    body.hidden = !next;
                });
            }

            wireCollapse(descToggle, descBody, descWrap);
            wireCollapse(
                document.getElementById('guestStayToggle'),
                document.getElementById('guestStayBody'),
                document.getElementById('guestStayCollapse'));

            const openForm = document.querySelector('[data-room-open-toggle]');
            const openToggle = openForm?.querySelector('.hotel-cleaning-switch-input');
            const openValue = openForm?.querySelector('[data-room-open-value]');
            const closeConfirm = document.querySelector('[data-room-close-confirm]');
            const closeConfirmOk = closeConfirm?.querySelectorAll('[data-room-close-confirm-ok]');
            const closeConfirmCancel = closeConfirm?.querySelector('[data-room-close-confirm-cancel]');

            function submitRoomOpen(isOpen) {
                if (!(openForm instanceof HTMLFormElement)
                    || !(openToggle instanceof HTMLInputElement)
                    || !(openValue instanceof HTMLInputElement)) {
                    return;
                }

                openToggle.checked = isOpen;
                openValue.value = isOpen ? 'true' : 'false';
                openForm.requestSubmit();
            }

            function closeRoomConfirmModal() {
                if (!(closeConfirm instanceof HTMLElement)) {
                    return;
                }

                closeConfirm.classList.remove('is-visible');
                document.body.classList.remove('hotel-confirm-open');
                window.setTimeout(function () {
                    closeConfirm.hidden = true;
                }, 180);
                document.removeEventListener('keydown', onRoomCloseConfirmKey);
            }

            function confirmCloseRoom() {
                closeRoomConfirmModal();
                submitRoomOpen(false);
            }

            function cancelCloseRoom() {
                closeRoomConfirmModal();
                if (openToggle instanceof HTMLInputElement) {
                    openToggle.checked = true;
                }
            }

            function onRoomCloseConfirmKey(event) {
                if (event.key === 'Escape') {
                    event.preventDefault();
                    cancelCloseRoom();
                    return;
                }

                if (event.key.length === 1 && /[a-z]/i.test(event.key) && !event.ctrlKey && !event.metaKey && !event.altKey) {
                    event.preventDefault();
                    confirmCloseRoom();
                }
            }

            function openRoomCloseConfirmModal() {
                if (!(closeConfirm instanceof HTMLElement)) {
                    submitRoomOpen(false);
                    return;
                }

                closeConfirm.hidden = false;
                document.body.classList.add('hotel-confirm-open');
                requestAnimationFrame(function () {
                    closeConfirm.classList.add('is-visible');
                    const okBtn = closeConfirm.querySelector('.hotel-confirm-btn-ok');
                    if (okBtn instanceof HTMLElement) {
                        okBtn.focus();
                    }
                });
                document.addEventListener('keydown', onRoomCloseConfirmKey);
            }

            if (openForm instanceof HTMLFormElement
                && openToggle instanceof HTMLInputElement
                && openValue instanceof HTMLInputElement) {
                openToggle.addEventListener('change', function () {
                    if (this.disabled) {
                        return;
                    }

                    if (!this.checked) {
                        openRoomCloseConfirmModal();
                        return;
                    }

                    submitRoomOpen(true);
                });
            }

            closeConfirmOk?.forEach(function (el) {
                el.addEventListener('click', function (event) {
                    event.preventDefault();
                    confirmCloseRoom();
                });
            });
            closeConfirmCancel?.addEventListener('click', function (event) {
                event.preventDefault();
                cancelCloseRoom();
            });

            if (!main) {
                return;
            }

            document.querySelectorAll('.room-image-thumb').forEach(button => {
                button.addEventListener('click', function (event) {
                    // Let photo-zoom handle clicks on the thumbnail image itself.
                    if (event.target instanceof HTMLElement && event.target.closest('[data-photo-zoom]')) {
                        return;
                    }

                    main.src = this.dataset.imageSrc;
                    main.setAttribute('data-photo-zoom-src', this.dataset.imageSrc || '');
                    main.alt = this.dataset.imageName || '';
                    if (mainName) {
                        mainName.textContent = this.dataset.imageName || '';
                    }
                    document.querySelectorAll('.room-image-thumb').forEach(el => el.classList.remove('is-active'));
                    this.classList.add('is-active');
                });
            });

            window.initPhotoZoom?.(document.querySelector('.hotel-details-gallery'));
        });
    </script>
}
