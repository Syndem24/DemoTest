 @{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var bookingActive = string.Equals(controller, "Booking", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var roomsActive = string.Equals(controller, "Rooms", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(action, "Create", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var adminBookingsActive = string.Equals(controller, "AdminBookings", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var adminPaymentsActive = string.Equals(controller, "AdminPayments", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var createActive = string.Equals(controller, "Rooms", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Create", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var privacyActive = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Privacy", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var adminUsersActive = string.Equals(controller, "AdminUsers", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var adminFlushLogsActive = string.Equals(controller, "AdminFlushLogs", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var adminOffersActive = string.Equals(controller, "AdminSpecialOffers", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var dashboardActive = string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    var isAdminManager = User.IsInRole("AdminManager");
    var isRoomsController = string.Equals(controller, "Rooms", StringComparison.OrdinalIgnoreCase);
    var needsPhotoZoom = !string.IsNullOrEmpty(adminBookingsActive)
        || !string.IsNullOrEmpty(adminPaymentsActive)
        || isRoomsController;
    var userDisplayName = User.Identity?.Name ?? "Account";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mori International Hotel</title>
    <link rel="icon" type="image/png" href="~/Images/Logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/Images/Logo.png" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestingDemo.styles.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(adminBookingsActive)
        || !string.IsNullOrEmpty(adminFlushLogsActive)
        || !string.IsNullOrEmpty(adminPaymentsActive)
        || !string.IsNullOrEmpty(dashboardActive))
    {
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    }
    @if (!string.IsNullOrEmpty(adminBookingsActive))
    {
        <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hotel-shell">
    <partial name="_MoriFlash" />
    <div class="hotel-sidebar-backdrop" id="sidebarBackdrop" hidden></div>

    <aside class="hotel-sidebar" id="hotelSidebar" aria-label="Main navigation">
        <a class="hotel-sidebar-brand"
           asp-controller="Booking"
           asp-action="Index"
           title="Open guest site">
            <img src="~/Images/Logo.png" asp-append-version="true" alt="Mori International Hotel" class="hotel-sidebar-logo" />
        </a>

        <nav class="hotel-sidebar-nav">
            <a class="hotel-sidebar-link @dashboardActive"
               asp-controller="Dashboard"
               asp-action="Index"
               title="Business dashboard">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                </svg>
                <span>Dashboard</span>
            </a>
            <a class="hotel-sidebar-link @roomsActive"
               asp-controller="Rooms"
               asp-action="Index"
               title="Room Management">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M4 7h16v3H4V7zm0 5h16v8H4v-8zm3 2v4h2v-4H7zm5 0v4h2v-4h-2zM3 4h18v2H3V4z"/>
                </svg>
                <span>Rooms</span>
            </a>
            <a class="hotel-sidebar-link @adminBookingsActive"
               asp-controller="AdminBookings"
               asp-action="Index"
               title="Guest bookings">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M7 3h10a2 2 0 0 1 2 2v16l-7-3-7 3V5a2 2 0 0 1 2-2zm2 4v2h6V7H9zm0 4v2h6v-2H9z"/>
                </svg>
                <span>Bookings</span>
            </a>
            <a class="hotel-sidebar-link @adminPaymentsActive"
               asp-controller="AdminPayments"
               asp-action="Index"
               title="Payment records">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 6h18v12H3V6zm2 2v8h14V8H5zm2 2h4v2H7v-2zm6 0h4v2h-4v-2zm-6 3h10v2H7v-2z"/>
                </svg>
                <span>Payments</span>
            </a>
            @if (isAdminManager)
            {
            <a class="hotel-sidebar-link @adminFlushLogsActive"
               asp-controller="AdminFlushLogs"
               asp-action="Index"
               title="System audit log">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 3h9l5 5v13H6V3zm8 1.5V9h4.5L14 4.5zM8 12h8v2H8v-2zm0 4h8v2H8v-2z"/>
                </svg>
                <span>Audit log</span>
            </a>
            }
            <a class="hotel-sidebar-link @adminOffersActive"
               asp-controller="AdminSpecialOffers"
               asp-action="Index"
               title="Special offers">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58s1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41s-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
                </svg>
                <span>Offers</span>
            </a>
            @if (isAdminManager)
            {
                <a class="hotel-sidebar-link @adminUsersActive"
                   asp-controller="AdminUsers"
                   asp-action="Index"
                   title="Staff users">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-3.3 0-6 1.7-6 3.8V20h12v-2.2c0-2.1-2.7-3.8-6-3.8zM19 8h-2v2h-2v2h2v2h2v-2h2v-2h-2z"/>
                    </svg>
                    <span>Users</span>
                </a>
                <a class="hotel-sidebar-link @privacyActive"
                   asp-controller="Home"
                   asp-action="Privacy"
                   title="Integration">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z"/>
                    </svg>
                    <span>Integration</span>
                </a>
            }
        </nav>
    </aside>

    <div class="hotel-content">
        <header class="hotel-topbar">
            <button type="button"
                    class="hotel-sidebar-toggle"
                    id="sidebarToggle"
                    aria-controls="hotelSidebar"
                    aria-expanded="false"
                    aria-label="Open navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <div class="hotel-topbar-title">
                <span class="hotel-topbar-eyebrow">Mori International Hotel<sup class="hotel-brand-trademark">™</sup> · Admin</span>
                <strong>@(ViewData["Title"] ?? "Dashboard")</strong>
            </div>
            <div class="hotel-topbar-actions">
                <div class="admin-notification" data-admin-notification>
                    <button type="button"
                            class="admin-notification-bell"
                            data-notification-toggle
                            aria-label="Open booking notifications"
                            aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 22a2.5 2.5 0 0 0 2.35-1.65h-4.7A2.5 2.5 0 0 0 12 22zm7-6.5-1.5-1.9V9a5.5 5.5 0 0 0-4.5-5.4V2h-2v1.6A5.5 5.5 0 0 0 6.5 9v4.6L5 15.5V18h14v-2.5z"/>
                        </svg>
                        <span class="admin-notification-badge" data-notification-badge hidden>0</span>
                    </button>
                    <div class="admin-notification-panel" data-notification-panel hidden>
                        <div class="admin-notification-head">
                            <strong>New bookings</strong>
                            <div class="admin-notification-actions">
                                <button type="button" data-notification-clear title="Mark all notifications as read">Clear all</button>
                                <button type="button" data-notification-sound aria-pressed="false">Sound on</button>
                            </div>
                        </div>
                        <div class="admin-notification-items" data-notification-items>
                            <p>Loading…</p>
                        </div>
                        <a asp-controller="AdminBookings" asp-action="Index" class="admin-notification-view-all">
                            View all bookings
                        </a>
                    </div>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="admin-profile-menu" data-profile-menu>
                        <button type="button"
                                class="admin-profile-toggle"
                                data-profile-toggle
                                aria-expanded="false"
                                aria-label="Open account menu">
                            <span class="admin-profile-avatar" aria-hidden="true">
                                @(string.IsNullOrWhiteSpace(userDisplayName) ? "A" : userDisplayName[0].ToString().ToUpperInvariant())
                            </span>
                            <span class="admin-profile-text">
                                <strong>@userDisplayName</strong>
                                @if (!string.IsNullOrWhiteSpace(userEmail))
                                {
                                    <small>@userEmail</small>
                                }
                            </span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7 10l5 5 5-5z" />
                            </svg>
                        </button>
                        <div class="admin-profile-panel" data-profile-panel hidden>
                            <div class="admin-profile-brand">
                                <img src="~/Images/Logo.png" asp-append-version="true" alt="" class="admin-profile-brand-logo" />
                                <div class="admin-profile-brand-copy">
                                    <strong>Mori International Hotel<sup class="hotel-brand-trademark">™</sup></strong>
                                    <small>Staff portal</small>
                                </div>
                            </div>
                            <a asp-controller="Account" asp-action="Settings" class="admin-profile-link">
                                Edit profile &amp; security
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="admin-profile-logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-profile-link admin-profile-link-danger">Log out</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </header>

        <main role="main" class="hotel-main">
            @RenderBody()
        </main>

        <footer class="hotel-footer">
            &copy; 2026 - Mori International Hotel<sup class="hotel-brand-trademark">™</sup>
            @if (isAdminManager)
            {
                <text> - </text>
                <a asp-controller="Home" asp-action="Privacy">Integration</a>
            }
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/admin-realtime.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/mori-input-filters.js" asp-append-version="true"></script>
    @if (needsPhotoZoom)
    {
        <script src="~/js/photo-zoom.js" asp-append-version="true"></script>
    }
    <div id="adminAntiForgery" hidden>@Html.AntiForgeryToken()</div>
    <div class="admin-export-loading" data-admin-export-loading hidden>
        <div class="admin-export-loading-card" role="status" aria-live="assertive" aria-atomic="true" tabindex="-1">
            <div class="admin-export-loading-spinner" aria-hidden="true"></div>
            <strong data-admin-export-loading-title>Exporting data…</strong>
            <p data-admin-export-loading-detail>Building PDF softcopy — please wait.</p>
            <span class="admin-export-loading-dots" aria-hidden="true">
                <i></i><i></i><i></i>
            </span>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(adminBookingsActive))
    {
        <script>
            window.__adminBookingsAssets = {
                fullCalendar: [
                    '@Url.Content("~/lib/fullcalendar/core.min.js")',
                    '@Url.Content("~/lib/fullcalendar/daygrid.min.js")',
                    '@Url.Content("~/lib/fullcalendar/list.min.js")'
                ],
                tesseract: 'https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js'
            };
        </script>
        <script src="~/js/admin-bookings.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/admin-notifications.js" asp-append-version="true"></script>
    }
    <script src="~/js/mori-notice.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const shell = document.body;
            const toggle = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('sidebarBackdrop');

            function setOpen(open) {
                shell.classList.toggle('sidebar-open', open);
                if (toggle) {
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
                }
                if (backdrop) {
                    backdrop.hidden = !open;
                }
            }

            toggle?.addEventListener('click', () => setOpen(!shell.classList.contains('sidebar-open')));
            backdrop?.addEventListener('click', () => setOpen(false));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
