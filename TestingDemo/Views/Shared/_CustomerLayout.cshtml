@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isBookingHome = string.Equals(controller, "Booking", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    var isAccommodations = string.Equals(controller, "Booking", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Accommodations", StringComparison.OrdinalIgnoreCase);
    var isStaffAuth = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
        || string.Equals(controller, "Staff", StringComparison.OrdinalIgnoreCase)
        || string.Equals(controller, "GoogleVerification", StringComparison.OrdinalIgnoreCase);
    var immersive = ViewData["GuestImmersive"] as bool? == true || isAccommodations;
    var isAuthPage = ViewData["GuestAuthPage"] as bool? == true || isStaffAuth;
    var isAuthLogin = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(action, "Login", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action, "ConfirmGuestAgreement", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action, "ConfirmStaffIdentity", StringComparison.OrdinalIgnoreCase));
    var isDarkPage = ViewData["GuestDarkPage"] as bool? == true
        || string.Equals(action, "NotFoundPage", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action, "NotFound", StringComparison.OrdinalIgnoreCase);
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var isStaffOnGuest = isSignedIn
        && (User.IsInRole(TestingDemo.Models.AppRoles.AdminManager)
            || User.IsInRole(TestingDemo.Models.AppRoles.Receptionist));
    var profileDisplayName = User.Identity?.Name ?? "Guest";
    if (profileDisplayName.StartsWith("guest.", StringComparison.OrdinalIgnoreCase))
        profileDisplayName = profileDisplayName["guest.".Length..];
    var shellClass = isDarkPage
        ? "guest-shell guest-shell--dark-page guest-shell--full-bleed"
        : (isAuthLogin
            ? "guest-shell guest-shell--auth guest-shell--auth-login"
            : (isAuthPage
                ? "guest-shell guest-shell--auth"
                : (isAccommodations
                    ? "guest-shell guest-shell--immersive guest-shell--rooms guest-shell--clay"
                    : (immersive ? "guest-shell guest-shell--immersive" : "guest-shell"))));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mori International Hotel</title>
    <link rel="icon" type="image/png" href="~/Images/Logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/Images/Logo.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestingDemo.styles.css" asp-append-version="true" />
</head>
<body class="@shellClass">
    <header class="guest-nav" id="guestNav">
        <div class="guest-nav-inner">
            <a class="guest-brand" asp-controller="Booking" asp-action="Index" title="Mori International Hotel">
                <img src="~/Images/Logo.png" asp-append-version="true" alt="" class="guest-brand-logo" />
                <span class="guest-brand-name" data-i18n="nav.brand">Mori International Hotel</span>
            </a>

            <nav class="guest-nav-links" id="guestNavLinks" aria-label="Guest navigation">
                @if (isBookingHome)
                {
                    <a href="#about">
                        <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                        </svg>
                        <span data-i18n="nav.about">About</span>
                    </a>
                    <a asp-controller="Booking" asp-action="Accommodations">
                        <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z"/>
                        </svg>
                        <span data-i18n="nav.rooms">Rooms</span>
                    </a>
                    <a href="#contact">
                        <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                        </svg>
                        <span data-i18n="nav.contact">Contact</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Booking" asp-action="Index" asp-fragment="about">
                        <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                        </svg>
                        <span data-i18n="nav.about">About</span>
                    </a>
                    <a class="@(isAccommodations ? "is-active" : null)"
                       asp-controller="Booking"
                       asp-action="Accommodations">
                        <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z"/>
                        </svg>
                        <span data-i18n="nav.rooms">Rooms</span>
                    </a>
                    <a asp-controller="Booking" asp-action="Index" asp-fragment="contact">
                        <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                        </svg>
                        <span data-i18n="nav.contact">Contact</span>
                    </a>
                }
                @if (isSignedIn)
                {
                    <div class="guest-nav-profile" data-guest-profile>
                        <button type="button"
                                class="guest-nav-profile-toggle"
                                id="guestProfileToggle"
                                aria-expanded="false"
                                aria-controls="guestProfileMenu"
                                aria-haspopup="menu"
                                title="@profileDisplayName">
                            <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.28 2.01.2 5.97 1.29 6 3.28-1.29 1.94-3.5 3.22-6 3.22z"/>
                            </svg>
                            <span class="guest-nav-profile-label">@profileDisplayName</span>
                            <svg class="guest-nav-profile-caret" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M7 10l5 5 5-5z"/>
                            </svg>
                        </button>
                        <div class="guest-nav-profile-menu" id="guestProfileMenu" role="menu" hidden>
                            @if (isStaffOnGuest)
                            {
                                <a role="menuitem"
                                   class="guest-nav-profile-item"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <svg class="guest-nav-profile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                                    </svg>
                                    <span data-i18n="nav.staffPanel">Staff panel</span>
                                </a>
                            }
                            else
                            {
                                <a role="menuitem"
                                   class="guest-nav-profile-item"
                                   asp-controller="GuestPortal"
                                   asp-action="Reviews">
                                    <svg class="guest-nav-profile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                    </svg>
                                    <span data-i18n="nav.reviews">Reviews</span>
                                </a>
                                <a role="menuitem"
                                   class="guest-nav-profile-item"
                                   asp-controller="GuestPortal"
                                   asp-action="BookingHistory">
                                    <svg class="guest-nav-profile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/>
                                    </svg>
                                    <span data-i18n="nav.bookingHistory">Booking history</span>
                                </a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="guest-nav-profile-logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" role="menuitem" class="guest-nav-profile-item">
                                    <svg class="guest-nav-profile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                                    </svg>
                                    <span data-i18n="nav.logOut">Log out</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="@(isStaffAuth ? "is-active" : null)"
                       asp-controller="Account"
                       asp-action="Login"
                       title="Sign In or Join">
                        <svg class="guest-nav-item-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.28 2.01.2 5.97 1.29 6 3.28-1.29 1.94-3.5 3.22-6 3.22z"/>
                        </svg>
                        <span data-i18n="nav.signInJoin">Sign In or Join</span>
                    </a>
                }
            </nav>

            <div class="guest-lang-nav" data-guest-lang-nav></div>

            <a class="guest-nav-cta"
               asp-controller="Booking"
               asp-action="Accommodations"
               asp-fragment="rooms">
                <svg class="guest-nav-cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zm-7 5h5v5h-5z"/>
                </svg>
                <span data-i18n="nav.bookStay">Book a stay</span>
            </a>

            <button type="button"
                    class="guest-nav-toggle"
                    id="guestNavToggle"
                    aria-controls="guestNavLinks"
                    aria-expanded="false"
                    aria-label="Open menu"
                    data-i18n="lang.openMenu"
                    data-i18n-attr="aria-label"
                    data-i18n-attr-only>
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </header>

    <main class="guest-main @(isAuthPage ? "guest-main--auth" : null)">
        @RenderBody()
    </main>

    <footer class="guest-footer">
        <div class="guest-footer-inner">
            <p class="guest-footer-copy" data-i18n="footer.copy">
                © Mori International Hotel, Mandaue City, Cebu · 2026, Official site
            </p>
        </div>
    </footer>

    <div class="guest-toast" id="guestToast" hidden role="status" aria-live="polite"></div>

    <div class="guest-lang-popup" data-guest-lang-popup hidden>
        <div class="guest-lang-popup-card" role="dialog" aria-modal="true" aria-labelledby="guestLangTitle">
            <h2 id="guestLangTitle" data-i18n="lang.title">Choose your language</h2>
            <p data-i18n="lang.lede">You can change this anytime from the top menu.</p>
            <div class="guest-lang-options" data-guest-lang-options></div>
            <div class="guest-lang-popup-actions">
                <button type="button" class="guest-btn guest-btn-primary" data-guest-lang-continue data-i18n="lang.continue">Continue</button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/guest-i18n.js" asp-append-version="true"></script>
    <script src="~/js/photo-zoom.js" asp-append-version="true"></script>
    <script src="~/js/mori-input-filters.js" asp-append-version="true"></script>
    <script src="~/js/booking-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
