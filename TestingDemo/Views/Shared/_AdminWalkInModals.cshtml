@* Guest-side booking modal UI recycled for admin walk-in *@
<div class="guest-modal" id="walkInSourceModal" data-walkin-source-modal hidden>
    <div class="guest-modal-backdrop" data-walkin-source-close></div>
    <div class="guest-modal-dialog guest-modal-dialog-walkin guest-modal-dialog-source" role="dialog" aria-modal="true" aria-labelledby="walkInSourceTitle">
        <button type="button" class="guest-modal-close" data-walkin-source-close aria-label="Close">&times;</button>
        <header class="guest-book-modal-head">
            <p class="guest-eyebrow">Front desk</p>
            <h2 id="walkInSourceTitle">Create booking</h2>
            <p class="guest-modal-lede">
                Select the booking source. Named OTAs (Agoda, Expedia, RedDoorz) use standard rates. <strong>Other OTA</strong> can optionally use a special offer when selected by staff.
            </p>
        </header>
        <div class="guest-form is-source-form">
            <section class="guest-book-section is-source">
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    </span>
                    <div>
                        <h3>Booking channel</h3>
                        <p>Select where this reservation originated.</p>
                    </div>
                </div>
                <div class="guest-form-grid">
                    <label>
                        <span>Booking channel</span>
                        <select id="walkInSourceSelect">
                            <option value="WalkIn" selected>Walk-in (Eligible for promos)</option>
                            <option value="Agoda">Agoda (Third-party)</option>
                            <option value="Expedia">Expedia (Third-party)</option>
                            <option value="RedDoorz">RedDoorz (Third-party)</option>
                            <option value="OtherThirdParty">Other OTA (Promo opt-in)</option>
                        </select>
                    </label>
                </div>
            </section>

            <div class="guest-modal-actions guest-book-modal-actions">
                <button type="button" class="guest-btn guest-btn-ghost" data-walkin-source-close>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    Cancel
                </button>
                <button type="button" class="guest-btn guest-btn-primary" id="walkInSourceNextBtn">
                    Continue
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="guest-modal" id="walkInGuestsModal" data-walkin-guests-modal hidden>
    <div class="guest-modal-backdrop" data-walkin-close></div>
    <div class="guest-modal-dialog guest-modal-dialog-guests guest-modal-dialog-walkin" role="dialog" aria-modal="true" aria-labelledby="walkInGuestsTitle">
        <button type="button" class="guest-modal-close" data-walkin-close aria-label="Close">&times;</button>
        <header class="guest-guests-head">
            <h2 id="walkInGuestsTitle">Walk-in guests</h2>
            <p class="guest-guests-rule">Each room holds up to 2 guests included. Each room may add one extra guest (3 total) for ₱200 / night. Children under 12 must stay with an adult.</p>
        </header>
        <div class="guest-guests-list" id="walkInGuestsRoomList" aria-live="polite"></div>
        <p class="guest-capacity-banner" id="walkInGuestsCapacityBanner" role="status" hidden></p>
        <p class="guest-guests-hint" id="walkInGuestsHint" hidden></p>
        <footer class="guest-guests-footer">
            <button type="button" class="guest-btn guest-btn-ghost" id="walkInGuestsAddRoomBtn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Add room
            </button>
            <button type="button" class="guest-btn guest-btn-primary" id="walkInGuestsSubmitBtn">
                Continue
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
        </footer>
    </div>
</div>

<div class="guest-modal" id="walkInBookModal" data-walkin-book-modal hidden>
    <div class="guest-modal-backdrop" data-walkin-close></div>
    <div class="guest-modal-dialog guest-modal-dialog-lg guest-modal-dialog-book guest-modal-dialog-walkin" role="dialog" aria-modal="true" aria-labelledby="walkInBookTitle">
        <button type="button" class="guest-modal-close" data-walkin-close aria-label="Close">&times;</button>

        <header class="guest-book-modal-head">
            <div class="admin-walkin-heading">
                <p class="guest-eyebrow">Front desk</p>
                <h2 id="walkInBookTitle">Walk-in check-in</h2>
            </div>
            <ol class="admin-walkin-path-flow" id="walkInBookStepList" aria-label="Create booking steps">
                <li>
                    <button type="button" class="is-current" data-walkin-step-tab="guest" aria-current="step">
                        <span class="admin-walkin-step-number" aria-hidden="true">1</span>
                        <span>Guest</span>
                    </button>
                </li>
                <li>
                    <button type="button" data-walkin-step-tab="dates">
                        <span class="admin-walkin-step-number" aria-hidden="true">2</span>
                        <span>Dates</span>
                    </button>
                </li>
                <li>
                    <button type="button" data-walkin-step-tab="types">
                        <span class="admin-walkin-step-number" aria-hidden="true">3</span>
                        <span>Room type</span>
                    </button>
                </li>
            </ol>
            <p class="guest-book-party" id="walkInBookPartySummary"></p>
        </header>

        <form class="guest-form guest-book-modal-form is-wizard" id="walkInBookForm" novalidate data-walkin-step="guest">
            @Html.AntiForgeryToken()

            <div class="admin-walkin-scroll-body">
            <section class="guest-book-section is-guest is-wizard-panel" data-walkin-step-panel="guest">
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">1</span>
                    <div>
                        <h3>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            Guest details
                        </h3>
                        <p>Lead guest contact for this walk-in.</p>
                    </div>
                </div>
                <div class="guest-form-grid">
                    <label>
                        <span>Full name</span>
                        <input type="text" name="guestName" id="walkInGuestName" placeholder="Guest full name" required maxlength="120" autocomplete="name" data-mori-filter="person-name" />
                    </label>
                    <label>
                        <span>Email</span>
                        <input type="email" name="guestEmail" id="walkInGuestEmail" placeholder="name@email.com" required maxlength="254" autocomplete="email" data-mori-filter="email" />
                    </label>
                    <label>
                        <span>Phone</span>
                        <input type="tel" name="guestPhone" id="walkInGuestPhone" placeholder="+63 9XX XXX XXXX" required maxlength="40" autocomplete="tel" inputmode="tel" data-mori-filter="phone" />
                    </label>
                </div>

                <div class="guest-field admin-walkin-channel-field" hidden>
                    <label for="walkInChannel" class="form-label">Booking channel</label>
                    <select id="walkInChannel" class="form-select" required>
                        <option value="" selected>Select channel…</option>
                        <option value="WalkIn">Walk-in</option>
                        <option value="Agoda">Agoda</option>
                        <option value="Expedia">Expedia</option>
                        <option value="RedDoorz">RedDoorz</option>
                        <option value="OtherThirdParty">Other OTA</option>
                    </select>
                    <div class="form-text">Required. Agoda, Expedia, and RedDoorz use standard OTA rates. Other OTA can optionally apply a special offer.</div>
                </div>

                <div class="guest-field admin-walkin-arrival-field">
                    <label for="walkInArrivalDiscount" class="form-label">Senior / PWD (flag for arrival)</label>
                    <select id="walkInArrivalDiscount" class="form-select">
                        <option value="None" selected>None</option>
                        <option value="SeniorCitizen">Senior Citizen — 20% off (verify ID on arrival)</option>
                        <option value="Pwd">PWD — 20% off (verify ID on arrival)</option>
                    </select>
                    <div class="form-text" id="walkInArrivalDiscountHint">Walk-in channel: 20% off stay when selected (verify ID on arrival). Not combinable with promo rates.</div>
                </div>
            </section>

            <section class="guest-book-section is-dates is-wizard-panel" data-walkin-step-panel="dates" hidden>
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">2</span>
                    <div>
                        <h3>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                            Stay dates
                        </h3>
                        <p>Philippines time. Early check-in and late check-out fees apply per room.</p>
                    </div>
                </div>
                <div class="guest-form-grid guest-form-grid-2">
                    <label>
                        <span>Check-in date</span>
                        <input type="date" name="modalCheckIn" id="walkInCheckInDate" required class="guest-date-picker" />
                    </label>
                    <label>
                        <span>Check-out date</span>
                        <input type="date" name="modalCheckOut" id="walkInCheckOutDate" required class="guest-date-picker" />
                    </label>
                </div>
                <div class="guest-form-grid guest-form-grid-2 guest-time-grid">
                    <label>
                        <span>Check-in time</span>
                        <select name="modalCheckInTime" id="walkInCheckInTime" class="guest-time-select"></select>
                    </label>
                    <label>
                        <span>Check-out time</span>
                        <select name="modalCheckOutTime" id="walkInCheckOutTime" class="guest-time-select"></select>
                    </label>
                </div>
                <p class="guest-time-fees" id="walkInTimeFeesHint" hidden></p>
            </section>

            <section class="guest-book-section is-types is-wizard-panel" data-walkin-step-panel="types" hidden>
                <div class="guest-book-section-head">
                    <span class="guest-book-section-num">3</span>
                    <div>
                        <h3>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 21V8l9-5 9 5v13"/><path d="M9 21v-6h6v6"/></svg>
                            Select room type
                        </h3>
                        <p id="walkInTypesLede">Choose a room type for each room in the party. Prices shown are per night.</p>
                    </div>
                </div>
                <p class="guest-availability-notice" id="walkInTypesAvailabilityNotice" data-walkin-availability-notice role="status" hidden></p>
                <p class="guest-room-capacity-msg" id="walkInCapacityWarn" hidden></p>
                <div class="admin-walkin-types-layout">
                    <div class="admin-walkin-type-picker" id="walkInRoomTypePicker" aria-live="polite"></div>
                </div>
            </section>

            <p class="guest-form-message" id="walkInFormMessage" hidden></p>
            </div>

            <div class="guest-modal-actions guest-book-modal-actions guest-book-wizard-actions">
                <button type="button" class="guest-btn guest-btn-ghost" id="walkInWizardBackBtn">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                    Back
                </button>
                <button type="button" class="guest-btn guest-btn-primary" id="walkInWizardNextBtn">
                    Next
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
                <button type="submit" class="guest-btn guest-btn-primary guest-btn-lg" id="walkInSubmitBtn" hidden>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    Create booking
                </button>
                <button type="button" class="guest-btn guest-btn-ghost" data-walkin-close>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    Cancel
                </button>
                <button type="button" id="walkInTypeSelectionProgress" class="admin-walkin-selection-progress" aria-haspopup="dialog" aria-controls="walkInSelectionDialog" aria-live="polite" hidden>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
                    <span data-progress-text>0 of 0 selected</span>
                </button>
            </div>
        </form>
    </div>
</div>

<dialog id="walkInTypeQuantityDialog" class="admin-walkin-quantity-dialog" aria-labelledby="walkInTypeQuantityTitle" aria-describedby="walkInTypeQuantityHint">
    <form id="walkInTypeQuantityForm" novalidate>
        <header>
            <h2 class="admin-walkin-quantity-heading">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
                <span id="walkInTypeQuantityTitle">Choose room quantity</span>
            </h2>
            <button type="button" class="admin-walkin-quantity-close" data-walkin-quantity-close aria-label="Close quantity picker">&times;</button>
        </header>
        <p id="walkInTypeQuantityHint"></p>
        <label for="walkInTypeQuantity">Number of rooms</label>
        <div class="admin-walkin-quantity-control">
            <button type="button" data-walkin-quantity-minus aria-label="Decrease room quantity">−</button>
            <input id="walkInTypeQuantity" type="number" min="1" max="8" step="1" value="1" required inputmode="numeric" aria-describedby="walkInTypeQuantityHint walkInTypeQuantityError" />
            <button type="button" data-walkin-quantity-plus aria-label="Increase room quantity">+</button>
        </div>
        <p id="walkInTypeQuantityError" class="guest-form-message is-error" role="alert" hidden></p>
        <footer>
            <button type="button" class="guest-btn guest-btn-ghost" data-walkin-quantity-close>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                Cancel
            </button>
            <button type="submit" class="guest-btn guest-btn-primary" id="walkInTypeQuantityConfirm">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span data-quantity-label>Add rooms</span>
            </button>
        </footer>
    </form>
</dialog>

<dialog id="walkInSelectionDialog" class="admin-walkin-quantity-dialog admin-walkin-selection-dialog" aria-labelledby="walkInSelectionTitle" aria-describedby="walkInSelectionHint">
    <div class="admin-walkin-selection-body">
        <header>
            <h2 id="walkInSelectionTitle" class="admin-walkin-quantity-heading">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span>Selection progress</span>
            </h2>
            <button type="button" class="admin-walkin-quantity-close" data-walkin-selection-close aria-label="Close selection progress">&times;</button>
        </header>
        <p id="walkInSelectionHint">Draft only — nothing is booked until confirmation. Edit or remove a pick below.</p>
        <div class="admin-walkin-selection-meter">
            <p class="admin-walkin-selection-count" id="walkInSelectionCount">0 of 0 rooms selected</p>
            <div class="admin-walkin-selection-bar" aria-hidden="true"><span id="walkInSelectionBarFill"></span></div>
        </div>
        <div class="admin-walkin-selection-groups" id="walkInSelectionGroups" hidden>
            <h3>Selected room types</h3>
            <ul id="walkInSelectionTypes" aria-label="Selected room types"></ul>
        </div>
        <div class="admin-walkin-selection-rooms">
            <h3>Rooms in this draft</h3>
            <ul id="walkInTypeSelectionSummary" aria-label="Selected and unselected rooms"></ul>
        </div>
        <footer>
            <button type="button" class="guest-btn guest-btn-primary" data-walkin-selection-close>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                Done
            </button>
        </footer>
    </div>
</dialog>

