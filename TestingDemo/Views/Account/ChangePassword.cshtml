@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = Model.IsFirstPasswordSetup ? "Create password" : "Change password";
    ViewData["I18nTitle"] = Model.IsFirstPasswordSetup ? "auth.setPasswordTitle" : "auth.changeTitle";
    ViewData["GuestAuthPage"] = true;
}
@model TestingDemo.ViewModels.ChangePasswordViewModel

<section class="guest-auth" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-media" aria-hidden="true">
        <img src="~/Images/Hallways/Hallway2.jpg"
             asp-append-version="true"
             alt=""
             decoding="async"
             fetchpriority="high" />
        <div class="guest-auth-media-veil"></div>
        <div class="guest-auth-media-caption">
            <span class="guest-auth-crest-badge">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="14" height="14">
                    <path fill="currentColor" d="M12 2L2 7l10 5 10-5-10-5zm0 8.5L4.5 7 12 3.25 19.5 7 12 10.5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
                <span data-i18n="auth.securityEyebrow">Security</span>
            </span>
            <span class="guest-brand-mark">Mori International Hotel</span>
            <span class="guest-auth-subcaption"
                  data-i18n="@(Model.IsFirstPasswordSetup ? "auth.setPasswordCaption" : "auth.securityCaption")">
                @(Model.IsFirstPasswordSetup ? "Create a password for your guest account" : "Secure your staff account")
            </span>
        </div>
    </div>

    <div class="guest-auth-panel">
        <div class="guest-auth-header">
            <p class="guest-eyebrow" data-i18n="auth.securityEyebrow">Security</p>
            @if (Model.IsFirstPasswordSetup)
            {
                <h1 id="guestAuthTitle" data-i18n="auth.setPasswordTitle">Create your password</h1>
                <p class="guest-section-copy guest-auth-lede" data-i18n="auth.setPasswordLede">
                    Your Google email is fixed on this account. You can change your username, then choose a password for email or username sign-in.
                </p>
            }
            else
            {
                <h1 id="guestAuthTitle" data-i18n="auth.changeTitle">Change password</h1>
                <p class="guest-section-copy guest-auth-lede" data-i18n="auth.changeLede">
                    Set a new password before using admin tools. Temporary passwords cannot be reused.
                </p>
            }
        </div>

        <form asp-controller="Account" asp-action="ChangePassword" method="post" class="guest-form guest-auth-form" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsFirstPasswordSetup" />

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="ModelOnly" class="guest-form-message is-error" role="alert"></div>
            }

            @if (Model.IsFirstPasswordSetup)
            {
                <div class="guest-field">
                    <label for="GuestEmail">
                        <span data-i18n="auth.emailAddress">Email address</span>
                    </label>
                    <div class="guest-input-wrapper">
                        <input id="GuestEmail"
                               type="email"
                               value="@Model.Email"
                               readonly
                               aria-readonly="true"
                               autocomplete="email" />
                    </div>
                </div>
                <div class="guest-field">
                    <label for="UserName">
                        <span data-i18n="auth.guestUsername">Username</span>
                    </label>
                    <div class="guest-input-wrapper">
                        <input asp-for="UserName"
                               id="UserName"
                               type="text"
                               autocomplete="username"
                               maxlength="64"
                               spellcheck="false"
                               aria-required="true"
                               data-mori-filter="login-id" />
                    </div>
                    <span asp-validation-for="UserName" class="guest-form-message is-error"></span>
                    <p class="guest-auth-hint" data-i18n="auth.setPasswordHint">
                        You can change this username. Email stays fixed from Google. Use either on the sign-in page.
                    </p>
                </div>
            }
            else
            {
                <div class="guest-field">
                    <label for="CurrentPassword">
                        <span data-i18n="auth.currentPassword">Current password</span>
                    </label>
                    <div class="guest-input-wrapper guest-password-group">
                        <input asp-for="CurrentPassword" id="CurrentPassword" type="password" autocomplete="current-password" aria-required="true" />
                        <button type="button" class="guest-password-toggle" data-password-toggle="CurrentPassword" aria-label="Show password" aria-pressed="false" title="Show password">
                            <svg class="icon-eye-show" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18">
                                <path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                            </svg>
                            <svg class="icon-eye-hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" hidden>
                                <path fill="currentColor" d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-2.28 2.2 2.2c.08-.24.16-.48.16-.72 0-1.66-1.34-3-3-3-.24 0-.48.08-.72.16z"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="guest-form-message is-error"></span>
                </div>
            }

            <div class="guest-field">
                <label for="NewPassword">
                    <span data-i18n="@(Model.IsFirstPasswordSetup ? "auth.password" : "auth.newPassword")">
                        @(Model.IsFirstPasswordSetup ? "Password" : "New password")
                    </span>
                </label>
                <div class="guest-input-wrapper guest-password-group">
                    <input asp-for="NewPassword" id="NewPassword" type="password" autocomplete="new-password" aria-required="true" />
                    <button type="button" class="guest-password-toggle" data-password-toggle="NewPassword" aria-label="Show password" aria-pressed="false" title="Show password">
                        <svg class="icon-eye-show" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18">
                            <path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                        </svg>
                        <svg class="icon-eye-hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" hidden>
                            <path fill="currentColor" d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-2.28 2.2 2.2c.08-.24.16-.48.16-.72 0-1.66-1.34-3-3-3-.24 0-.48.08-.72.16z"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="guest-form-message is-error"></span>
            </div>

            <div class="guest-field">
                <label for="ConfirmPassword">
                    <span data-i18n="auth.confirmPassword">Confirm new password</span>
                </label>
                <div class="guest-input-wrapper guest-password-group">
                    <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" aria-required="true" />
                    <button type="button" class="guest-password-toggle" data-password-toggle="ConfirmPassword" aria-label="Show password" aria-pressed="false" title="Show password">
                        <svg class="icon-eye-show" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18">
                            <path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                        </svg>
                        <svg class="icon-eye-hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" hidden>
                            <path fill="currentColor" d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-2.28 2.2 2.2c.08-.24.16-.48.16-.72 0-1.66-1.34-3-3-3-.24 0-.48.08-.72.16z"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="guest-form-message is-error"></span>
            </div>

            <div class="guest-form-actions guest-auth-actions">
                <button type="submit"
                        class="guest-btn guest-btn-primary"
                        data-i18n="@(Model.IsFirstPasswordSetup ? "auth.savePassword" : "auth.updatePassword")">
                    @(Model.IsFirstPasswordSetup ? "Save password" : "Update password")
                </button>
            </div>
        </form>
    </div>
</section>
