@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Confirm identity";
    ViewData["GuestAuthPage"] = true;
}
@model TestingDemo.ViewModels.ConfirmStaffIdentityViewModel

<section class="guest-auth-login" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-login-bg" aria-hidden="true">
        <img src="~/Images/Lounge/Lounge1.jpg"
             asp-append-version="true"
             alt=""
             decoding="async"
             fetchpriority="high" />
        <div class="guest-auth-login-veil"></div>
    </div>

    <div class="guest-auth-login-stage">
        <div class="guest-auth-card">
            <div class="guest-auth-card-accent" aria-hidden="true"></div>

            <header class="guest-auth-card-header">
                <h1 id="guestAuthTitle">Confirm your identity</h1>
                <p class="guest-auth-card-lede">
                    This Google account is the recovery email for a staff login. Confirm to continue as staff — no password needed.
                </p>
            </header>

            <dl class="guest-auth-confirm-meta">
                <div>
                    <dt>Account</dt>
                    <dd>@Model.DisplayName</dd>
                </div>
                <div>
                    <dt>Role</dt>
                    <dd>@Model.RoleName</dd>
                </div>
                <div>
                    <dt>Google email</dt>
                    <dd>@Model.GoogleEmail</dd>
                </div>
            </dl>

            <form asp-controller="Account"
                  asp-action="ConfirmStaffIdentity"
                  method="post"
                  class="guest-auth-card-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <button type="submit" name="confirm" value="true" class="guest-auth-submit">
                    <span>Yes, continue as staff</span>
                </button>

                <button type="submit" name="confirm" value="false" class="guest-btn guest-btn-ghost guest-auth-google">
                    <span>Cancel</span>
                </button>
            </form>
        </div>
    </div>
</section>
