@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Check your email";
    ViewData["GuestAuthPage"] = true;
}

<section class="guest-auth-login" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-login-bg" aria-hidden="true">
        <img src="~/Images/Lounge/Lounge1.jpg"
             asp-append-version="true"
             alt=""
             decoding="async" />
        <div class="guest-auth-login-veil"></div>
    </div>

    <div class="guest-auth-login-stage">
        <div class="guest-auth-card">
            <div class="guest-auth-card-accent" aria-hidden="true"></div>
            <header class="guest-auth-card-header">
                <h1 id="guestAuthTitle" data-i18n="auth.forgotSentTitle">Check your email</h1>
                <p class="guest-auth-card-lede" data-i18n="auth.forgotSentLede">
                    If an account exists for that address, we sent a password reset notice. The link lasts one hour and works only once. After you change your password it cannot be opened again.
                </p>
            </header>

            <a class="guest-auth-back"
               asp-controller="Account"
               asp-action="Login"
               data-i18n="auth.backToSignIn">
                Back to sign in
            </a>
        </div>
    </div>
</section>
