@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Reset link unavailable";
    ViewData["GuestAuthPage"] = true;
}

<section class="guest-auth-login" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-login-bg" aria-hidden="true">
        <img src="~/Images/Lounge/Lounge1.jpg"
             asp-append-version="true"
             alt=""
             decoding="async" />
        <div class="guest-auth-login-veil"></div>
    </div>

    <div class="guest-auth-login-stage">
        <div class="guest-auth-card">
            <div class="guest-auth-card-accent" aria-hidden="true"></div>
            <header class="guest-auth-card-header">
                <h1 id="guestAuthTitle">This reset link is no longer valid</h1>
                <p class="guest-auth-card-lede">
                    The password reset link has already been used, has expired, or is not valid.
                    After a password is changed, the same link cannot be opened again — including on this device.
                </p>
            </header>

            <a class="guest-auth-back"
               asp-controller="Account"
               asp-action="ForgotPassword">
                Request a new reset link
            </a>
            <a class="guest-auth-back"
               asp-controller="Account"
               asp-action="Login">
                Back to sign in
            </a>
        </div>
    </div>
</section>
