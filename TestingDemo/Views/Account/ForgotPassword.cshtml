@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Forgot password";
    ViewData["GuestAuthPage"] = true;
}
@model TestingDemo.ViewModels.ForgotPasswordViewModel

<section class="guest-auth-login" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-login-bg" aria-hidden="true">
        <img src="~/Images/Lounge/Lounge1.jpg"
             asp-append-version="true"
             alt=""
             decoding="async"
             fetchpriority="high" />
        <div class="guest-auth-login-veil"></div>
    </div>

    <div class="guest-auth-login-stage">
        <div class="guest-auth-card">
            <div class="guest-auth-card-accent" aria-hidden="true"></div>
            <header class="guest-auth-card-header">
                <h1 id="guestAuthTitle" data-i18n="auth.forgotTitle">Reset password</h1>
                <p class="guest-auth-card-lede" data-i18n="auth.forgotLede">
                    Enter the email on your staff account. If it matches, we send a 6-digit verification code.
                </p>
            </header>

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post"
                  class="guest-auth-card-form"
                  id="staffForgotPasswordForm"
                  novalidate>
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="guest-form-message is-error" role="alert"></div>
                }

                <div class="guest-auth-field">
                    <label asp-for="Email" class="guest-auth-field-label">
                        <span data-i18n="auth.emailAddress">EMAIL ADDRESS</span>
                    </label>
                    <input asp-for="Email"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="name@example.com"
                           aria-required="true"
                           data-mori-filter="email"
                           maxlength="254" />
                    <span asp-validation-for="Email" class="guest-form-message is-error"></span>
                </div>

                <button type="submit" class="guest-auth-submit" id="staffForgotPasswordSubmit">
                    <span data-i18n="auth.forgotSubmit">Send verification code</span>
                </button>
            </form>

            <a class="guest-auth-back"
               asp-controller="Account"
               asp-action="Login"
               data-i18n="auth.backToSignIn">
                Back to sign in
            </a>
        </div>
    </div>
</section>

<div class="guest-auth-loading" id="staffForgotPasswordLoading" hidden aria-hidden="true">
    <div class="guest-auth-loading-backdrop" aria-hidden="true"></div>
    <div class="guest-auth-loading-card" role="status" aria-live="polite" aria-busy="true">
        <div class="guest-auth-loading-spinner" aria-hidden="true"></div>
        <strong data-i18n="auth.forgotLoadingTitle">Sending verification code</strong>
        <p data-i18n="auth.forgotLoadingLede">Please wait while we email your one-time code.</p>
        <span class="guest-auth-loading-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/staff-forgot-password.js" asp-append-version="true"></script>
}
