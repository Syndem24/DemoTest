@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Guest agreement";
    ViewData["GuestAuthPage"] = true;
}
@model TestingDemo.ViewModels.ConfirmGuestAgreementViewModel

<section class="guest-auth-login" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-login-bg" aria-hidden="true">
        <img src="~/Images/Lounge/Lounge1.jpg"
             asp-append-version="true"
             alt=""
             decoding="async"
             fetchpriority="high" />
        <div class="guest-auth-login-veil"></div>
    </div>

    <div class="guest-auth-login-stage">
        <div class="guest-auth-card guest-auth-card--agreement">
            <div class="guest-auth-card-accent" aria-hidden="true"></div>

            <header class="guest-auth-card-header">
                <h1 id="guestAuthTitle">Before we create your guest account</h1>
                <p class="guest-auth-card-lede">
                    Google verified <strong>@Model.Email</strong>. Please review and accept our guest commitments — we prioritize privacy and integrity.
                </p>
            </header>

            <div class="guest-auth-agreement-body">
                <h2>Privacy</h2>
                <p>
                    We use your Google email and name only to identify your guest account, support bookings, and contact you about your stay.
                    We do not sell your personal data. Staff can access booking-related details needed to operate the hotel.
                </p>
                <h2>Integrity &amp; fair use</h2>
                <p>
                    You agree to provide accurate stay details, respect house policies, and not misuse booking tools or other guests’ information.
                    Fraudulent or abusive activity may result in account or booking restrictions.
                </p>
                <h2>Account notice</h2>
                <p>
                    Accepting creates a <strong>guest-level</strong> Mori International Hotel account linked to this Google login.
                    This is not a staff account. You can log out anytime from your profile menu.
                </p>
            </div>

            <form asp-controller="Account"
                  asp-action="ConfirmGuestAgreement"
                  method="post"
                  class="guest-auth-card-form"
                  id="guestAgreementForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="RememberMe" />

                <div asp-validation-summary="ModelOnly" class="guest-form-message is-error" role="alert"></div>

                <label class="guest-check guest-auth-agree-check" for="AcceptedTerms">
                    <input asp-for="AcceptedTerms" id="AcceptedTerms" />
                    <span>I agree to the privacy, integrity, and guest account terms above.</span>
                </label>
                <span asp-validation-for="AcceptedTerms" class="guest-form-message is-error"></span>

                <button type="submit" class="guest-auth-submit" id="guestAgreementSubmit">
                    <span>Agree and continue</span>
                </button>
            </form>

            <form asp-controller="Account"
                  asp-action="DeclineGuestAgreement"
                  method="post"
                  class="guest-auth-google-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="guest-btn guest-btn-ghost guest-auth-google">
                    <span>Cancel</span>
                </button>
            </form>
        </div>
    </div>
</section>

<div class="guest-auth-loading" id="guestAgreementLoading" hidden aria-hidden="true">
    <div class="guest-auth-loading-backdrop" aria-hidden="true"></div>
    <div class="guest-auth-loading-card" role="status" aria-live="polite" aria-busy="true">
        <div class="guest-auth-loading-spinner" aria-hidden="true"></div>
        <strong>Creating your guest account</strong>
        <p>Please wait while we finish setting up your Google guest login.</p>
        <span class="guest-auth-loading-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/guest-agreement.js" asp-append-version="true"></script>
}
