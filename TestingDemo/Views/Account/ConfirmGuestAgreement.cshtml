@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Guest agreement";
    ViewData["I18nTitle"] = "agree.title";
    ViewData["GuestAuthPage"] = true;
}
@model TestingDemo.ViewModels.ConfirmGuestAgreementViewModel

<section class="guest-auth-login" aria-labelledby="guestAuthTitle">
    <div class="guest-auth-login-bg" aria-hidden="true">
        <img src="~/Images/Lounge/Lounge1.jpg"
             asp-append-version="true"
             alt=""
             decoding="async"
             fetchpriority="high" />
        <div class="guest-auth-login-veil"></div>
    </div>

    <div class="guest-auth-login-stage">
        <div class="guest-auth-card guest-auth-card--agreement">
            <div class="guest-auth-card-accent" aria-hidden="true"></div>

            <header class="guest-auth-card-header">
                <h1 id="guestAuthTitle" data-i18n="agree.title">Before we create your guest account</h1>
                <p class="guest-auth-card-lede">
                    <span data-i18n="agree.ledeBefore">Google verified </span><strong>@Model.Email</strong><span data-i18n="agree.ledeAfter">. Please read the summary below, then open the full </span>
                    <a class="guest-auth-policy-link"
                       asp-controller="Booking"
                       asp-action="Terms"
                       asp-route-from="guest-agreement"
                       data-i18n="legal.termsTitle">Terms and policies</a>
                    <span data-i18n="agree.ledeAnd"> and </span>
                    <a class="guest-auth-policy-link"
                       asp-controller="Booking"
                       asp-action="PrivacyPolicy"
                       asp-route-from="guest-agreement"
                       data-i18n="legal.privacyTitle">Privacy policy</a>
                    <span data-i18n="agree.ledeEnd"> if you want the complete text.</span>
                </p>
            </header>

            <div class="guest-auth-agreement-body" id="guestAgreementSummary">
                <h2 data-i18n="agree.dataTitle">Personal data we will use</h2>
                <p data-i18n="agree.dataBody">
                    Mori International Hotel (AS Fortuna, Mandaue City, Cebu) will use your Google name and verified email to create a guest-level account, identify you on this site, support bookings, and contact you about your stay. We do not sell your personal data. Hotel staff can see booking details needed to operate the front desk.
                </p>
                <h2 data-i18n="agree.whyTitle">Why we ask for consent</h2>
                <p data-i18n="agree.whyBody">
                    Philippine data privacy rules require consent to be freely given, specific, and informed. Ticking the box is your consent to that processing. You may press Cancel if you do not want an account. Completing a later booking is also needed so we can provide the stay you request.
                </p>
                <h2 data-i18n="agree.rulesTitle">Stay and account rules</h2>
                <p data-i18n="agree.rulesBody">
                    You agree to provide accurate stay details, respect house policies, and not misuse booking tools or other guests’ information. Check-in is 14:00 and check-out is 12:00 unless a paid early or late option is available. This account is not a staff login. You can log out anytime from your profile menu.
                </p>
                <h2 data-i18n="agree.rightsTitle">Your rights</h2>
                <p>
                    <span data-i18n="agree.rightsBodyBefore">You may ask to access or correct your data, or to withdraw this consent, by emailing </span>
                    <a class="guest-auth-policy-link" href="mailto:moriyamahotel@gmail.com">moriyamahotel@gmail.com</a>
                    <span data-i18n="agree.rightsBodyAfter">. Read the linked policies before you agree.</span>
                </p>
            </div>

            <form asp-controller="Account"
                  asp-action="ConfirmGuestAgreement"
                  method="post"
                  class="guest-auth-card-form"
                  id="guestAgreementForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="RememberMe" />

                <label class="guest-check guest-auth-agree-check" for="AcceptedTerms">
                    <input asp-for="AcceptedTerms" id="AcceptedTerms" aria-describedby="guestAgreementSummary" />
                    <span>
                        <span data-i18n="agree.checkBefore">I give my consent to personal data processing and confirm that I have read the </span>
                        <a class="guest-auth-policy-link"
                           asp-controller="Booking"
                           asp-action="Terms"
                           asp-route-from="guest-agreement"
                           data-i18n="legal.termsTitle">Terms and policies</a>
                        <span data-i18n="agree.checkMid"> and </span>
                        <a class="guest-auth-policy-link"
                           asp-controller="Booking"
                           asp-action="PrivacyPolicy"
                           asp-route-from="guest-agreement"
                           data-i18n="legal.privacyTitle">Privacy policy</a>
                        <span data-i18n="agree.checkEnd">.</span>
                    </span>
                </label>

                <button type="submit" class="guest-auth-submit" id="guestAgreementSubmit" disabled>
                    <span data-i18n="agree.continue">Agree and continue</span>
                </button>
            </form>

            <form asp-controller="Account"
                  asp-action="DeclineGuestAgreement"
                  method="post"
                  class="guest-auth-google-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="guest-btn guest-btn-ghost guest-auth-google">
                    <span data-i18n="agree.cancel">Cancel</span>
                </button>
            </form>
        </div>
    </div>
</section>

<div class="guest-auth-loading" id="guestAgreementLoading" hidden aria-hidden="true">
    <div class="guest-auth-loading-backdrop" aria-hidden="true"></div>
    <div class="guest-auth-loading-card" role="status" aria-live="polite" aria-busy="true">
        <div class="guest-auth-loading-spinner" aria-hidden="true"></div>
        <strong data-i18n="agree.loadingTitle">Creating your guest account</strong>
        <p data-i18n="agree.loadingLede">Please wait while we finish setting up your Google guest login.</p>
        <span class="guest-auth-loading-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/guest-agreement.js" asp-append-version="true"></script>
}
