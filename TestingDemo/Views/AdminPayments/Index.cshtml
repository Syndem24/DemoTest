@{
    ViewData["Title"] = "Payments";
}

<div class="admin-flush-page admin-payments-page" data-admin-payments>
    @Html.AntiForgeryToken()

    <section class="admin-flush-hero admin-payments-hero" aria-labelledby="paymentsPageTitle">
        <div class="admin-flush-hero-copy">
            <p class="admin-flush-eyebrow">Company records</p>
            <h1 id="paymentsPageTitle">Payments</h1>
            <p class="admin-flush-lede">Review posted payments for bookings and walk-ins. Record new payments from a booking’s details.</p>
        </div>
        <ul class="admin-flush-kpis" data-payments-summary aria-label="Payment totals">
            <li>
                <span>Collected</span>
                <strong>₱0.00</strong>
            </li>
            <li>
                <span>Refunded</span>
                <strong>₱0.00</strong>
            </li>
            <li>
                <span>Records</span>
                <strong>0</strong>
                <em>all methods</em>
            </li>
        </ul>
    </section>

    <section class="hotel-panel admin-bookings-panel">
    <div class="admin-payments-panel">
        <div class="admin-payments-toolbar">
            <label class="admin-booking-search">
                <span class="visually-hidden">Search payments</span>
                <input type="search" placeholder="Search receipt, booking, guest…" data-payments-search />
            </label>
            <label class="admin-payments-method-filter">
                <span class="visually-hidden">Payment method</span>
                <select data-payments-method>
                    <option value="">All methods</option>
                    <option value="Cash">Cash</option>
                    <option value="EWallet">E-wallet</option>
                    <option value="BankTransfer">Bank transfer (InstaPay)</option>
                    <option value="Card">Card (legacy)</option>
                    <option value="Maya">Maya (legacy)</option>
                    <option value="Other">Other (legacy)</option>
                </select>
            </label>
            <button type="button" class="admin-booking-refresh" data-payments-refresh>Refresh</button>
        </div>
        <p class="admin-bookings-message" data-payments-message role="status" hidden></p>
        <div class="admin-bookings-table-wrap admin-payments-table-wrap">
            <table class="admin-bookings-table admin-payments-table">
                <thead>
                    <tr>
                        <th>When (PH)</th>
                        <th>Receipt</th>
                        <th>Booking</th>
                        <th>Guest</th>
                        <th>Event</th>
                        <th>Method</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Staff</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody data-payments-list>
                    <tr><td colspan="10" class="admin-bookings-loading">Loading payments…</td></tr>
                </tbody>
            </table>
        </div>
        <nav class="admin-bookings-pagination" aria-label="Payment pages">
            <button type="button" data-payments-prev disabled>Previous</button>
            <span data-payments-page>Page 1</span>
            <button type="button" data-payments-next disabled>Next</button>
        </nav>
        <p class="admin-payments-future-note">
            Digital payments with a scanned or uploaded receipt open in a compare view (photo + references).
            New payments are still recorded from a booking’s details.
        </p>
    </div>
    </section>
</div>

<div class="admin-booking-modal" data-payment-detail-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payment-detail-close aria-label="Close payment details"></button>
    <section class="admin-booking-modal-dialog admin-payment-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentDetailTitle">
        <header class="admin-payment-detail-head">
            <div class="admin-payment-detail-head-copy">
                <p class="admin-payment-detail-kicker">Guest payment</p>
                <h2 id="paymentDetailTitle" data-payment-detail-guest>Payment details</h2>
                <div class="admin-payment-detail-stats">
                    <span class="is-receipt" data-payment-detail-receipt></span>
                    <span class="is-amount" data-payment-detail-amount-chip></span>
                    <span class="is-status" data-payment-detail-status></span>
                </div>
            </div>
            <button type="button" class="admin-payment-detail-close" data-payment-detail-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body" data-payment-detail-body>
            <p>Loading…</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payment-detail-close>Close</button>
            <button type="button" class="admin-payment-save-receipt" data-payment-save-receipt hidden>Save receipt details</button>
            <button type="button" class="admin-booking-delete" data-payment-void hidden>Refund payment</button>
        </footer>
    </section>
</div>

<div class="admin-payment-refund-overlay" data-payment-refund-modal hidden>
    <button type="button" class="admin-payment-refund-backdrop" data-payment-refund-cancel aria-label="Cancel refund"></button>
    <section class="admin-payment-refund-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentRefundTitle">
        <header class="admin-payment-refund-head">
            <div class="admin-payment-refund-head-copy">
                <p class="admin-payment-refund-kicker">Refund payment</p>
                <h2 id="paymentRefundTitle" data-payment-refund-guest>Refund this payment?</h2>
                <div class="admin-payment-refund-stats">
                    <span class="is-receipt" data-payment-refund-receipt></span>
                    <span class="is-amount" data-payment-refund-amount></span>
                </div>
            </div>
            <button type="button" class="admin-payment-refund-close" data-payment-refund-cancel aria-label="Close refund">&times;</button>
        </header>
        <div class="admin-payment-refund-body">
            <p data-payment-refund-copy>This reverses the posted amount and restores the stay balance. The refund is recorded in the system audit log.</p>
            <label class="admin-payment-refund-reason">
                <span>Reason notes</span>
                <textarea data-payment-refund-reason maxlength="500" rows="4" required minlength="8" placeholder="Why this payment is being refunded"></textarea>
                <small>Required · at least 8 characters. Staff will see this in the audit log.</small>
            </label>
            <p class="admin-payment-refund-error" data-payment-refund-error role="alert" hidden></p>
        </div>
        <footer class="admin-payment-refund-actions">
            <button type="button" class="admin-payment-refund-cancel" data-payment-refund-cancel>Cancel</button>
            <button type="button" class="admin-payment-refund-submit" data-payment-refund-confirm>Refund payment</button>
        </footer>
    </section>
</div>

@section Scripts {
    <script src="~/js/admin-payments.js" asp-append-version="true"></script>
}
