@{
    ViewData["Title"] = "Payments";
}

<section class="hotel-page-hero">
    <div>
        <p class="hero-eyebrow">Company records</p>
        <h1>Payments</h1>
        <p>Review posted payments for bookings and walk-ins. Record new payments from a booking’s details.</p>
    </div>
</section>

<section class="hotel-panel admin-bookings-panel admin-payments-page" data-admin-payments>
    @Html.AntiForgeryToken()

    <div class="admin-payments-panel">
        <div class="admin-payments-toolbar">
            <div class="admin-payments-summary" data-payments-summary>
                <span>Collected: ₱0.00</span>
                <span>Refunded: ₱0.00</span>
            </div>
            <label class="admin-booking-search">
                <span class="visually-hidden">Search payments</span>
                <input type="search" placeholder="Search receipt, booking, guest…" data-payments-search />
            </label>
            <label class="admin-payments-method-filter">
                <span class="visually-hidden">Payment method</span>
                <select data-payments-method>
                    <option value="">All methods</option>
                    <option value="Cash">Cash</option>
                    <option value="EWallet">E-wallet</option>
                    <option value="BankTransfer">Bank transfer (InstaPay)</option>
                    <option value="Card">Card (legacy)</option>
                    <option value="Maya">Maya (legacy)</option>
                    <option value="Other">Other (legacy)</option>
                </select>
            </label>
            <button type="button" class="admin-booking-refresh admin-payment-flush-btn" data-payments-flush>
                Export payments to PDF
            </button>
            <button type="button" class="admin-booking-refresh" data-payments-refresh>Refresh</button>
        </div>
        <div class="admin-payment-flush-log" data-payments-flush-log>
            <button
                type="button"
                class="admin-payment-flush-toggle"
                data-payments-flush-toggle
                aria-expanded="false"
                aria-controls="paymentFlushLogPanel">
                <span class="admin-payment-flush-toggle-label">
                    <strong>Payment export log</strong>
                    <span data-payments-flush-count>Closed · audit of PDF exports &amp; deletes</span>
                </span>
                <span class="admin-payment-flush-chevron" aria-hidden="true"></span>
            </button>
            <div id="paymentFlushLogPanel" class="admin-payment-flush-log-body" data-payments-flush-body hidden>
                <p class="admin-payment-flush-log-hint">
                    Completed-stay payments are hard-deleted after data export. Export logs auto-clear after 7 days.
                </p>
                <div class="admin-payment-flush-table-wrap">
                    <table class="admin-bookings-table admin-payment-flush-table">
                        <thead>
                            <tr>
                                <th>When (PH)</th>
                                <th>Staff</th>
                                <th>Records</th>
                                <th>PDF file</th>
                                <th>Expires</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody data-payments-flush-log-list>
                            <tr><td colspan="6" class="admin-bookings-loading">No export actions yet.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <p class="admin-bookings-message" data-payments-message role="status" hidden></p>
        <div class="admin-bookings-table-wrap admin-payments-table-wrap">
            <table class="admin-bookings-table admin-payments-table">
                <thead>
                    <tr>
                        <th>When (PH)</th>
                        <th>Receipt</th>
                        <th>Booking</th>
                        <th>Guest</th>
                        <th>Event</th>
                        <th>Method</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Staff</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody data-payments-list>
                    <tr><td colspan="10" class="admin-bookings-loading">Loading payments…</td></tr>
                </tbody>
            </table>
        </div>
        <nav class="admin-bookings-pagination" aria-label="Payment pages">
            <button type="button" data-payments-prev disabled>Previous</button>
            <span data-payments-page>Page 1</span>
            <button type="button" data-payments-next disabled>Next</button>
        </nav>
        <p class="admin-payments-future-note">
            Digital payments with a scanned or uploaded receipt open in a compare view (photo + references).
            New payments are still recorded from a booking’s details.
        </p>
    </div>
</section>

<div class="admin-booking-modal" data-payment-detail-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payment-detail-close aria-label="Close payment details"></button>
    <section class="admin-booking-modal-dialog admin-payment-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentDetailTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-payment-detail-receipt></span>
                <h2 id="paymentDetailTitle">Payment details</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payment-detail-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body" data-payment-detail-body>
            <p>Loading…</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payment-detail-close>Close</button>
            <button type="button" class="admin-payment-save-receipt" data-payment-save-receipt hidden>Save receipt details</button>
            <button type="button" class="admin-booking-delete" data-payment-void hidden>Void payment</button>
        </footer>
    </section>
</div>

<div class="admin-booking-modal" data-payments-flush-detail-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payments-flush-detail-close aria-label="Close export details"></button>
    <section class="admin-booking-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentFlushDetailTitle">
        <header>
            <div>
                <span class="admin-booking-reference" data-payments-flush-detail-file></span>
                <h2 id="paymentFlushDetailTitle">Payment export details</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payments-flush-detail-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body" data-payments-flush-detail-body>
            <p>Loading…</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payments-flush-detail-close>Close</button>
        </footer>
    </section>
</div>

<div class="admin-booking-modal" data-payments-flush-modal hidden>
    <button type="button" class="admin-booking-modal-backdrop" data-payments-flush-close aria-label="Close export dialog"></button>
    <section class="admin-booking-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentFlushTitle">
        <header>
            <div>
                <span class="admin-booking-reference">Company records</span>
                <h2 id="paymentFlushTitle">Export payments to PDF</h2>
            </div>
            <button type="button" class="admin-booking-modal-close" data-payments-flush-close aria-label="Close">&times;</button>
        </header>
        <div class="admin-booking-detail-body">
            <p>
                Export payments for checked-out, cancelled, and archived stays into a branded Mori PDF,
                save it on this device, then permanently delete those payment rows.
                Active stays keep their payment history.
            </p>
            <label class="admin-payment-flush-name">
                Staff name performing this data export
                <input type="text" maxlength="120" autocomplete="name" data-payments-flush-by placeholder="e.g. Ana Reyes" />
            </label>
            <p class="admin-payment-flush-warn" role="status">This cannot be undone. Export log entries clear after 7 days.</p>
        </div>
        <footer class="admin-booking-detail-actions">
            <button type="button" data-payments-flush-close>Cancel</button>
            <button type="button" class="admin-booking-confirm admin-payment-flush-confirm" data-payments-flush-confirm>Export PDF &amp; delete payments</button>
        </footer>
    </section>
</div>

@section Scripts {
    <script src="~/js/admin-payments.js" asp-append-version="true"></script>
}
