@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "404 - Nothing's Here";
    ViewData["GuestDarkPage"] = true;
}

<div class="error-404-wrapper">
    <div class="error-404-bg-glow glow-1"></div>
    <div class="error-404-bg-glow glow-2"></div>
    
    <div class="error-404-content">
        <div class="error-404-badge">
            <span class="badge-dot"></span>
            <span>HTTP Status 404</span>
        </div>

        <div class="error-404-code-wrapper">
            <h1 class="error-404-code">404</h1>
            <div class="error-404-icon-overlay">
                <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="floating-key-icon">
                    <path d="M21 2l-2 2m-2 2l-2 2m2-2l2 2m-4-4l2-2" />
                    <circle cx="7.5" cy="16.5" r="4.5" />
                    <path d="M10.7 13.3L19 5l2 2-1.5 1.5L18 7l-1.5 1.5L18 10l-2.5 2.5" />
                </svg>
            </div>
        </div>

        <h2 class="error-404-headline">Nothing's here</h2>

        <p class="error-404-description">
            The page or room you are searching for doesn't exist, has been relocated, or is temporarily unavailable.
        </p>

        <div class="error-404-actions">
            <a asp-controller="Booking" asp-action="Index" class="error-btn error-btn-primary">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Return to Home
            </a>

            <a asp-controller="Booking" asp-action="Accommodations" class="error-btn error-btn-secondary">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"/>
                    <path d="M12 7v.01"/>
                    <path d="M12 11v.01"/>
                    <path d="M12 15v.01"/>
                </svg>
                Explore Rooms
            </a>
        </div>

        <div class="error-404-quick-links">
            <span class="quick-links-title">Quick Navigation:</span>
            <div class="quick-links-grid">
                <a asp-controller="Booking" asp-action="Index" asp-fragment="about">About Hotel</a>
                <a asp-controller="Booking" asp-action="Accommodations">Book a Stay</a>
                <a asp-controller="Booking" asp-action="Index" asp-fragment="contact">Contact & Location</a>
                <a asp-controller="Staff" asp-action="Index">Staff Portal</a>
            </div>
        </div>
    </div>
</div>
