@model TestingDemo.ViewModels.AdminFlushLogsViewModel
@using TestingDemo.Models
@using TestingDemo.Services
@{
    ViewData["Title"] = "Data and trails";
    var historyReady = Model.HistoryPending > 0;
    var paymentsReady = Model.PaymentsPending > 0;
    var staffReady = Model.StaffAuditPending > 0;
    var pendingTotal = Model.HistoryPending + Model.PaymentsPending + Model.StaffAuditPending;
    var todayPh = PhilippinesTime.ToManila(DateTime.UtcNow).Date;
}

<div class="admin-flush-page admin-audit-page">
    <section class="admin-flush-hero" aria-labelledby="auditPageTitle">
        <div class="admin-flush-hero-copy">
            <p class="admin-flush-eyebrow">Integrity</p>
            <h1 id="auditPageTitle">Data and trails</h1>
            <p class="admin-flush-lede">
                Every administrative action, configuration change, and file export is recorded here.
                Open a section below to review the audit log or export records to PDF.
            </p>
        </div>
        <ul class="admin-flush-kpis" aria-label="Audit coverage">
            <li>
                <span>Events</span>
                <strong data-audit-total>@Model.AuditTotal</strong>
                <em>@(Model.AuditTotal == 1 ? "recorded change" : "recorded changes")</em>
            </li>
            <li>
                <span>This page</span>
                <strong data-audit-page-count>@Model.AuditRows.Count</strong>
                <em>newest first</em>
            </li>
            <li>
                <span>Exportable</span>
                <strong>@pendingTotal</strong>
                <em>@(pendingTotal == 1 ? "record waiting" : "records waiting")</em>
            </li>
        </ul>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <p class="admin-flush-banner is-ok" role="status">@Model.Message</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <p class="admin-flush-banner is-error" role="alert">@Model.Error</p>
    }

    <details class="admin-audit-section" open>
        <summary>
            <span class="admin-audit-section-icon is-teal" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 3h9l5 5v13H6V3zm8 1.5V9h4.5L14 4.5zM8 12h8v2H8v-2zm0 4h8v2H8v-2z"/></svg>
            </span>
            <span class="admin-audit-section-title">
                <strong>Audit log</strong>
                <small>Who changed what, and why — newest first</small>
            </span>
            <span class="admin-audit-section-meta" data-audit-total-badge>@Model.AuditTotal @(Model.AuditTotal == 1 ? "event" : "events")</span>
        </summary>

    <section class="admin-flush-card admin-audit-panel" aria-labelledby="auditFilterTitle" data-audit-live data-audit-api="@Url.Content("~/api/admin/audit/recent")">
        <header class="admin-flush-card-head">
            <h2 id="auditFilterTitle">Find what changed</h2>
            <p>Filter by hotel area. Search receipt numbers, booking references, staff names, or reasons.</p>
        </header>

        <form method="get" asp-action="Index" class="admin-audit-filters">
            @if (Model.Domain.HasValue)
            {
                <input type="hidden" name="domain" value="@Model.Domain" />
            }
            <div
                class="admin-audit-search"
                data-audit-search
                data-suggest-url="@Url.Action("Suggestions", "AdminFlushLogs")">
                <label for="auditSearch">Search</label>
                <div class="admin-audit-search-field">
                    <svg class="admin-audit-search-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                        <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                    </svg>
                    <input
                        id="auditSearch"
                        type="search"
                        name="q"
                        value="@Model.Search"
                        placeholder="Search receipt, booking, staff, reason…"
                        autocomplete="off"
                        spellcheck="false"
                        role="combobox"
                        aria-autocomplete="list"
                        aria-expanded="false"
                        aria-controls="auditSearchList"
                        aria-haspopup="listbox"
                        data-audit-search-input />
                    <button
                        type="button"
                        class="admin-audit-search-clear"
                        data-audit-search-clear
                        hidden
                        aria-label="Clear search">
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                            <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </svg>
                    </button>
                </div>
                <ul
                    id="auditSearchList"
                    class="admin-audit-suggestions"
                    role="listbox"
                    data-audit-search-list
                    hidden></ul>
            </div>
            <fieldset class="admin-audit-chips">
                <legend title="Which part of the system was touched: Booking, Payment, Account, Review, etc.">Area</legend>
                <a class="admin-audit-chip @(Model.Domain is null ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search })">All areas</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.Payment ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.Payment })">Payments</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.Account ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.Account })">Accounts</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.Booking ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.Booking })">Bookings</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.SpecialOffer ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.SpecialOffer })">Special offers</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.Shift ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.Shift })">Shifts</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.Review ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.Review })">Reviews</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.Configuration ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.Configuration })">Vault / config</a>
                <a class="admin-audit-chip @(Model.Domain == SystemAuditDomain.File ? "is-active" : null)" href="@Url.Action("Index", new { q = Model.Search, domain = SystemAuditDomain.File })">Files</a>
            </fieldset>
            <noscript>
                <button type="submit" class="admin-flush-submit">Apply filters</button>
            </noscript>
        </form>

        @if (Model.AuditRows.Count == 0)
        {
            <div class="admin-flush-empty">
                <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M6 3h9l5 5v13H6V3z" />
                    <path d="M14 3v6h6" />
                    <path d="M8 13h8M8 17h5" />
                </svg>
                <strong>No matching events</strong>
                <span>Refunds, account edits, bookings, offers, vault saves, and file exports appear here as they happen.</span>
            </div>
        }
        else
        {
            <div class="admin-flush-table-wrap admin-audit-table-wrap">
                <table class="admin-flush-table admin-audit-table">
                    <colgroup>
                        <col class="admin-audit-col-when" />
                        <col class="admin-audit-col-area" />
                        <col class="admin-audit-col-action" />
                        <col class="admin-audit-col-actor" />
                        <col class="admin-audit-col-target" />
                        <col class="admin-audit-col-reason" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>When (PH)</th>
                            <th>Area</th>
                            <th>Action</th>
                            <th>Actor</th>
                            <th>Target</th>
                            <th>Reason / summary</th>
                        </tr>
                    </thead>
                    <tbody data-audit-tbody>
                    @foreach (var row in Model.AuditRows)
                    {
                        var reasonText = string.IsNullOrWhiteSpace(row.Reason) ? row.Summary : row.Reason;
                        <tr data-audit-id="@row.Id">
                            <td data-label="When (PH)">
                                <time datetime="@DateTime.SpecifyKind(row.AtUtc, DateTimeKind.Utc).ToString("o")">@PhilippinesTime.FormatStamp(row.AtUtc)</time>
                            </td>
                            <td data-label="Area" title="@row.DomainLabel">@row.DomainLabel</td>
                            <td data-label="Action" title="@row.Action">@row.Action</td>
                            <td data-label="Actor" title="@row.ActorDisplayName">@row.ActorDisplayName</td>
                            <td data-label="Target" title="@row.TargetLabel">
                                <strong>@row.TargetLabel</strong>
                                <small>@row.TargetType</small>
                            </td>
                            <td data-label="Reason / summary" title="@reasonText">@reasonText</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <nav class="admin-bookings-pagination admin-audit-pager" aria-label="Audit pages">
                @if (Model.Page > 1)
                {
                    <a href="@Url.Action("Index", new { q = Model.Search, domain = Model.Domain, page = Model.Page - 1 })">Previous</a>
                }
                else
                {
                    <span aria-disabled="true">Previous</span>
                }
                <em>Page @Model.Page of @Model.AuditTotalPages</em>
                @if (Model.Page < Model.AuditTotalPages)
                {
                    <a href="@Url.Action("Index", new { q = Model.Search, domain = Model.Domain, page = Model.Page + 1 })">Next</a>
                }
                else
                {
                    <span aria-disabled="true">Next</span>
                }
            </nav>
        }
    </section>
    </details>

    <details class="admin-audit-section" id="retentionSection" open="@(!string.IsNullOrWhiteSpace(Model.Error) || Model.Kinds.Count > 0)">
        <summary>
            <span class="admin-audit-section-icon is-navy" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
            </span>
            <span class="admin-audit-section-title">
                <strong>Data retention export</strong>
                <small>Save records to PDF, then optionally clear them</small>
            </span>
            <span class="admin-audit-section-meta @(pendingTotal > 0 ? "is-on" : null)">@pendingTotal exportable</span>
        </summary>

        <form asp-action="Flush" method="post" class="admin-flush-card admin-flush-form admin-retention-form" id="adminFlushForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="clearAfterExport" name="clearAfterExport" value="false" />

            <ol class="admin-retention-steps">
                <li class="admin-retention-step">
                    <div class="admin-retention-step-head">
                        <span class="admin-retention-step-num" aria-hidden="true">1</span>
                        <div>
                            <h2 id="retentionStep1">Choose what to export</h2>
                            <p>Pick one or more record types. Counts show how many records are waiting.</p>
                        </div>
                    </div>
                    <fieldset class="admin-flush-kinds admin-retention-kinds" aria-labelledby="retentionStep1">
                        <legend class="visually-hidden">Record types</legend>
                        <label class="admin-flush-kind @(historyReady ? null : "is-empty")">
                            <input type="checkbox" name="kinds" value="@SystemFlushKind.BookingHistory" @(Model.Kinds.Contains(SystemFlushKind.BookingHistory) ? "checked" : null) />
                            <span class="admin-flush-kind-box" aria-hidden="true"></span>
                            <span class="admin-flush-kind-copy">
                                <strong>Booking history</strong>
                                <small>Archived bookings · filtered by archive date · stays with guest reviews are kept</small>
                            </span>
                            <span class="admin-retention-count">@Model.HistoryPending</span>
                        </label>
                        <label class="admin-flush-kind @(paymentsReady ? null : "is-empty")">
                            <input type="checkbox" name="kinds" value="@SystemFlushKind.Payments" @(Model.Kinds.Contains(SystemFlushKind.Payments) ? "checked" : null) />
                            <span class="admin-flush-kind-box" aria-hidden="true"></span>
                            <span class="admin-flush-kind-copy">
                                <strong>Payments</strong>
                                <small>Payment records · filtered by paid date</small>
                            </span>
                            <span class="admin-retention-count">@Model.PaymentsPending</span>
                        </label>
                        <label class="admin-flush-kind @(staffReady ? null : "is-empty")">
                            <input type="checkbox" name="kinds" value="@SystemFlushKind.StaffAudit" @(Model.Kinds.Contains(SystemFlushKind.StaffAudit) ? "checked" : null) />
                            <span class="admin-flush-kind-box" aria-hidden="true"></span>
                            <span class="admin-flush-kind-copy">
                                <strong>Audit log</strong>
                                <small>Staff and system events · filtered by event date</small>
                            </span>
                            <span class="admin-retention-count">@Model.StaffAuditPending</span>
                        </label>
                    </fieldset>
                </li>

                <li class="admin-retention-step">
                    <div class="admin-retention-step-head">
                        <span class="admin-retention-step-num" aria-hidden="true">2</span>
                        <div>
                            <h2 id="retentionStep2">Set the date range</h2>
                            <p>Philippine time. Both dates are required — use a preset or pick your own.</p>
                        </div>
                    </div>
                    <div class="admin-retention-presets" role="group" aria-label="Quick date ranges">
                        <button type="button" class="admin-retention-preset" data-range-days="7">Last 7 days</button>
                        <button type="button" class="admin-retention-preset" data-range-days="30">Last 30 days</button>
                        <button type="button" class="admin-retention-preset" data-range-month="current">This month</button>
                        <button type="button" class="admin-retention-preset" data-range-month="previous">Last month</button>
                    </div>
                    <div class="admin-flush-dates-grid admin-retention-dates" role="group" aria-labelledby="retentionStep2">
                        <div class="admin-flush-name">
                            <label for="fromDate">From</label>
                            <input id="fromDate"
                                   name="fromDate"
                                   type="date"
                                   required
                                   max="@todayPh.ToString("yyyy-MM-dd")"
                                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                   autocomplete="off" />
                        </div>
                        <div class="admin-flush-name">
                            <label for="toDate">To</label>
                            <input id="toDate"
                                   name="toDate"
                                   type="date"
                                   required
                                   max="@todayPh.ToString("yyyy-MM-dd")"
                                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                   autocomplete="off" />
                        </div>
                    </div>
                </li>

                <li class="admin-retention-step">
                    <div class="admin-retention-step-head">
                        <span class="admin-retention-step-num" aria-hidden="true">3</span>
                        <div>
                            <h2>Export</h2>
                            <p>You'll be asked to <strong>Just export</strong> (keep records) or <strong>Export and clear</strong> (delete the exported rows). Download and check the PDF before clearing. "Flush" means export and clear.</p>
                        </div>
                    </div>
                    <div class="admin-retention-actions">
                        <button type="submit" class="admin-flush-submit">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
                            Export selected
                        </button>
                        <p class="admin-retention-note">An export marker is always kept in the <em>Files</em> audit area for integrity.</p>
                    </div>
                </li>
            </ol>
        </form>
    </details>
</div>

<div class="admin-flush-confirm" id="adminFlushConfirm" hidden>
    <button type="button" class="admin-flush-confirm-backdrop" data-flush-confirm-cancel aria-label="Cancel export"></button>
    <section class="admin-flush-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="flushConfirmTitle">
        <h2 id="flushConfirmTitle">How do you want to export?</h2>
        <p id="flushConfirmBody">Choose carefully. Clearing cannot be undone for the selected export types in that date range.</p>
        <div class="admin-flush-preview" data-flush-preview aria-live="polite"></div>
        <div class="admin-flush-confirm-actions admin-flush-confirm-actions--choice">
            <button type="button" class="admin-flush-ghost" data-flush-confirm-cancel>Cancel</button>
            <button type="button" class="admin-flush-btn-safe" id="adminFlushExportOnly" data-flush-mode="export">
                Just export
            </button>
            <button type="button" class="admin-flush-btn-danger" id="adminFlushExportClear" data-flush-mode="clear" title="Flush = export the rows to a PDF, then delete them from the system.">
                Export and clear
            </button>
        </div>
    </section>
</div>


@section Scripts {
    <script src="~/js/admin-audit-search.js" asp-append-version="true"></script>
    <script src="~/js/admin-audit-live.js" asp-append-version="true"></script>
    <script>
        (() => {
            const form = document.getElementById('adminFlushForm');
            const overlay = document.getElementById('adminFlushConfirm');
            const confirmBody = document.getElementById('flushConfirmBody');
            const clearInput = document.getElementById('clearAfterExport');
            const submitBtn = form?.querySelector('.admin-flush-submit');
            let confirmed = false;

            // Quick date presets (Philippine calendar dates)
            const fromInput = document.getElementById('fromDate');
            const toInput = document.getElementById('toDate');
            const phToday = () => {
                const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' })
                    .formatToParts(new Date());
                const get = (t) => Number(parts.find((p) => p.type === t)?.value);
                return new Date(Date.UTC(get('year'), get('month') - 1, get('day')));
            };
            const iso = (d) => d.toISOString().slice(0, 10);
            const setRange = (from, to) => {
                if (fromInput) fromInput.value = iso(from);
                if (toInput) toInput.value = iso(to);
                document.querySelector('.admin-flush-banner.is-error')?.setAttribute('hidden', '');
            };
            document.querySelectorAll('.admin-retention-preset').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const today = phToday();
                    const days = Number(btn.dataset.rangeDays);
                    if (days) {
                        const from = new Date(today);
                        from.setUTCDate(from.getUTCDate() - (days - 1));
                        setRange(from, today);
                    } else if (btn.dataset.rangeMonth === 'current') {
                        setRange(new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1)), today);
                    } else if (btn.dataset.rangeMonth === 'previous') {
                        const first = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() - 1, 1));
                        const last = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 0));
                        setRange(first, last);
                    }
                    document.querySelectorAll('.admin-retention-preset').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
                });
            });
            [fromInput, toInput].forEach((input) => input?.addEventListener('input', () => {
                document.querySelectorAll('.admin-retention-preset').forEach((b) => b.setAttribute('aria-pressed', 'false'));
            }));

            // Open the export section when the form is invalid so the message is visible.
            const openRetention = () => {
                const section = document.getElementById('retentionSection');
                if (section && !section.open) section.open = true;
            };

            // Restore success banner after redirect (set in sessionStorage before page reload)
            const pendingMessage = sessionStorage.getItem('moriFlushExportMessage');
            if (pendingMessage) {
                sessionStorage.removeItem('moriFlushExportMessage');
                const existing = document.querySelector('.admin-flush-banner.is-ok');
                if (existing) {
                    existing.textContent = pendingMessage;
                } else {
                    const page = document.querySelector('.admin-flush-page');
                    const banner = document.createElement('p');
                    banner.className = 'admin-flush-banner is-ok';
                    banner.setAttribute('role', 'status');
                    banner.textContent = pendingMessage;
                    page?.querySelector('.admin-flush-hero')?.after(banner);
                }
            }

            const resetSubmitButton = () => {
                if (!submitBtn) return;
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.exportLabel || 'Export selected';
                delete submitBtn.dataset.exportLabel;
            };

            const downloadBlob = (blob, fileName) => new Promise((resolve) => {
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = fileName || 'Mori-Flush-Export.pdf';
                link.rel = 'noopener';
                document.body.appendChild(link);
                link.click();
                link.remove();
                window.setTimeout(() => {
                    URL.revokeObjectURL(url);
                    resolve();
                }, 1200);
            });

            const redirectAfterExport = (cleared) => {
                const url = new URL(window.location.href);
                url.searchParams.delete('page');
                if (!cleared) {
                    window.location.assign(url.toString());
                    return;
                }
                const kinds = [...(form?.querySelectorAll('input[name="kinds"]:checked') || [])]
                    .map((input) => input.value);
                if (kinds.includes('Payments')) {
                    url.searchParams.set('domain', 'Payment');
                } else if (kinds.includes('BookingHistory')) {
                    url.searchParams.set('domain', 'Booking');
                } else if (kinds.includes('StaffAudit')) {
                    url.searchParams.set('domain', 'Account');
                }
                window.location.assign(url.toString());
            };

            const showExportError = (message) => {
                openRetention();
                let banner = document.querySelector('.admin-flush-banner.is-error');
                if (!banner) {
                    banner = document.createElement('p');
                    banner.className = 'admin-flush-banner is-error';
                    banner.setAttribute('role', 'alert');
                    document.querySelector('.admin-flush-page')
                        ?.querySelector('.admin-flush-hero')
                        ?.after(banner);
                }
                banner.hidden = false;
                banner.textContent = message;
                banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            };

            // Sends the form via fetch, streams the response as a blob download.
            // Always called with event.preventDefault() already issued.
            const beginExport = async () => {
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.dataset.exportLabel = submitBtn.textContent || '';
                    submitBtn.textContent = 'Exporting\u2026';
                }

                window.setAdminExportLoading?.(true, {
                    title: 'Exporting data\u2026',
                    detail: 'Building PDF softcopy and updating retention records. Please wait.',
                });

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        credentials: 'same-origin',
                        headers: {
                            'X-Flush-Export': '1',
                            Accept: 'application/pdf, application/zip, application/json',
                        },
                    });

                    if (!response.ok) {
                        const payload = await response.json().catch(() => ({}));
                        throw new Error(
                            window.friendlyAdminExportError?.(payload.message, 'Unable to export.')
                            || payload.message
                            || 'Unable to export.'
                        );
                    }

                    const blob = await response.blob();
                    if (!blob || blob.size === 0) {
                        throw new Error('Export returned an empty file. Please try again.');
                    }

                    const disposition = response.headers.get('Content-Disposition') || '';
                    const match = /filename\*?=(?:UTF-8''|")?([^";]+)/i.exec(disposition);
                    const fileName = match
                        ? decodeURIComponent(match[1].replace(/"/g, '').trim())
                        : (blob.type.includes('zip') ? 'Mori-Flush-Export.zip' : 'Mori-Flush-Export.pdf');
                    const message = response.headers.get('X-Flush-Message')
                        || `Export complete. Saved as ${fileName}.`;

                    const cleared = clearInput?.value === 'true';
                    window.setAdminExportLoading?.(false);

                    await downloadBlob(blob, fileName);

                    sessionStorage.setItem(
                        'moriFlushExportMessage',
                        `${message} Downloaded ${fileName}.`
                    );

                    window.setTimeout(() => {
                        redirectAfterExport(cleared);
                    }, 1200);
                } catch (error) {
                    confirmed = false;
                    showExportError(
                        window.friendlyAdminExportError?.(error, 'Unable to export.')
                        || (error instanceof Error ? error.message : 'Unable to export.')
                    );
                    resetSubmitButton();
                } finally {
                    window.setAdminExportLoading?.(false);
                }
            };

            const closeConfirm = () => {
                confirmed = false;
                if (overlay) overlay.hidden = true;
            };

            const previewEl = overlay?.querySelector('[data-flush-preview]');
            const loadFlushPreview = async (checked, fromDate, toDate) => {
                if (!previewEl) return;
                previewEl.textContent = 'Loading preview…';
                try {
                    const params = new URLSearchParams();
                    checked.forEach((input) => params.append('kinds', input.value));
                    params.set('fromDate', fromDate);
                    params.set('toDate', toDate);
                    const response = await fetch(
                        `@Url.Action("Preview", "AdminFlushLogs")?${params.toString()}`,
                        { credentials: 'same-origin' });
                    if (!response.ok) throw new Error('preview failed');
                    const data = await response.json();
                    const parts = [];
                    if (data.history) {
                        const h = data.history;
                        const kept = (h.keptForReviews || 0) + (h.keptForPayments || 0);
                        let text = `Export and clear will delete ${h.willDelete} booking rows`;
                        if (kept > 0) {
                            text += ` (${kept} kept: ${h.keptForReviews} with reviews, ${h.keptForPayments} with payment receipts)`;
                        }
                        text += '.';
                        if (h.sampleReferences?.length) {
                            text += ` e.g. ${h.sampleReferences.join(', ')}`;
                        }
                        parts.push(text);
                    }
                    if (data.payments) {
                        const p = data.payments;
                        let text = `${parts.length ? '…and ' : 'Export and clear will delete '}${p.matched} payment rows.`;
                        if (p.sampleReceipts?.length) {
                            text += ` e.g. ${p.sampleReceipts.join(', ')}`;
                        }
                        parts.push(text);
                    }
                    const coversSelection = checked.some((input) => input.value !== 'StaffAudit');
                    previewEl.textContent = parts.join(' ')
                        || (coversSelection ? 'Nothing matches that selection.' : '');
                } catch {
                    previewEl.textContent = 'Preview unavailable — the export itself is unaffected.';
                }
            };

            form?.addEventListener('submit', (event) => {
                const checked = [...form.querySelectorAll('input[name="kinds"]:checked')];
                if (checked.length === 0) {
                    event.preventDefault();
                    form.querySelector('input[name="kinds"]')?.focus();
                    return;
                }

                const fromDate = form.querySelector('#fromDate')?.value || '';
                const toDate = form.querySelector('#toDate')?.value || '';
                if (!fromDate || !toDate) {
                    event.preventDefault();
                    showExportError('Choose both From and To dates before exporting.');
                    (form.querySelector('#fromDate') || form.querySelector('#toDate'))?.focus();
                    return;
                }
                if (fromDate > toDate) {
                    event.preventDefault();
                    showExportError('From date must be on or before To date.');
                    form.querySelector('#fromDate')?.focus();
                    return;
                }

                if (!confirmed) {
                    // Show the Just export / Export and clear modal
                    event.preventDefault();
                    const labels = checked
                        .map((input) => input.closest('label')?.querySelector('strong')?.textContent?.trim())
                        .filter(Boolean);
                    if (confirmBody) {
                        confirmBody.textContent =
                            `Export ${labels.join(', ')} for ${fromDate} to ${toDate} (PH). ` +
                            `Just export keeps data intact. Export and clear permanently deletes the exported rows for those types ` +
                            `(stays with guest reviews are kept).`;
                    }
                    if (overlay) overlay.hidden = false;
                    document.getElementById('adminFlushExportOnly')?.focus();
                    loadFlushPreview(checked, fromDate, toDate);
                    return;
                }

                // confirmed === true: modal button already set clearInput.value; run the fetch download
                confirmed = false;
                event.preventDefault();
                beginExport();
            });

            // Modal action buttons — set the export mode then re-trigger form submit (with confirmed=true)
            const chooseMode = (clear) => {
                if (clearInput) clearInput.value = clear ? 'true' : 'false';
                confirmed = true;
                if (overlay) overlay.hidden = true;
                form?.requestSubmit();
            };

            document.getElementById('adminFlushExportOnly')?.addEventListener('click', () => chooseMode(false));
            document.getElementById('adminFlushExportClear')?.addEventListener('click', () => chooseMode(true));

            overlay?.querySelectorAll('[data-flush-confirm-cancel]').forEach((btn) => {
                btn.addEventListener('click', closeConfirm);
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && overlay && !overlay.hidden) closeConfirm();
            });
        })();
    </script>
}
